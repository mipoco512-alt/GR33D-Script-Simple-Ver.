function FlingFunctions.getHitLockPosition(aimPart)
    if not aimPart or not aimPart.Parent then return nil end
    local isHRP = (aimPart.Name == "HumanoidRootPart")
    local frac  = isHRP and CONFIG.AimUpFractionHRP or CONFIG.AimUpFraction
    local localOffset = CFrame.new(0, aimPart.Size.Y * frac, 0)
    local baseWorld = (aimPart.CFrame * localOffset).Position

    if PREDICTION_TIME > 0 then
        local data = PartTracker[aimPart]
        if data then
            local dt = math.clamp(
                (os.clock() - (data.time or os.clock())) + PREDICTION_TIME,
                0, CONFIG.PredictionMaxSeconds)
            local v = data.vel or Vector3.zero
            if v.Magnitude > CONFIG.PredictionMaxSpeed then
                v = v.Unit * CONFIG.PredictionMaxSpeed
            end
            local displacement = v * dt
            if displacement.Magnitude > CONFIG.PredictionMaxStuds then
                displacement = displacement.Unit * CONFIG.PredictionMaxStuds
            end
            baseWorld = baseWorld + displacement
        end
    end
    return baseWorld
end

function FlingFunctions.getAimWorldPosition(tCharacter, aimPart)
    if not aimPart or not aimPart.Parent then return nil end
    if PREDICTION_TIME <= 0 then
        return aimPart.Position
    end
    return FlingFunctions.predictPart(aimPart, PREDICTION_TIME) or aimPart.Position
end
function FlingFunctions.findPlayerByName(name)
