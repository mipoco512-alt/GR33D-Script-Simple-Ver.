local function getTargetHRP(player)
    local tc = player and player.Character
    if not tc then return nil, nil, nil end
    local tHum = tc:FindFirstChildOfClass("Humanoid")
    local tRoot = tHum and tHum.RootPart
    return tc, tHum, tRoot
end

local function findPlayerByName(name)
    if not name or name == "" then return nil end
    local ln = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Me and (p.Name:lower() == ln
            or p.Name:lower():sub(1, #ln) == ln
            or p.DisplayName:lower():sub(1, #ln) == ln) then
            return p
        end
    end
    return nil
end

local function getActiveTarget()
    if currentTarget and currentTarget.Parent == Players
        and currentTarget.Character then
        return currentTarget
    end
    for _, p in pairs(SelectedTargets) do
        if p and p.Parent == Players then return p end
    end
    return nil
end

--====================================
-- SCANNER — FULL RIG
--====================================
local function getOwnerString(inst)
    if not inst or not inst.Parent then return "?" end
    local s = "?"
    pcall(function()
        local o = inst:GetNetworkOwner()
        s = o and o.Name or "Server"
    end)
    return s
end

local function scanTargetRig(player)
    local tc, tHum, tRoot = getTargetHRP(player)
    if not tc then return "No character for " .. player.Name end

    local lines = {}
    lines[#lines + 1] = "═══════════════════════════════════"
    lines[#lines + 1] = "RIG SCAN · @" .. player.Name
    lines[#lines + 1] = "═══════════════════════════════════"

    lines[#lines + 1] = "Character:     " .. tc.Name
    lines[#lines + 1] = "ClassName:     " .. tc.ClassName

    if tHum then
        local rt = "?"
        pcall(function() rt = tHum.RigType.Name end)
        lines[#lines + 1] = "RigType:       " .. rt
        lines[#lines + 1] = "Health:        " .. tostring(tHum.Health) .. " / " .. tostring(tHum.MaxHealth)
        lines[#lines + 1] = "WalkSpeed:     " .. tostring(tHum.WalkSpeed)
        lines[#lines + 1] = "JumpPower:     " .. tostring(tHum.JumpPower)
        lines[#lines + 1] = "JumpHeight:    " .. tostring(tHum.JumpHeight)
        lines[#lines + 1] = "UseJumpPower:  " .. tostring(tHum.UseJumpPower)
        lines[#lines + 1] = "Sit:           " .. tostring(tHum.Sit)
        lines[#lines + 1] = "PlatformStand: " .. tostring(tHum.PlatformStand)
        lines[#lines + 1] = "State:         " .. tostring(tHum:GetState())
        lines[#lines + 1] = "FloorMaterial: " .. tostring(tHum.FloorMaterial)
        lines[#lines + 1] = "MoveDirection: " .. tostring(tHum.MoveDirection)
    end

    if tRoot then
        lines[#lines + 1] = ""
        lines[#lines + 1] = "───── HumanoidRootPart ─────"
        lines[#lines + 1] = "Position:      " .. string.format("(%.1f, %.1f, %.1f)", tRoot.Position.X, tRoot.Position.Y, tRoot.Position.Z)
        lines[#lines + 1] = "Velocity:      " .. string.format("%.1f studs/s", tRoot.AssemblyLinearVelocity.Magnitude)
        lines[#lines + 1] = "AngularVel:    " .. string.format("%.1f", tRoot.AssemblyAngularVelocity.Magnitude)
        lines[#lines + 1] = "AssemblyMass:  " .. string.format("%.2f", tRoot.AssemblyMass)
        lines[#lines + 1] = "Size:          " .. tostring(tRoot.Size)
        lines[#lines + 1] = "Anchored:      " .. tostring(tRoot.Anchored)
        lines[#lines + 1] = "CanCollide:    " .. tostring(tRoot.CanCollide)
        lines[#lines + 1] = "CanQuery:      " .. tostring(tRoot.CanQuery)
        lines[#lines + 1] = "CanTouch:      " .. tostring(tRoot.CanTouch)
        lines[#lines + 1] = "Massless:      " .. tostring(tRoot.Massless)
        lines[#lines + 1] = "Transparency:  " .. tostring(tRoot.Transparency)
        lines[#lines + 1] = "Owner:         " .. getOwnerString(tRoot)
    end

    lines[#lines + 1] = ""
    lines[#lines + 1] = "───── BaseParts ─────"
    local parts = {}
    for _, d in ipairs(tc:GetDescendants()) do
        if d:IsA("BasePart") then table.insert(parts, d) end
    end
    table.sort(parts, function(a, b)
        return (a.AssemblyMass or 0) > (b.AssemblyMass or 0)
    end)
    for _, p in ipairs(parts) do
        local rootDist = tRoot and (p.Position - tRoot.Position).Magnitude or 0
        lines[#lines + 1] = string.format(
            "  %-18s  cls=%-8s  A=%-5s  M=%-5s  CC=%-5s  mass=%5.2f  dHRP=%4.1f  own=%s",
            p.Name:sub(1, 18),
            p.ClassName:sub(1, 8),
            tostring(p.Anchored),
            tostring(p.Massless),
            tostring(p.CanCollide),
            p.AssemblyMass or 0,
            rootDist,
            getOwnerString(p))
    end
    lines[#lines + 1] = "  Total BaseParts: " .. #parts

    lines[#lines + 1] = ""
    lines[#lines + 1] = "───── Joints (weld chain) ─────"
    local joints = {}
    for _, d in ipairs(tc:GetDescendants()) do
        if d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Snap") then
            table.insert(joints, d)
        end
    end
    for _, j in ipairs(joints) do
        lines[#lines + 1] = string.format(
            "  %-24s  %s → %s  active=%s",
            j.Name:sub(1, 24),
            j.Part0 and j.Part0.Name or "?",
            j.Part1 and j.Part1.Name or "?",
            tostring(j.Enabled ~= false))
    end
    lines[#lines + 1] = "  Total joints: " .. #joints

    lines[#lines + 1] = ""
    lines[#lines + 1] = "───── Accessories ─────"
    local accs = {}
    for _, d in ipairs(tc:GetChildren()) do
        if d:IsA("Accessory") then table.insert(accs, d) end
    end
    if #accs == 0 then
        lines[#lines + 1] = "  (none)"
    else
        for _, a in ipairs(accs) do
            lines[#lines + 1] = "  " .. a.Name .. "  handle=" .. tostring(a:FindFirstChild("Handle") ~= nil)
        end
    end

    lines[#lines + 1] = ""
    lines[#lines + 1] = "───── Attributes ─────"
    local anyAttr = false
    for _, d in ipairs(tc:GetDescendants()) do
        local attrs = d:GetAttributes()
        for k, v in pairs(attrs) do
            anyAttr = true
            lines[#lines + 1] = "  " .. d.Name .. "." .. k .. " = " .. tostring(v)
        end
    end
    if not anyAttr then lines[#lines + 1] = "  (none)" end

    return table.concat(lines, "\n")
end

--====================================
-- SCANNER — ENVIRONMENT
--====================================
local function scanEnvironment(radius)
    radius = radius or 30
    local ch = Me.Character
    local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
    if not myRoot then return "No local character" end

    local lines = {}
    lines[#lines + 1] = "═══════════════════════════════════"
    lines[#lines + 1] = "ENV SCAN · radius " .. radius .. " studs"
    lines[#lines + 1] = "═══════════════════════════════════"

    local parts = workspace:GetPartBoundsInRadius(myRoot.Position, radius)
    lines[#lines + 1] = "Parts in radius: " .. #parts

    local byOwner = {}
    local anchoredCount = 0
    local unanchoredCount = 0

    for _, p in ipairs(parts) do
        if p:IsA("BasePart") then
            local owner = getOwnerString(p)
            byOwner[owner] = (byOwner[owner] or 0) + 1
            if p.Anchored then anchoredCount = anchoredCount + 1
            else unanchoredCount = unanchoredCount + 1 end
        end
    end

    lines[#lines + 1] = "Anchored:    " .. anchoredCount
    lines[#lines + 1] = "Unanchored:  " .. unanchoredCount
    lines[#lines + 1] = ""

    lines[#lines + 1] = "───── By owner ─────"
    for owner, count in pairs(byOwner) do
        lines[#lines + 1] = "  " .. owner .. ": " .. count
    end

    lines[#lines + 1] = ""
    lines[#lines + 1] = "───── Nearest movable parts ─────"
    local movable = {}
    for _, p in ipairs(parts) do
        if p:IsA("BasePart") and not p.Anchored and not p:IsDescendantOf(ch) then
            table.insert(movable, p)
        end
    end
    table.sort(movable, function(a, b)
        return (a.Position - myRoot.Position).Magnitude
             < (b.Position - myRoot.Position).Magnitude
    end)
    for i = 1, math.min(10, #movable) do
        local p = movable[i]
        local d = (p.Position - myRoot.Position).Magnitude
        lines[#lines + 1] = string.format(
            "  %-22s  cls=%-10s  d=%.1f  mass=%.1f  own=%s",
            p.Name:sub(1, 22), p.ClassName:sub(1, 10), d, p.AssemblyMass or 0,
            getOwnerString(p))
    end

    return table.concat(lines, "\n")
end

local function scanAll()
    local target = getActiveTarget()
    local lines = {}
    if target then
        lines[#lines + 1] = scanTargetRig(target)
        lines[#lines + 1] = ""
    else
        lines[#lines + 1] = "No target selected — scanning nearby players instead:"
        lines[#lines + 1] = ""
        local ch = Me.Character
        local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
        if myRoot then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= Me and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and (hrp.Position - myRoot.Position).Magnitude < 100 then
                        lines[#lines + 1] = scanTargetRig(p)
                        lines[#lines + 1] = ""
                    end
                end
            end
        end
    end
    lines[#lines + 1] = scanEnvironment(50)
    return table.concat(lines, "\n")
end

