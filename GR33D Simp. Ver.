end)

local function isMyPart(p)
    local myChar = Me.Character
    return myChar ~= nil and p:IsDescendantOf(myChar)
end

local function ringRetainPart(p)
    if not p:IsA("BasePart") then return false end
    if p.Anchored then return false end
    if not p:IsDescendantOf(workspace) then return false end
    if isMyPart(p) then return false end
    if p.Name == "Handle" then return false end
    if p.Parent and p.Parent:IsA("Accessory") then return false end
    return true
end

local function ringClaimOwner(p)
    if not p or not p.Parent or p.Anchored then return end
    pcall(function()
        if p:GetNetworkOwner() ~= Me then
            p:SetNetworkOwner(Me)
        end
    end)
end

local function ringAddPart(p)
    if ringRetainPart(p) and not table.find(ringParts, p) then
        table.insert(ringParts, p)
        ringClaimOwner(p)
    end
end

local function ringRemovePart(p)
    local i = table.find(ringParts, p)
    if i then table.remove(ringParts, i) end
end

for _, p in pairs(workspace:GetDescendants()) do ringAddPart(p) end
workspace.DescendantAdded:Connect(ringAddPart)
workspace.DescendantRemoving:Connect(ringRemovePart)

local function ringReclaimAll(force)
    local now = os.clock()
    if not force and now - lastRingClaim < RING_CLAIM_INTERVAL then return end
    lastRingClaim = now
    for _, p in pairs(ringParts) do
        if p.Parent and not p.Anchored then
            pcall(function()
                if p:GetNetworkOwner() ~= Me then
                    p:SetNetworkOwner(Me)
                end
            end)
        end
    end
end

local function ringProtectChar(char)
    if not char then return end
    if ringFF and ringFF.Parent then ringFF:Destroy() end
    ringFF = Instance.new("ForceField")
    ringFF.Visible = false
    ringFF.Parent = char
end
if Me.Character then ringProtectChar(Me.Character) end
Me.CharacterAdded:Connect(function(ch)
    task.wait(0.5)
    ringProtectChar(ch)
end)

table.insert(connections, RunService.Heartbeat:Connect(function()
    if not ringPartsEnabled then return end
    local char = Me.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    ringReclaimAll(false)

    local center = hrp.Position
    local strength = RING_CONFIG.attractionStrength
    for _, p in pairs(ringParts) do
        if p.Parent and not p.Anchored and not isMyPart(p) then
            p.Massless = true
            p.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 0, 0, 0)
            p.CanCollide = RING_CONFIG.damageOthers and true or false

            local pos = p.Position
            local flatDelta = Vector3.new(pos.X, center.Y, pos.Z) - center
            local dist = flatDelta.Magnitude
            if dist > RING_CONFIG.keepOut then
                local angle = math.atan2(pos.Z - center.Z, pos.X - center.X)
                local newAngle = angle + math.rad(RING_CONFIG.rotationSpeed)
                local targetPos = Vector3.new(
                    center.X + math.cos(newAngle) * math.min(RING_CONFIG.radius, dist),
                    center.Y + (RING_CONFIG.height * math.abs(math.sin((pos.Y - center.Y) / RING_CONFIG.height))),
                    center.Z + math.sin(newAngle) * math.min(RING_CONFIG.radius, dist)
                )
                local dir = (targetPos - p.Position).Unit
                p.AssemblyLinearVelocity = dir * strength
            else
                p.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end
end))

