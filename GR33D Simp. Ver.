        if input.KeyCode == Enum.KeyCode.D then ctrl.r=0 end
    end)

    local tis
    up.MouseButton1Down:Connect(function()
        tis = up.MouseEnter:Connect(function()
            while tis do
                task.wait()
                local ch = speaker.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
