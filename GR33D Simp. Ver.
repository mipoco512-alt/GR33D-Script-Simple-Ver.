    for _, name in ipairs(KICK_PART_ORDER) do
        local p = tChar:FindFirstChild(name)
        if p and p:IsA("BasePart") and not p.Anchored then
            return p, p.Name
        end
    end
    local tRoot = tHum and tHum.RootPart
    if tRoot then return tRoot, tRoot.Name end
    return nil, nil
end

function FlingFunctions.hardTeleportToTarget(player, requestedLockPart)
    local ch = Me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local myRoot = hum and hum.RootPart
    local tChar, tHum, tRoot = FlingFunctions.getTargetHRP(player)
    if not (ch and myRoot and tRoot) then return false end

    local lockPart = requestedLockPart
    if not (lockPart and lockPart:IsA("BasePart")
        and lockPart.Parent == tChar and not lockPart.Anchored) then
        lockPart = nil
    end
    if not lockPart and currentAimTarget == "hrp" then
        lockPart = tHum and tHum.RootPart
    elseif not lockPart then
        for _, name in ipairs(KICK_PART_ORDER) do
            local p = tChar and tChar:FindFirstChild(name)
            if p and p:IsA("BasePart") and not p.Anchored then
                lockPart = p
                break
            end
        end
    end
    if not lockPart then lockPart = tRoot end

    local aimWorld = FlingFunctions.getHitLockPosition(lockPart) or lockPart.Position
    pcall(function()
        local pivotOffset = myRoot.CFrame:ToObjectSpace(ch:GetPivot())
        ch:PivotTo(CFrame.new(aimWorld) * myRoot.CFrame.Rotation * pivotOffset)
        myRoot.AssemblyLinearVelocity  = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
    end)
    return true
end

function FlingFunctions.preFreezeTarget(player)
    if freezeActive[player.Name] then return end
    freezeActive[player.Name] = true
    freezeThreads[player.Name] = task.spawn(function()
        while freezeActive[player.Name] do
            local _, tHum = FlingFunctions.getTargetHRP(player)
            if not tHum or not tHum.Parent then freezeActive[player.Name] = false; break end
            pcall(function()
                if tHum.WalkSpeed ~= 0 then tHum.WalkSpeed = 0 end
                if tHum.JumpPower ~= 0 then tHum.JumpPower = 0 end
                if tHum.JumpHeight ~= 0 then tHum.JumpHeight = 0 end
            end)
            task.wait()
        end
    end)
end
function FlingFunctions.postUnfreezeTarget(player)
    freezeActive[player.Name] = false
    freezeThreads[player.Name] = nil
    task.wait(0.05)
    local _, tHum = FlingFunctions.getTargetHRP(player)
    if not tHum then return end
    pcall(function()
        tHum.WalkSpeed=16; tHum.JumpPower=50; tHum.JumpHeight=7.2; tHum.UseJumpPower=true
    end)
end
function FlingFunctions.makeTargetOverlapParams(character)
    local p = OverlapParams.new()
    p.FilterType = Enum.RaycastFilterType.Include
    p.FilterDescendantsInstances = {character}
    p.MaxParts = 40
    p.RespectCanCollide = false
    return p
end
function FlingFunctions.boxIntersects(a, b)
    if not (a and b and a.Parent and b.Parent) then return false end
    local av = {a.CFrame.RightVector, a.CFrame.UpVector, a.CFrame.LookVector}
    local bv = {b.CFrame.RightVector, b.CFrame.UpVector, b.CFrame.LookVector}
    local ae = {a.Size.X / 2, a.Size.Y / 2, a.Size.Z / 2}
    local be = {b.Size.X / 2, b.Size.Y / 2, b.Size.Z / 2}
    local r, absR, t = {}, {}, {}
    local difference = b.Position - a.Position
    for i = 1, 3 do
        r[i], absR[i] = {}, {}
        t[i] = difference:Dot(av[i])
        for j = 1, 3 do
            r[i][j] = av[i]:Dot(bv[j])
            absR[i][j] = math.abs(r[i][j]) + 1e-6
        end
    end
    for i = 1, 3 do
        local radius = ae[i]
        for j = 1, 3 do radius = radius + be[j] * absR[i][j] end
        if math.abs(t[i]) > radius then return false end
    end
    for j = 1, 3 do
        local radius = be[j]
        for i = 1, 3 do radius = radius + ae[i] * absR[i][j] end
        local projection = math.abs(t[1] * r[1][j] + t[2] * r[2][j] + t[3] * r[3][j])
        if projection > radius then return false end
    end
    for i = 1, 3 do
        local i2, i3 = (i % 3) + 1, ((i + 1) % 3) + 1
        for j = 1, 3 do
            local j2, j3 = (j % 3) + 1, ((j + 1) % 3) + 1
            local projection = math.abs(t[i3] * r[i2][j] - t[i2] * r[i3][j])
            local radiusA = ae[i2] * absR[i3][j] + ae[i3] * absR[i2][j]
            local radiusB = be[j2] * absR[i][j3] + be[j3] * absR[i][j2]
            if projection > radiusA + radiusB then return false end
        end
    end
    return true
end
function FlingFunctions.sampleContact(myRoot, targetCharacter, targetRoot, params, monitor)
    if not monitor or not myRoot.Parent or not targetRoot.Parent then return end
    local now = os.clock()
    if not monitor.lastOverlapQuery
        or now - monitor.lastOverlapQuery >= CONFIG.OverlapCheckInterval then
        monitor.lastOverlapQuery = now
        local ok, hits = pcall(function() return workspace:GetPartsInPart(myRoot, params) end)
        if ok then
            for _, part in ipairs(hits) do
                if HitDebug.acceptsPart(part, targetCharacter, monitor.aimMode) then
                    monitor.overlap = true
                    monitor.lastOverlapAt = now
                    monitor.overlapSamples = (monitor.overlapSamples or 0) + 1
                    pcall(HitDebug.record, monitor, part, myRoot, "Overlap")
                end
            end
        end
        if monitor.aimMode == "hrp" and targetRoot.Name == "HumanoidRootPart"
            and FlingFunctions.boxIntersects(myRoot, targetRoot) then
            monitor.overlap = true
            monitor.lastOverlapAt = now
            monitor.overlapSamples = (monitor.overlapSamples or 0) + 1
            pcall(HitDebug.record, monitor, targetRoot, myRoot, "Geometry")
        end
    end
    local velocity = targetRoot.AssemblyLinearVelocity
    local magnitude = velocity.Magnitude
    if magnitude > (monitor.peak or 0) then monitor.peak = magnitude end
    local baseline = monitor.startVelocity or Vector3.zero
    local responseDelta = (velocity - baseline).Magnitude
    monitor.responseDelta = math.max(monitor.responseDelta or 0, responseDelta)
    if monitor.lastOverlapAt and now - monitor.lastOverlapAt <= 0.40
        and magnitude >= HRP_BURST.SuccessPeakVel
        and responseDelta >= CONFIG.MinimumResponseDelta then
        if not monitor.hit then
            monitor.hit = true
            pcall(HitDebug.flag, monitor)
        end
    end
end

function FlingFunctions.runV234Slice(duration, Character, Humanoid, RootPart,
                             TCharacter, THumanoid, aimPart,
                             monitor, overlapParams)
    local targetRoot = THumanoid and THumanoid.RootPart
    local angle = 0

    local function FPos(worldAim, localOffset, ang)
        if not RootPart.Parent or not aimPart.Parent then return end
        local kickCF = CFrame.new(worldAim) * CFrame.new(localOffset) * ang
        local pivotOffset = RootPart.CFrame:ToObjectSpace(Character:GetPivot())
        Character:PivotTo(kickCF * pivotOffset)
        RootPart.CanCollide = true
        RootPart.Massless = false
        if RootPart.Anchored then RootPart.Anchored = false end
        RootPart.AssemblyLinearVelocity = Vector3.new(
            CONFIG.KickSpeed, CONFIG.KickYSpeed, CONFIG.KickSpeed)
        RootPart.AssemblyAngularVelocity = Vector3.new(
            CONFIG.KickRot, CONFIG.KickRot, CONFIG.KickRot)
    end

    local offsets = {
        Vector3.new(0,  0.55, 0),
        Vector3.new(0, -0.55, 0),
        Vector3.new(0.55, 0, 0),
        Vector3.new(-0.55, 0, 0),
        Vector3.new(0, 0, 0.55),
        Vector3.new(0, 0, -0.55),
    }

    local started = os.clock()
    repeat
        if not FlingActive or not RootPart.Parent
            or not THumanoid or THumanoid.Health <= 0 then break end
        if not aimPart.Parent then break end
        if targetRoot and not targetRoot.Parent then break end

        for offsetIndex, offset in ipairs(offsets) do
            if not FlingActive or not RootPart.Parent or not aimPart.Parent then break end

            local aim = FlingFunctions.getHitLockPosition(aimPart)
            if not aim then
                local predictionRoot = targetRoot and targetRoot.Parent and targetRoot or aimPart
                aim = FlingFunctions.predictPart(predictionRoot, PREDICTION_TIME)
            end

            angle = (angle + CONFIG.AngleStep) % 360
            FPos(aim, offset, CFrame.Angles(math.rad(angle), 0, 0))

            FlingFunctions.sampleContact(RootPart, TCharacter, targetRoot or aimPart,
                overlapParams, monitor)
            if monitor and monitor.hit then return true end

            if offsetIndex % 2 == 0 then
                task.wait()
                FlingFunctions.sampleContact(RootPart, TCharacter, targetRoot or aimPart,
                    overlapParams, monitor)
                if monitor and monitor.hit then return true end
            end
        end
        task.wait()
    until os.clock() - started >= duration or not FlingActive
    return false
end

function FlingFunctions.SkidFling_KILASIK(TargetPlayer, forcedPart, monitor)
    local Character  = Me.Character
    local Humanoid   = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart   = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer.Character
    if not TCharacter then return false, false end
    local THumanoid  = TCharacter:FindFirstChildOfClass("Humanoid")
    if not (Character and Humanoid and RootPart) then
        FlingFunctions.setStatus("Character not ready", AMBER); return false, false
    end
    FlingFunctions.captureReturn(Character, RootPart, Humanoid)
    if THumanoid and THumanoid.Sit then
        FlingFunctions.setStatus(TargetPlayer.Name .. " is sitting", AMBER)
        returnSnapshot = nil; return false, false
    end
    if not TCharacter:FindFirstChildWhichIsA("BasePart") then
        returnSnapshot = nil; return false, false
    end

    local aimPart = forcedPart
    if not (aimPart and aimPart:IsA("BasePart") and aimPart.Parent and not aimPart.Anchored) then
        aimPart = FlingFunctions.findAnyTargetPart(TCharacter, THumanoid)
    end
    if not aimPart then
        FlingFunctions.setStatus(TargetPlayer.Name .. " no tracking part", AMBER)
        returnSnapshot = nil; return false, false
    end
    if monitor then
        local suffix = (currentAimTarget == "hrp") and "[HRP]" or "[Arm]"
        monitor.aimedPartName = aimPart.Name .. suffix
    end

    local savedFPDH         = workspace.FallenPartsDestroyHeight
    local savedRootCollide  = RootPart.CanCollide
    local savedRootMassless = RootPart.Massless

    local overlapParams = FlingFunctions.makeTargetOverlapParams(TCharacter)
    local touchConnection
    if RootPart.CanTouch then
        pcall(function()
            touchConnection = RootPart.Touched:Connect(function(part)
                if monitor and HitDebug.acceptsPart(part, TCharacter, monitor and monitor.aimMode) then
                    monitor.overlap = true
                    monitor.lastOverlapAt = os.clock()
                    monitor.touchedPartName = FlingFunctions.hitPartLabel(part, TCharacter)
                    pcall(HitDebug.record, monitor, part, RootPart, "Touched")
                end
            end)
        end)
    end

    selfFlinging = true
    local oldSeated = returnSnapshot and returnSnapshot.seatedEnabled
    FlingFunctions.hardTeleportToTarget(TargetPlayer, aimPart)

    local ran, result = xpcall(function()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        return FlingFunctions.runV234Slice(CONFIG.TimeToWait, Character, Humanoid, RootPart,
            TCharacter, THumanoid, aimPart, monitor, overlapParams)
    end, function(err) return tostring(err) end)

    if not ran then
        warn("[Fling Original] Movement failed:", result)
        FlingFunctions.setStatus("Movement error", RED, tostring(result):sub(1, 110))
    end
    if touchConnection then touchConnection:Disconnect() end
    pcall(function()
        RootPart.CanCollide = savedRootCollide
        RootPart.Massless = savedRootMassless
    end)
    FlingFunctions.zeroCharacterMotion(Character)
    pcall(function()
        if Humanoid.Parent then
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated,
                oldSeated ~= nil and oldSeated or true)
        end
    end)
    selfFlinging = false

    do
        local rootNow = Character:FindFirstChild("HumanoidRootPart")
        local saved = returnSnapshot
        if rootNow and saved and saved.pivot then
            local myVel = rootNow.AssemblyLinearVelocity.Magnitude
            if myVel > 200 then
                for _ = 1, 20 do
                    if Me.Character ~= Character or not Character.Parent
                        or not rootNow.Parent or Humanoid.Health <= 0 then break end
                    if (rootNow.Position - saved.pivot.Position).Magnitude < 25 then break end
                    pcall(function()
                        rootNow.Anchored = true
                        Character:PivotTo(saved.pivot)
                        rootNow.AssemblyLinearVelocity  = Vector3.zero
                        rootNow.AssemblyAngularVelocity = Vector3.zero
                        rootNow.Anchored = false
                    end)
                    RunService.Heartbeat:Wait()
                end
            end
        end
    end
    FlingFunctions.safeReturn(true)
    pcall(function() workspace.FallenPartsDestroyHeight = savedFPDH end)
    return true, (monitor and monitor.hit) or false
end

function FlingFunctions.SkidFling_Alt(TargetPlayer, forcedPart, monitor)
    local Character  = Me.Character
    local Humanoid   = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart   = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer.Character
    if not TCharacter then return false, false end
    local THumanoid  = TCharacter:FindFirstChildOfClass("Humanoid")
    if not (Character and Humanoid and RootPart) then
        FlingFunctions.setStatus("Character not ready", AMBER); return false, false
    end
    FlingFunctions.captureReturn(Character, RootPart, Humanoid)
    if THumanoid and THumanoid.Sit then
        FlingFunctions.setStatus(TargetPlayer.Name .. " is sitting", AMBER)
        returnSnapshot = nil; return false, false
    end
    if not TCharacter:FindFirstChildWhichIsA("BasePart") then
        returnSnapshot = nil; return false, false
    end

    local aimPart = forcedPart
    if not (aimPart and aimPart:IsA("BasePart") and aimPart.Parent and not aimPart.Anchored) then
        aimPart = FlingFunctions.findAnyTargetPart(TCharacter, THumanoid)
    end
    if not aimPart then
        FlingFunctions.setStatus(TargetPlayer.Name .. " no tracking part", AMBER)
        returnSnapshot = nil; return false, false
    end
    if monitor then
        local suffix = (currentAimTarget == "hrp") and "[HRP]" or "[Arm]"
        monitor.aimedPartName = aimPart.Name .. suffix
    end

    local checkpoint = (returnSnapshot and returnSnapshot.pivot) or Character:GetPivot()

    local savedFPDH         = workspace.FallenPartsDestroyHeight
    local savedRootCollide  = RootPart.CanCollide
    local savedRootMassless = RootPart.Massless

    local overlapParams = FlingFunctions.makeTargetOverlapParams(TCharacter)
    local touchConnection
    if RootPart.CanTouch then
        pcall(function()
            touchConnection = RootPart.Touched:Connect(function(part)
                if monitor and HitDebug.acceptsPart(part, TCharacter, monitor and monitor.aimMode) then
                    monitor.overlap = true
                    monitor.lastOverlapAt = os.clock()
                    monitor.touchedPartName = FlingFunctions.hitPartLabel(part, TCharacter)
                    pcall(HitDebug.record, monitor, part, RootPart, "Touched")
                end
            end)
        end)
    end

    selfFlinging = true
    local oldSeated = returnSnapshot and returnSnapshot.seatedEnabled

    local ran, result = xpcall(function()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

        local sliceTime  = CONFIG.AltSliceTime  or 1.2
        local maxCycles  = CONFIG.AltMaxCycles  or 6
        local returnWait = CONFIG.AltReturnWait or 0.15

        local gotHit = false
        for cycle = 1, maxCycles do
            if not FlingActive then break end
            if monitor and monitor.hit then gotHit = true; break end

            FlingFunctions.hardTeleportToTarget(TargetPlayer, aimPart)
            task.wait()

            local sliceHit = FlingFunctions.runV234Slice(sliceTime, Character, Humanoid, RootPart,
                TCharacter, THumanoid, aimPart, monitor, overlapParams)
            if sliceHit or (monitor and monitor.hit) then gotHit = true; break end
            if not FlingActive then break end

            pcall(function()
                RootPart.Anchored = true
                Character:PivotTo(checkpoint)
                RootPart.AssemblyLinearVelocity  = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
                RootPart.Anchored = false
            end)

            task.wait(returnWait)
        end

        return gotHit
    end, function(err) return tostring(err) end)

    if not ran then
        warn("[Fling Alt] error:", result)
        FlingFunctions.setStatus("Alt error", RED, tostring(result):sub(1, 110))
    end

    if touchConnection then touchConnection:Disconnect() end
    pcall(function()
        RootPart.CanCollide = savedRootCollide
        RootPart.Massless = savedRootMassless
    end)
    FlingFunctions.zeroCharacterMotion(Character)
    pcall(function()
        if Humanoid.Parent then
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated,
                oldSeated ~= nil and oldSeated or true)
        end
    end)
    selfFlinging = false

    pcall(function()
        if RootPart and RootPart.Parent and Humanoid and Humanoid.Health > 0 then
            RootPart.Anchored = true
            Character:PivotTo(checkpoint)
            RootPart.AssemblyLinearVelocity  = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
            RootPart.Anchored = false
        end
    end)
    FlingFunctions.safeReturn(true)
    pcall(function() workspace.FallenPartsDestroyHeight = savedFPDH end)
    return true, (monitor and monitor.hit) or false
end

function FlingFunctions.SkidFling(TargetPlayer, forcedPart, monitor)
    if currentFlingType == "alt" then
        return FlingFunctions.SkidFling_Alt(TargetPlayer, forcedPart, monitor)
    else
        return FlingFunctions.SkidFling_KILASIK(TargetPlayer, forcedPart, monitor)
    end
end

function FlingFunctions.burstFlingTarget(player)
    if not FlingFunctions.isTargetReady(player) then return false, 0, 0, nil end
    local tc = player.Character
    if not tc then return false, 0, 0, nil end
    if CONFIG.AutoFreezeTarget then FlingFunctions.preFreezeTarget(player) end
    local bestPeak, attempts = 0, 0
    local anyOverlap, bestResponseDelta = false, 0
    local lastPartName = nil
    local tHum = tc:FindFirstChildOfClass("Humanoid")
    for i = 1, HRP_BURST.MaxAttempts do
        if not FlingActive then break end
        if not FlingFunctions.isTargetReady(player) then break end
        if attempts > 0 and flungTargets[player] then
            FlingFunctions.setStatus(player.Name .. " already flung — stop chase", CYAN,
                "Skipping remaining attempts (won't follow airborne target)")
            break
        end
        local candidate, candidateName = FlingFunctions.findAnyTargetPart(tc, tHum)
        if not candidate then
            FlingFunctions.setStatus("Target part unavailable", AMBER)
            break
        end
        local _, _, tRoot = FlingFunctions.getTargetHRP(player)
        if CONFIG.AutoFreezeTarget and tRoot then
            local wasA = tRoot.Anchored
            pcall(function() tRoot.Anchored = true end)
            task.wait(CONFIG.AnchorHold)
            pcall(function() tRoot.Anchored = wasA end)
        end
        if currentFlingType ~= "alt" then
            FlingFunctions.hardTeleportToTarget(player, candidate)
        end
        if not FlingActive then break end
        attempts = attempts + 1
        local tRV = tRoot and tRoot.AssemblyLinearVelocity or Vector3.zero
        local monitor = {peak=0, hit=false, overlap=false,
            targetName=player.Name, targetCharacter=tc, attempt=attempts,
            aimMode=currentAimTarget, aimedPartName=candidateName, overlapSamples=0,
            startVelocity=tRV, responseDelta=0}
        FlingFunctions.SkidFling(player, candidate, monitor)
        if monitor.contactPartName or monitor.overlapPart then
            lastPartName = monitor.contactPartName or monitor.overlapPart
        end
        if monitor.peak > bestPeak then bestPeak = monitor.peak end
        anyOverlap = anyOverlap or monitor.overlap
        bestResponseDelta = math.max(bestResponseDelta, monitor.responseDelta)
        if monitor.hit then
            flungTargets[player] = true
            local ch = Me.Character
            local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
            local holdA = myRoot and myRoot.Anchored or false
            if myRoot then
                pcall(function()
                    myRoot.Anchored = true
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                end)
            end
            FlingFunctions.setStatus(string.format("@%s contact (%s) · %s · %s", player.Name,
                tostring(monitor.contactPartName or monitor.overlapPart or "?"),
                FlingFunctions.getCurrentFlingLabel(), FlingFunctions.getCurrentTargetLabel()), GREEN)
            local hs = tick()
            while tick() - hs < CONFIG.HoldAfterHit do
                if not FlingActive then break end
                if myRoot and myRoot.Parent then
                    pcall(function()
                        myRoot.AssemblyLinearVelocity = Vector3.zero
                        myRoot.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
                task.wait(0.05)
            end
            if myRoot and myRoot.Parent then
                pcall(function() myRoot.Anchored = holdA end)
            end
            if CONFIG.AutoFreezeTarget then FlingFunctions.postUnfreezeTarget(player) end
            return true, bestPeak, attempts, lastPartName, anyOverlap, bestResponseDelta
        end
        if CONFIG.AutoFreezeTarget then FlingFunctions.preFreezeTarget(player) end
        task.wait(HRP_BURST.DelayBetween)
    end
    if CONFIG.AutoFreezeTarget then FlingFunctions.postUnfreezeTarget(player) end
    return false, bestPeak, attempts, lastPartName, anyOverlap, bestResponseDelta
end

function FlingFunctions.activeTargets()
    local list = {}
    for _, p in pairs(SelectedTargets) do
        if p and p.Parent == Players then table.insert(list, p)
        else SelectedTargets[p.Name] = nil end
    end
    return list
end
function FlingFunctions.startFlingInternal(todo)
    FlingActive = true
    task.spawn(function()
        local ch = Me.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if ch and root and hum then FlingFunctions.captureReturn(ch, root, hum) end
        for i, player in ipairs(todo) do
            if not FlingActive then break end
            currentTarget = player
            FlingFunctions.setStatus(string.format("Flinging @%s (%d/%d) · %s · %s",
                player.Name, i, #todo, FlingFunctions.getCurrentFlingLabel(), FlingFunctions.getCurrentTargetLabel()), WHITE,
                currentFlingType == "alt" and "v23.4 slice → TP back → repeat"
                or "KILASIK 4s rotation on lock point")
            FlingFunctions.stopFollowThread()
            local skip = flungTargets[player] == true
            if skip then
                task.wait(CONFIG.Cooldown)
                FlingFunctions.safeReturn()
            else
                local ok, peak, tries, pn, observedOverlap, responseDelta = FlingFunctions.burstFlingTarget(player)
                if ok then
                    FlingFunctions.setStatus(string.format("@%s contact (%s)", player.Name, tostring(pn or "?")),
                        GREEN, string.format("Peak %.0f | %d tries", peak, tries))
                else
                    if observedOverlap then
                        FlingFunctions.setStatus(string.format("@%s local overlap only", player.Name), AMBER,
                            string.format("No confirmed motion | peak %.0f, delta %.0f | %d tries",
                                peak, responseDelta or 0, tries))
                    else
                        FlingFunctions.setStatus(string.format("@%s no local overlap", player.Name), AMBER,
                            string.format("No matching target-part intersection | %d tries", tries))
                    end
                end
                task.wait(CONFIG.Cooldown)
                FlingFunctions.safeReturn()
            end
        end
        FlingActive = false
        currentTarget = nil
        if FlingFunctions.safeReturn() then
            returnSnapshot = nil
            FlingFunctions.setStatus("Done — locally returned", GREEN)
        else
            FlingFunctions.setStatus("Completed — landing unverified", AMBER)
        end
    end)
end
startFling = function()
    if FlingActive then return end
    local todo = FlingFunctions.activeTargets()
    if #todo == 0 then FlingFunctions.setStatus("No targets selected", AMBER); return end
    for _, p in ipairs(todo) do flungTargets[p] = nil end
    FlingFunctions.startFlingInternal(todo)
end
function FlingFunctions.stopFling()
    FlingActive = false
    FlingFunctions.stopFollowThread()
    if not selfFlinging then FlingFunctions.safeReturn() end
    FlingFunctions.setStatus("Stopped", MUTED)
end

