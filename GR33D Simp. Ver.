task.spawn(function()
    while true do
        if OrbitState ~= 0 then
            local char = Me.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                pcall(function() sethiddenproperty(Me, "SimulationRadius", config.simRadius) end)
                local parts = workspace:GetPartBoundsInRadius(root.Position, config.scanRadius)
                local processed = 0
                for _, item in ipairs(parts) do
                    if processed >= config.maxItemsPerLoop then break end
                    if item:IsA("BasePart") and not item.Anchored
                       and not item:IsDescendantOf(char) then
                        if not itemsInRingLookup[item] then
                            table.insert(itemsInRing, item)
                            itemsInRingLookup[item] = true
                            processed = processed + 1
                        end
                    end
                end
                local cleaned = 0
                for i = #itemsInRing, 1, -1 do
                    if cleaned > 15 then break end
                    local item = itemsInRing[i]
                    if not item or not item.Parent then
                        itemsInRingLookup[item] = nil
                        table.remove(itemsInRing, i)
                        cleaned = cleaned + 1
                    end
                end
            end
        end
        task.wait(0.7)
    end
end)

RunService.Stepped:Connect(function()
    if OrbitState == 0 then return end
    local char = Me.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end

    local targetPart = nil

    if OrbitState == 2 and LockedPosition then
        targetPart = {Position = LockedPosition}
    else
        local bestSelected, bestSelectedName, bestSelectedDist = nil, nil, math.huge
        for name in pairs(targetPlayerNames) do
            if not rungPlayers[name] then
                local p = Players:FindFirstChild(name)
                if p and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (root.Position - hrp.Position).Magnitude
                        if d < bestSelectedDist then
                            bestSelectedDist = d
                            bestSelected = hrp
                            bestSelectedName = name
                        end
                    end
                end
            end
        end

        if bestSelected then
            targetPart = bestSelected
            lastTargetPos = bestSelected.Position

            if orbitTargetName ~= bestSelectedName then
                orbitTargetName = bestSelectedName
                orbitTargetStart = tick()
            else
                local elapsed = tick() - orbitTargetStart
                local velMag = 0
                pcall(function() velMag = bestSelected.AssemblyLinearVelocity.Magnitude end)
                if elapsed >= config.ringSuccessTime or velMag >= config.flingVelThreshold then
                    rungPlayers[bestSelectedName] = true
                    orbitTargetName = nil
                    task.defer(function()
                        setStatus("Rung: " .. bestSelectedName, GREEN, "Skipped")
                        refreshPlayers()
                    end)
                end
            end
        elseif lastTargetPos then
            targetPart = {Position = lastTargetPos}
        elseif next(targetPlayerNames) == nil then
            local closestDist = config.targetRadius
            local closest = nil
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= Me and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (root.Position - hrp.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closest = hrp
                        end
                    end
                end
            end
            targetPart = closest or root
        else
            targetPart = lastTargetPos and {Position = lastTargetPos} or root
        end
    end

    if not targetPart then targetPart = root end

    local isEven = (math.floor(tick()) % 2 == 0)
    local curRadius = isEven and config.radiusA or config.radiusB
    local curHeight = isEven and config.heightA or config.heightB
    local baseSpeed = config.baseSpeedMultiplier
    local totalItems = math.max(#itemsInRing, 1)

    local localHrp = root
    local immunityOn = config.selfImmunity
    local immunitySq = config.immunityRadius * config.immunityRadius

    for i = #itemsInRing, 1, -1 do
        local item = itemsInRing[i]
        if item and item.Parent and not item.Anchored then
            local bp = item:FindFirstChild("OrbitBP")
            if not bp then
                bp = Instance.new("BodyPosition", item)
                bp.Name = "OrbitBP"
                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bp.P = 1e10
                bp.D = 500
            end
            item.CanCollide = false
            item.Velocity = Vector3.zero
            item.RotVelocity = Vector3.zero
            local itemSpeed = baseSpeed + ((i % 10) * 0.5)
            local angle = (tick() * itemSpeed) + (i * (math.pi * 2 / totalItems))
            local targetPos = targetPart.Position + Vector3.new(
                math.cos(angle) * curRadius,
                curHeight,
                math.sin(angle) * curRadius
            )

            if immunityOn and localHrp then
                local offset = targetPos - localHrp.Position
                local distSq = offset.X*offset.X + offset.Y*offset.Y + offset.Z*offset.Z
                if distSq < immunitySq then
                    if distSq < 0.01 then
                        targetPos = localHrp.Position + Vector3.new(config.immunityRadius + 2, 0, 0)
                    else
                        targetPos = localHrp.Position + offset.Unit * (config.immunityRadius + 2)
                    end
                end
            end

            bp.Position = targetPos
        else
            if itemsInRingLookup[item] then itemsInRingLookup[item] = nil end
            table.remove(itemsInRing, i)
        end
    end
end)

