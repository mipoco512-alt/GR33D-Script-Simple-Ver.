    local tabW = math.floor((navWidth - (tabCount-1) * gap) / tabCount)
    for i, name in ipairs(tabList) do
        local x = (i - 1) * (tabW + gap)
        local ww = (i == tabCount) and (navWidth - x) or tabW
        place(tabButtons[name], x, 0, ww, 46)
