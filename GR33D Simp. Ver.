local function place(obj, x, y, w, h)
    obj.Position = UDim2.fromOffset(x, y)
    obj.Size = UDim2.fromOffset(w, h)
end

local function reflow(panelWidth, panelHeight)
    local innerWidth = panelWidth - 44
    local innerHeight = math.max(1, PageHost.Size.Y.Offset)
    local gap = 10
    local navWidth = panelWidth - 24
    local tabCount = 3
    local tabW = math.floor((navWidth - (tabCount-1) * gap) / tabCount)
    for i, name in ipairs({"Players", "Ring", "Tools"}) do
        local x = (i - 1) * (tabW + gap)
        local ww = (i == tabCount) and (navWidth - x) or tabW
        place(tabButtons[name], x, 0, ww, 42)
        tabButtons[name].TextSize = 12
    end

    place(sectionPlayers, 10, 10, innerWidth, 16)
    place(Search, 10, 32, innerWidth, 40)
    place(Count, 10, 78, innerWidth, 16)
    local listY = 100
    local listH = math.max(80, innerHeight - listY - 10)
    place(List, 10, listY, innerWidth, listH)
    List.CanvasSize = UDim2.fromOffset(0, math.ceil(ListLayout.AbsoluteContentSize.Y) + 22)

    local ringY = 14
    place(RingHeading, 10, ringY, innerWidth, 22); ringY = ringY + 26
    place(RingHint, 10, ringY, innerWidth, 52); ringY = ringY + 60
    place(RingToggle, 10, ringY, innerWidth, 46); ringY = ringY + 58
    for _, row in ipairs(ringRows) do
        place(row.label, 10, ringY, innerWidth, 16)
        place(row.dec, 10, ringY + 22, 42, 34)
        place(row.box, 60, ringY + 22, innerWidth - 100, 34)
        place(row.inc, 10 + innerWidth - 42, ringY + 22, 42, 34)
        ringY = ringY + 62
    end
    place(RingNote, 10, ringY, innerWidth, 44)
    RingPage.CanvasSize = UDim2.fromOffset(0, ringY + 60)

    place(ToolsHeading, 10, 14, innerWidth, 22)
    place(ToolsHint, 10, 40, innerWidth, 34)
    ToolsPage.CanvasSize = UDim2.fromOffset(0, 400)
end

