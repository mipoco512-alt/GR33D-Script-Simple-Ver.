    local ln = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Me and (p.Name:lower() == ln
            or p.Name:lower():sub(1,#ln) == ln
            or p.DisplayName:lower():sub(1,#ln) == ln) then
            return p
        end
    end
    return nil
end
function FlingFunctions.getActiveTarget()
