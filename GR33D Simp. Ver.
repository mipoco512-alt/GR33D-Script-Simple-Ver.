local function refreshPlayers()
    if not Gui.Parent then return end
    local savedScroll = List.CanvasPosition.Y
    for _, r in pairs(rows) do r:Destroy() end
    table.clear(rows)
    local all = Players:GetPlayers()
    table.sort(all, function(a,b) return a.Name:lower() < b.Name:lower() end)
    local shown = 0
    for _, player in ipairs(all) do
        if player ~= Me then
            shown = shown + 1
            local selected = targetPlayerNames[player.Name] == true
            local completed = completedTargets[player.Name]
            local active = currentRingTarget == player and OrbitState == 1
            local Row = make("TextButton", {Size=UDim2.new(1,-18,0,56),
                LayoutOrder=shown,
                BackgroundColor3 = active and Color3.fromRGB(46,93,101)
                    or (completed and Color3.fromRGB(75,65,56))
                    or (selected and Color3.fromRGB(58,78,110) or ROW),
                BorderSizePixel=0, AutoButtonColor=false, Text=""}, List)
            round(Row, 10)
            Row.MouseEnter:Connect(function()
                if not targetPlayerNames[player.Name] and not completedTargets[player.Name] then Row.BackgroundColor3 = ROWHI end
            end)
            Row.MouseLeave:Connect(function()
                if not targetPlayerNames[player.Name] and not completedTargets[player.Name] then Row.BackgroundColor3 = ROW end
            end)
            local pic = make("ImageLabel", {Position=UDim2.fromOffset(36,6),
                Size=UDim2.fromOffset(40,40), BackgroundColor3=PANEL, Image=""}, Row)
            round(pic, 20)
            local check = make("Frame", {Position=UDim2.fromOffset(8,15),
                Size=UDim2.fromOffset(22,22), BackgroundColor3=Color3.fromRGB(60,70,95),
                BorderSizePixel=0}, Row)
            round(check, 6)
            make("UIStroke", {Color=Color3.fromRGB(80,92,118), Thickness=1}, check)
            make("TextLabel", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1,
                Text="✓", TextColor3=Color3.fromRGB(60,230,130),
                Font=Enum.Font.GothamBold, TextSize=16, Visible=selected}, check)
            local observation = ringObservations[player.UserId]
            local tiny = List.AbsoluteSize.X > 0 and List.AbsoluteSize.X < 300
            local hasMark = completed ~= nil or observation ~= nil or active
            local nameWidth = hasMark and (tiny and -148 or -195) or -92
            local dl = label(player.DisplayName, 13, UDim2.fromOffset(84,6),
                UDim2.new(1,nameWidth,0,22), Row)
            dl.Font = Enum.Font.GothamBold
            local ul = label("@"..player.Name, 10, UDim2.fromOffset(84,28),
                UDim2.new(1,nameWidth,0,18), Row)
            ul.TextColor3 = MUTED
            if hasMark then
                local markText = active and "ACTIVE" or (completed and "DONE" or "MOVED?")
                local mark = label(markText, 10,
                    UDim2.new(1,tiny and -63 or -91,0,17),
                    UDim2.fromOffset(tiny and 56 or 80,20), Row)
                mark.Font = Enum.Font.GothamBold
                mark.TextColor3 = active and GREEN or AMBER
            end
            loadAvatar(player, pic, Enum.ThumbnailSize.Size100x100)
            Row.MouseButton1Click:Connect(function()
                if targetPlayerNames[player.Name] then
                    targetPlayerNames[player.Name] = nil
                    completedTargets[player.Name] = nil
                    if orbitTargetName == player.Name then
                        orbitTargetName = nil
                        orbitTargetStarted = 0
                        currentRingTarget = nil
                        resetOrbitMeasurement()
                    end
                else
                    targetPlayerNames[player.Name] = true
                    completedTargets[player.Name] = nil
                end
                refreshPlayers()
                local n = selectedCount()
                setStatus(n == 0 and "Target: self" or ("Target: "..n.." selected"),
                    n == 0 and MUTED or Color3.fromRGB(80,180,200))
            end)
            rows[player] = Row
        end
    end
    local n = selectedCount()
    local marked = 0
    for _ in pairs(ringObservations) do marked += 1 end
    local done = 0
    for _ in pairs(completedTargets) do done += 1 end
    Count.Text = string.format("%d online · %d selected · %d done · %d moved?",
        #all, n, done, marked)
    -- UIListLayout updates after the new rows are parented. Defer the scroll bounds.
    task.defer(function()
        if not List.Parent then return end
        List.CanvasSize = UDim2.fromOffset(0, ListLayout.AbsoluteContentSize.Y + 14)
        local maxScroll = math.max(0, List.CanvasSize.Y.Offset - List.AbsoluteSize.Y)
        List.CanvasPosition = Vector2.new(0, math.clamp(savedScroll, 0, maxScroll))
    end)
end

