local PartTracker = {}
local CharParts   = {}

function FlingFunctions.trackCharacter(char)
    if not char then return end
    local old = CharParts[char]
    if old then
        for _, p in ipairs(old) do PartTracker[p] = nil end
    end
    local parts = {}
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then
            PartTracker[d] = { pos = d.Position, vel = d.AssemblyLinearVelocity, time = os.clock() }
            parts[#parts + 1] = d
        end
    end
    CharParts[char] = parts
end
function FlingFunctions.untrackCharacter(char)
    if not char then return end
    local parts = CharParts[char]
    if parts then
        for _, p in ipairs(parts) do PartTracker[p] = nil end
        CharParts[char] = nil
    end
end
function FlingFunctions.bindPlayer(plr)
    if plr == Me then return end
    local function onChar(char)
        FlingFunctions.trackCharacter(char)
        char.DescendantAdded:Connect(function(d)
            if d:IsA("BasePart") and not PartTracker[d] then
                PartTracker[d] = { pos = d.Position, vel = d.AssemblyLinearVelocity, time = os.clock() }
                local list = CharParts[char]
                if list then list[#list + 1] = d end
            end
        end)
        char.DescendantRemoving:Connect(function(d)
            if PartTracker[d] then PartTracker[d] = nil end
        end)
    end
    plr.CharacterAdded:Connect(onChar)
    if plr.Character then onChar(plr.Character) end
end
for _, p in ipairs(Players:GetPlayers()) do FlingFunctions.bindPlayer(p) end
Players.PlayerAdded:Connect(FlingFunctions.bindPlayer)
Players.PlayerRemoving:Connect(function(p)
    if p.Character then FlingFunctions.untrackCharacter(p.Character) end
end)
table.insert(connections, RunService.RenderStepped:Connect(function()
    for char, parts in pairs(CharParts) do
        if not char.Parent then
            FlingFunctions.untrackCharacter(char)
        else
            for i = #parts, 1, -1 do
                local d = parts[i]
                if d.Parent then
                    local t = PartTracker[d]
                    if t then
                        t.pos  = d.Position
                        t.vel  = d.AssemblyLinearVelocity
                        t.time = os.clock()
                    end
                else
                    PartTracker[d] = nil
                    table.remove(parts, i)
                end
            end
        end
    end
end))
function FlingFunctions.predictPart(part, extraTime)
    if not part then return nil end
    local data = PartTracker[part]
    if not data then return part.Position end
    local dt = (os.clock() - (data.time or os.clock())) + (extraTime or 0)
    if dt > 0.35 then dt = 0.35 end
    if dt < 0 then dt = 0 end
    local v = data.vel or Vector3.zero
    if v.Magnitude > 250 then v = v.Unit * 250 end
    return data.pos + v * dt
end

