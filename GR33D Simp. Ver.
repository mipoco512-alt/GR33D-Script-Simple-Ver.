local function loadAvatar(player, image, size)
    image:SetAttribute("AvatarUserId", player.UserId)
    image.Image = ""
    task.spawn(function()
        local ok, url = pcall(function()
            return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, size)
