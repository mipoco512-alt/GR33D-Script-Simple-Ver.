do
local PhysicsService = game:GetService("PhysicsService")
local hitObservations = {}
local HIT_LOG_LIMIT = 32
-- Focus is used for both the actual tracking point and the contact list.
-- Exclude the head, hats, hair and other accessories: they can overlap
-- without constituting the limb contact the user wants to inspect.
HitDebug.focus = "Both" -- show all limbs; display filter never changes movement
local LIMB_FAMILIES = {
    LeftUpperArm = "Arms", RightUpperArm = "Arms",
    LeftLowerArm = "Arms", RightLowerArm = "Arms",
    LeftHand = "Arms", RightHand = "Arms",
    LeftUpperLeg = "Legs", RightUpperLeg = "Legs",
    LeftLowerLeg = "Legs", RightLowerLeg = "Legs",
    LeftFoot = "Legs", RightFoot = "Legs",
    ["Left Arm"] = "Arms", ["Right Arm"] = "Arms", -- R6
    ["Left Leg"] = "Legs", ["Right Leg"] = "Legs",
}
HitDebug.partFamily = function(part, character)
    if not part or not character or part.Parent ~= character then return nil end
    if not part:IsA("BasePart") then return nil end
    return LIMB_FAMILIES[part.Name]
end
-- Record all legitimate limb observations, even when a display filter is selected.
HitDebug.acceptsPart = function(part, character)
    return HitDebug.partFamily(part, character) ~= nil
end
local function visibleHit(record)
    local family = LIMB_FAMILIES[record.partName]
    return HitDebug.focus == "Both" or family == HitDebug.focus
        or (HitDebug.focus == "LeftArm"
            and (record.partName == "LeftLowerArm" or record.partName == "LeftUpperArm"
                or record.partName == "LeftHand" or record.partName == "Left Arm"))
end

local function hitVec(v)
    return string.format("(%.1f, %.1f, %.1f)", v.X, v.Y, v.Z)
end

local function hitEvidence(record)
    local evidence = {}
    if record.touched then table.insert(evidence, "Touched event") end
    if record.overlap then table.insert(evidence, "spatial overlap") end
    if record.response then table.insert(evidence, "HRP motion response") end
    return #evidence > 0 and table.concat(evidence, " + ") or "unverified"
end

local function hitStatus(record)
    if not record then return "No observations yet" end
    if record.response then return "Overlap/touch + correlated motion (LOCAL)" end
    if record.touched then return "Touched event (LOCAL, not server-verified)" end
    return "Spatial overlap only (NOT a confirmed hit)"
end

local function renderHitInfo()
    if not HitDebug.summary or not HitDebug.summary.Parent then return end
    -- Hidden page: defer costly multi-line text layout until user opens Hits.
    if not HitDebug.summary.Parent.Visible then return end
    -- Prefer the newest limb observation, not a historic response from an
    -- earlier target or attempt. Older responses stay in the history below.
    local newest = nil
    for _, observation in ipairs(hitObservations) do
        if visibleHit(observation) then newest = observation; break end
    end
    if not newest then
        HitDebug.summary.Text = "No " .. (HitDebug.focus == "Both" and "arm/leg" or (HitDebug.focus == "LeftArm" and "left-arm" or HitDebug.focus:lower())) .. " contact observed."
        HitDebug.details.Text = "Head and accessories are ignored.\nTracking starts on LeftUpperArm; local observations can reprioritize later attempts."
        HitDebug.log.Text = "The most recent 32 observations appear here."
        return
    end
    HitDebug.summary.Text = string.format("@%s  •  %s  •  %s", newest.target,
        newest.partName, newest.zone)
    HitDebug.details.Text = string.format(
        "Aimed at: %s\nApprox. point: %s\nEvidence: %s\nCollision eligible: %s  |  Try %s",
        newest.aimedPart or "unknown", hitVec(newest.point), hitStatus(newest),
        newest.collidable and "Yes" or "No/unknown", tostring(newest.attempt))
    if not HitDebug.showHistory then return end
    local lines = {}
    local shown = 0
    for _, event in ipairs(hitObservations) do
        if visibleHit(event) then
            shown = shown + 1
            lines[#lines + 1] = string.format(
                "%02d  @%s  [try %s]\n       Aim: %s\n       Observed: %s | %s\n       %s  •  %s\n       %s",
                shown, event.target, tostring(event.attempt), event.aimedPart or "unknown",
                event.partName, event.zone, hitEvidence(event), hitVec(event.point),
                event.collidable and "Collidable locally" or "Overlap / collision unverified")
        end
    end
    HitDebug.log.Text = table.concat(lines, "\n\n")
end

-- Batch UI updates instead of rebuilding the entire history once per
-- overlapping limb within a single simulation frame.
local hitRenderQueued = false
local function queueHitRender()
    if hitRenderQueued then return end
    hitRenderQueued = true
    task.delay(CONFIG.HitUIRefreshSeconds, function()
        hitRenderQueued = false
        if HitDebug.summary and HitDebug.summary.Parent then
            renderHitInfo()
        end
    end)
end

local function clearHitInfo()
    table.clear(hitObservations)
    renderHitInfo()
end

-- The nearest point on the hit part is an approximation, not an exact
-- collision solver contact manifold. Orientation is local to that part.
local function approximateHitZone(part, myRoot)
    local approx = part.Position
    pcall(function() approx = part:GetClosestPointOnSurface(myRoot.Position) end)
    local localPos = part.CFrame:PointToObjectSpace(approx)
    local sx = math.max(part.Size.X * 0.5, 0.01)
    local sy = math.max(part.Size.Y * 0.5, 0.01)
    local sz = math.max(part.Size.Z * 0.5, 0.01)
    local horizontal = "center"
    local x, z = localPos.X / sx, localPos.Z / sz
    if math.abs(x) > math.abs(z) and math.abs(x) > 0.35 then
        horizontal = x > 0 and "right" or "left"
    elseif math.abs(z) > 0.35 then
        horizontal = z < 0 and "front" or "back"
    end
    local y = localPos.Y / sy
    local vertical = y > 0.35 and "upper" or (y < -0.35 and "lower" or "middle")
    return vertical .. " / " .. horizontal, approx
end

local function arePartsCollisionEligible(myRoot, otherPart)
    if not myRoot.CanCollide or not otherPart.CanCollide then return false end
    local ok, allowed = pcall(function()
        return PhysicsService:CollisionGroupsAreCollidable(myRoot.CollisionGroup, otherPart.CollisionGroup)
    end)
    return ok and allowed == true
end

local function hitPartLabel(part, character)
    local ancestor = part.Parent
    if ancestor and ancestor ~= character and ancestor:IsA("Accessory") then
        return ancestor.Name .. "." .. part.Name
    end
    return part.Name
end

local function recordHitObservation(monitor, part, myRoot, observationKind)
    if not monitor or not myRoot or not HitDebug.acceptsPart(part, monitor.targetCharacter) then
        return nil
    end
    local now = os.clock()
    monitor.hitRecords = monitor.hitRecords or {}
    local record = monitor.hitRecords[part]
    local changed = false
    if not record then
        local zone, point = approximateHitZone(part, myRoot)
        record = {
            target = monitor.targetName or "unknown",
            partName = hitPartLabel(part, monitor.targetCharacter),
            aimedPart = monitor.aimedPartName or "unknown",
            zone = zone, point = point, attempt = monitor.attempt or "?",
            collidable = arePartsCollisionEligible(myRoot, part),
            overlap = false, touched = false, response = false,
            timestamp = now,
        }
        monitor.hitRecords[part] = record
        table.insert(hitObservations, 1, record)
        if #hitObservations > HIT_LOG_LIMIT then table.remove(hitObservations) end
        changed = true
    end
    if observationKind == "Touched" and not record.touched then
        record.touched = true
        monitor.lastTouchedRecord = record
        monitor.lastTouchedAt = now
        changed = true
    elseif observationKind == "Overlap" and not record.overlap then
        record.overlap = true
        changed = true
    end
    record.timestamp = now
    monitor.lastObservedRecord = record
    if record.collidable then monitor.lastEligibleRecord = record end
    monitor.overlapPart = record.partName
    if changed then queueHitRender() end
    return record
end

local function flagMotionResponse(monitor)
    -- Prefer a recent Touched callback, otherwise use collision-eligible
    -- geometry, then any recent overlap. These are correlations, not proof.
    local now = os.clock()
    local preferred = nil
    if monitor.lastTouchedAt and now - monitor.lastTouchedAt <= 0.4 then
        preferred = monitor.lastTouchedRecord
    end
    if not preferred and monitor.lastEligibleRecord
        and now - monitor.lastEligibleRecord.timestamp <= 0.4 then
        preferred = monitor.lastEligibleRecord
    end
    if not preferred and monitor.lastObservedRecord
        and now - monitor.lastObservedRecord.timestamp <= 0.4 then
        preferred = monitor.lastObservedRecord
    end
    monitor.correlatedRecord = preferred -- candidate for session-only adaptive ranking
    if preferred and not preferred.response then
        preferred.response = true
        preferred.timestamp = now
        -- Make the correlated movement observation the latest record until
        -- a newer limb observation appears. Do not pin old successes forever.
        for index, record in ipairs(hitObservations) do
            if record == preferred then
                table.remove(hitObservations, index)
                table.insert(hitObservations, 1, preferred)
                break
            end
        end
        queueHitRender()
    end
    monitor.contactPartName = preferred and preferred.partName or monitor.overlapPart
end
HitDebug.record = recordHitObservation
HitDebug.flag = flagMotionResponse
HitDebug.render = renderHitInfo
HitDebug.clear = clearHitInfo
end


--====================================
-- SESSION-ONLY ADAPTIVE LIMB PREFERENCES
--====================================
-- IMPORTANT: A local HRP response after an overlap is NOT a proven
-- server-accepted hit. These are diagnostic rankings, not guarantees.
-- No files, server modifications or persistent exploit data are used.
do
    local preferenceByUserId = {}
    local baseOrder = {
        "LeftUpperArm", "LeftLowerArm", "LeftUpperLeg", "RightUpperLeg",
        "LeftHand", "RightLowerArm", "RightUpperArm", "LeftLowerLeg",
        "RightLowerLeg", "RightHand", "LeftFoot", "RightFoot",
        "Left Arm", "Left Leg", "Right Leg", "Right Arm", -- R6 fallbacks
    }
    local baseRank = {}
    for i, name in ipairs(baseOrder) do baseRank[name] = i end

    local function playerStats(player, create)
        local key = player and player.UserId
        if not key then return nil end
        local value = preferenceByUserId[key]
        if not value and create then
            value = { scores = {}, signals = 0, lastObserved = nil }
            preferenceByUserId[key] = value
        end
        return value
    end

    function Adaptive.choose(player, character, attempt)
        if not character then return nil, nil end
        -- Fixed selection takes precedence over adaptive scores/rotation.
        -- A classic R6 alias is used only if the selected R15 part does not exist.
        -- If neither exists, the adaptive fallback prevents a nil target.
        local requested = TargetPicker.selected
        if requested ~= "Auto" then
            local part = character:FindFirstChild(requested)
            if not (part and part:IsA("BasePart") and part.Parent == character
                and not part.Anchored) then
                local alias = TargetPicker.r6Aliases[requested]
                part = alias and character:FindFirstChild(alias) or nil
            end
            if part and part:IsA("BasePart") and part.Parent == character
                and not part.Anchored then
                return part, part.Name
            end
        end
        local stats = playerStats(player, false)
        local available = {}
        for _, name in ipairs(baseOrder) do
            local part = character:FindFirstChild(name)
            if part and part:IsA("BasePart")
                and part.Parent == character and not part.Anchored then
                available[#available + 1] = part
            end
        end
        if #available == 0 then return nil, nil end
        -- Freeze priority for the duration of a single multi-attempt run.
        -- Otherwise a missed overlap can reshuffle the list midway and
        -- accidentally skip the next intended limb.
        stats = stats or playerStats(player, true)
        local attemptIndex = math.max(1, attempt or 1)
        if stats and (attemptIndex == 1 or stats.cycleCharacter ~= character
            or not stats.cycleOrder) then
            table.sort(available, function(a, b)
                local aa = (stats.scores[a.Name] or 0) + (a.Name == "LeftUpperArm" and 3 or 0)
                local bb = (stats.scores[b.Name] or 0) + (b.Name == "LeftUpperArm" and 3 or 0)
                if aa ~= bb then return aa > bb end
                return baseRank[a.Name] < baseRank[b.Name]
            end)
            stats.cycleCharacter = character
            stats.cycleOrder = {}
            for _, part in ipairs(available) do
                stats.cycleOrder[#stats.cycleOrder + 1] = part.Name
            end
        end
        local order = stats and stats.cycleOrder or {}
        for offset = 0, #order - 1 do
            local idx = ((attemptIndex - 1 + offset) % #order) + 1
            local part = character:FindFirstChild(order[idx])
            if part and part:IsA("BasePart") and part.Parent == character
                and not part.Anchored then
                return part, part.Name
            end
        end
        return nil, nil
    end

    function Adaptive.observe(player, monitor)
        if not monitor then return end
        local stats = playerStats(player, true)
        if not stats then return end
        local aimed = monitor.aimedPartName
        local correlated = monitor.correlatedRecord
        -- Only reinforce a limb when overlap/touch and a timely HRP motion
        -- response were observed in the same attempt; still only local evidence.
        if monitor.hit and correlated and correlated.response
            and baseRank[correlated.partName] then
            local limb = correlated.partName
            local gain = (monitor.attempt == 1) and 3 or 2
            stats.scores[limb] = math.min(15, (stats.scores[limb] or 0) + gain)
            stats.signals = stats.signals + 1
            stats.lastObserved = limb
        elseif monitor.overlap and aimed and baseRank[aimed] then
            -- Very small penalty for overlap without a motion response.
            stats.scores[aimed] = math.max(-2, (stats.scores[aimed] or 0) - 0.25)
        end
        Adaptive.refreshUI(player)
    end

    function Adaptive.clear()
        table.clear(preferenceByUserId)
        Adaptive.refreshUI(nil)
    end

    function Adaptive.refreshUI(player)
        if not HitDebug.priority or not HitDebug.priority.Parent then return end
        if TargetPicker.selected ~= "Auto" then
            HitDebug.priority.Text = "Fixed target: " .. TargetPicker.selected
                .. "  |  AUTO available from target picker"
            return
        end
        local stats = playerStats(player, false)
        if not stats or stats.signals == 0 then
            HitDebug.priority.Text = "Adaptive: LeftUpperArm first  |  no local response history"
            return
        end
        local bestPart, bestScore = nil, -math.huge
        for _, name in ipairs(baseOrder) do
            local score = stats.scores[name] or 0
            if score > bestScore then bestPart, bestScore = name, score end
        end
        HitDebug.priority.Text = string.format(
            "Adaptive @%s: %s  |  %d local motion signals",
            player.Name, bestPart or "LeftUpperArm", stats.signals)
    end
end

-- Telemetry keeps observations and manually reported outcomes separate.
-- A velocity spike is only a CLIENT-OBSERVED PROXY, never proof of server hit.
do
    local attempts = {}
    local MAX_ATTEMPTS_LOG = 80
    local batch = 0
    local latest = nil
    function Telemetry.startTarget(player)
        batch = batch + 1
        return batch
    end
    function Telemetry.record(player, monitor, batchID)
        if not player or not monitor then return end
        local source = monitor.startVelocity or Vector3.zero
        local ending = monitor.endVelocity or source
        local event = {
            target = player.Name, userId = player.UserId,
            batch = batchID, try = monitor.attempt or 0,
            aimed = monitor.aimedPartName or "unknown",
            observed = monitor.contactPartName or monitor.overlapPart or "none",
            startSpeed = source.Magnitude, endSpeed = ending.Magnitude,
            peakSpeed = monitor.peak or 0,
            speedDelta = monitor.responseDelta or 0,
            localMotion = monitor.hit == true,
            overlap = monitor.overlap == true,
            verdict = "Unmarked", landing = nil,
        }
        table.insert(attempts, 1, event)
        if #attempts > MAX_ATTEMPTS_LOG then table.remove(attempts) end
        latest = event
        Telemetry.render()
    end
    function Telemetry.setLanding(player, batchID, verified)
        for _, attempt in ipairs(attempts) do
            if attempt.userId == player.UserId and attempt.batch == batchID then
                attempt.landing = verified == true
            end
        end
        Telemetry.render()
    end
    function Telemetry.markLatest(verdict)
        if not latest then return false end
        if verdict ~= "Launched" and verdict ~= "Missed" then return false end
        latest.verdict = verdict -- USER labelled, not inferred from local physics
        Telemetry.render()
        return true
    end
    function Telemetry.reset()
        table.clear(attempts)
        latest = nil
        Telemetry.render()
    end
    local function calculate(targetId, partName, key)
        local n, launched, missed, motion = 0, 0, 0, 0
        for _, e in ipairs(attempts) do
            if e.userId == targetId and (not partName or e[key] == partName) then
                n = n + 1
                if e.verdict == "Launched" then launched = launched + 1 end
                if e.verdict == "Missed" then missed = missed + 1 end
                if e.localMotion then motion = motion + 1 end
            end
        end
        return n, launched, missed, motion
    end
    function Telemetry.render()
        if not HitDebug.stats or not HitDebug.stats.Parent then return end
        if not latest then
            HitDebug.stats.Text = "No attempts recorded yet.\nClient motion alone cannot confirm a launch."
            HitDebug.outcomes.Text = "Mark LAUNCHED or MISSED after observing the result."
            return
        end
        local landing = latest.landing == nil and "pending"
            or (latest.landing and "verified" or "unverified")
        HitDebug.stats.Text = string.format(
            "Try %d  |  @%s  |  Aim: %s\nObserved: %s  |  local motion: %s\nHRP speed: %.0f -> %.0f  |  peak %.0f  |  change %.0f\nReturn: %s  |  Report: %s",
            latest.try, latest.target, latest.aimed, latest.observed,
            latest.localMotion and "yes" or "no", latest.startSpeed,
            latest.endSpeed, latest.peakSpeed, latest.speedDelta,
            landing, latest.verdict)
        local total, succ, fail, motion = calculate(latest.userId, nil, "aimed")
        local partN, partS, partF = calculate(latest.userId, latest.aimed, "aimed")
        local rateN = succ + fail
        local rateText = rateN > 0 and string.format("%.0f%%", succ / rateN * 100)
            or "n/a"
        local obsN, obsS, obsF = calculate(latest.userId, latest.observed, "observed")
        HitDebug.outcomes.Text = string.format(
            "@%s: %d tries; %d local motion signals\nUser-marked: %d launched / %d missed (%s)\nAim %s: %d tries, %d launched, %d missed\nContact %s: %d tries, %d launched, %d missed",
            latest.target, total, motion, succ, fail, rateText,
            latest.aimed, partN, partS, partF,
            latest.observed, obsN, obsS, obsF)
        if HitDebug.runLog and HitDebug.runLog.Parent then
            local out = {"LIMB RESULTS (this target, user-confirmed only)"}
            local perLimb = {}
            for _, e in ipairs(attempts) do
                if e.userId == latest.userId then
                    local name = e.observed ~= "none" and e.observed or e.aimed
                    local stat = perLimb[name]
                    if not stat then
                        stat = {tries = 0, launched = 0, missed = 0, signals = 0}
                        perLimb[name] = stat
                    end
                    stat.tries = stat.tries + 1
                    if e.verdict == "Launched" then stat.launched = stat.launched + 1 end
                    if e.verdict == "Missed" then stat.missed = stat.missed + 1 end
                    if e.localMotion then stat.signals = stat.signals + 1 end
                end
            end
            local names = {}
            for name in pairs(perLimb) do names[#names + 1] = name end
            table.sort(names)
            for _, name in ipairs(names) do
                local v = perLimb[name]
                out[#out+1] = string.format(
                    "%s: %d attempts | %d launched | %d missed | %d local signals",
                    name, v.tries, v.launched, v.missed, v.signals)
            end
            out[#out+1] = "\nRECENT ATTEMPTS (user confirmation is not server proof)"
            for i, e in ipairs(attempts) do
                if i > 25 then break end
                out[#out+1] = string.format(
                    "#%d @%s try %d | %s -> %s\n  HRP %.0f -> %.0f (peak %.0f, delta %.0f)\n  Local motion: %s | User: %s | Return: %s",
                    i, e.target, e.try, e.aimed, e.observed,
                    e.startSpeed, e.endSpeed, e.peakSpeed, e.speedDelta,
                    e.localMotion and "yes" or "no", e.verdict,
                    e.landing == nil and "pending" or (e.landing and "yes" or "unverified"))
            end
            HitDebug.runLog.Text = table.concat(out, "\n\n")
        end
    end
end

