--====================================
-- PASSIVE CONTACT DIAGNOSTICS (LOCAL OBSERVATIONS ONLY)
--====================================
-- Keep all diagnostic helpers in their own lexical scope so we do not
-- exceed standard Lua's 200-local-variable limit in the outer chunk.
local HitDebug = {}
local Adaptive = {} -- per-player, session-only local-contact rankings
local Telemetry = {} -- diagnostics and user-labelled results; no physics changes
-- Picker state is shared by the adaptive selector and fixed footer UI.
-- Selecting a specific part locks aiming to that part for every attempt.
-- Auto retains the v23.7 per-player adaptive rotation.
local TargetPicker = {
    selected = "LeftUpperArm",
    choices = {
        "LeftUpperArm", "LeftLowerArm", "LeftHand",
        "RightUpperArm", "RightLowerArm", "RightHand",
        "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
        "RightUpperLeg", "RightLowerLeg", "RightFoot",
        "Left Arm", "Right Arm", "Left Leg", "Right Leg",
        "UpperTorso", "LowerTorso", "Torso", "HumanoidRootPart",
        "Auto",
    },
    -- R15 selection works on classic R6 avatars without silently targeting a hat.
    r6Aliases = {
        LeftUpperArm = "Left Arm", LeftLowerArm = "Left Arm", LeftHand = "Left Arm",
        RightUpperArm = "Right Arm", RightLowerArm = "Right Arm", RightHand = "Right Arm",
        LeftUpperLeg = "Left Leg", LeftLowerLeg = "Left Leg", LeftFoot = "Left Leg",
        RightUpperLeg = "Right Leg", RightLowerLeg = "Right Leg", RightFoot = "Right Leg",
        UpperTorso = "Torso", LowerTorso = "Torso",
    },
