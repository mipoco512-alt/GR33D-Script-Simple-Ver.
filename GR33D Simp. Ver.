local function isAimHeld()
    return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
end

local function findNearestInFOV()
    local cam = workspace.CurrentCamera
    if not cam then return nil, nil end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    local best, bestDist = nil, CONFIG.AimFOV

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Me then
            local tc = p.Character
            if tc and tc.Parent then
                local hum = tc:FindFirstChildOfClass("Humanoid")
                local hrp = hum and hum.RootPart
                if hrp and hum.Health > 0 then
                    local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local sp = Vector2.new(screenPos.X, screenPos.Y)
                        local d = (sp - center).Magnitude
                        if d < bestDist then
                            bestDist = d
                            best = hrp
                        end
                    end
                end
            end
        end
    end
    return best, bestDist
end

local function aimTick()
    if not aimActive then currentAimTarget = nil return end
    if not isAimHeld() then currentAimTarget = nil return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local target = findNearestInFOV()
    currentAimTarget = target
    if not target then return end
    local camPos = cam.CFrame.Position
    local desired = CFrame.new(camPos, target.Position)
    if CONFIG.AimSmooth <= 1 then cam.CFrame = desired
    else cam.CFrame = cam.CFrame:Lerp(desired, 1 / CONFIG.AimSmooth) end
end

table.insert(connections, RunService.RenderStepped:Connect(aimTick))

