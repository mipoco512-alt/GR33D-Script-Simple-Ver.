-- Direct-part collector from the supplied script, retaining its straightforward
-- BasePart/Anchored/self filters. Nearby parts are sorted first to avoid filling
-- the safety cap with far objects inside a 3,000-stud query.
scanRingOnce=function()
    if scanBusy or OrbitState==0 or not Gui.Parent then return end
    scanBusy=true
    local ok,err=pcall(function()
        local char=Me.Character
        local root=char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        pcall(function() sethiddenproperty(Me,"SimulationRadius",config.simRadius) end)
        local parts=workspace:GetPartBoundsInRadius(root.Position,config.scanRadius)
        local candidates={}
        local eligible=0
        for _,item in ipairs(parts) do
            if item:IsA("BasePart") and not item.Anchored and not item:IsDescendantOf(char) then
                eligible+=1
                if not itemsInRingLookup[item] then candidates[#candidates+1]=item end
            end
        end
        -- Sorting changes only priority; it does not impose extra eligibility filters.
        table.sort(candidates,function(a,b)
            return (a.Position-root.Position).Magnitude<(b.Position-root.Position).Magnitude
        end)
        local added=0
        for _,item in ipairs(candidates) do
            if added>=config.maxItemsPerLoop or #itemsInRing>=config.maxRingItems then break end
            item.Velocity=Vector3.zero
            itemsInRing[#itemsInRing+1]=item
            itemsInRingLookup[item]=true
            added+=1
        end
        -- Original's invalid-item cleanup. Also re-enable collecting on next ON.
        local cleaned=0
        for i=#itemsInRing,1,-1 do
            if cleaned>15 then break end
            local item=itemsInRing[i]
            if not item or not item.Parent or item.Anchored then
                if item then releaseTrackedPart(item,0) end
                table.remove(itemsInRing,i)
                cleaned+=1
            end
        end
        lastScanSummary={nearSeen=#parts,nearEligible=eligible,added=added,at=os.clock(),error=nil}
    end)
    if not ok then
        lastScanSummary.error=tostring(err)
        lastScanSummary.at=os.clock()
        warn("[GR33D Original Ring scanner] "..tostring(err))
    end
    scanBusy=false
end

task.spawn(function()
    while Gui.Parent do
        if OrbitState~=0 then scanRingOnce() end
        task.wait(OrbitState~=0 and 0.7 or 0.3)
    end
end)

