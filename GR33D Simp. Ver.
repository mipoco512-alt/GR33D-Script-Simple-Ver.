-- Selected-player fling action (never targets the entire server).
-- Attempts may be blocked by server ownership or replication.
-- Never report success based on the local attempt alone.
local function attemptSelectedFling(target)
    local char=Me.Character
    local human=char and char:FindFirstChildOfClass("Humanoid")
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local tr=target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not human or not root or not tr or human.Health<=0 then return false,"Missing character parts" end
    if human.PlatformStand or human.Sit then return false,"Disable Fly / exit vehicle first" end
    local startCF=root.CFrame
    local camera=workspace.CurrentCamera
    local oldSubject=camera and camera.CameraSubject
    local bv=Instance.new("BodyVelocity")
    bv.Name="GR33D_SelectedFlingForce"
    bv.MaxForce=Vector3.new(1e8,1e8,1e8)
    bv.Velocity=Vector3.new(2500,900,2500)
    local success,err=xpcall(function()
        bv.Parent=root
        local start=os.clock()
        local angle=0
        while os.clock()-start<0.85 and not flingStopped and Gui.Parent do
            if Me.Character~=char or not tr.Parent or target.Parent~=Players or human.Health<=0 then break end
            angle += math.rad(60)
            root.CFrame=tr.CFrame*CFrame.new(math.cos(angle)*1.4,0.4,math.sin(angle)*1.4)
            root.AssemblyLinearVelocity=Vector3.new(2100,750,2100)
            root.AssemblyAngularVelocity=Vector3.new(0,85,0)
            RunService.Heartbeat:Wait()
        end
    end,function(e) return tostring(e) end)
    if bv.Parent then bv:Destroy() end
    if Me.Character==char and root.Parent then
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
        root.CFrame=startCF + Vector3.new(0,2,0)
    end
    if camera and oldSubject then pcall(function() camera.CameraSubject=oldSubject end) end
    if not success then return false,err end
    return true,"Attempt completed; target response unverified"
end

