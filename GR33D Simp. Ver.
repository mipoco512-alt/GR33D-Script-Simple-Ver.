local function cmdGoto(player)
    local ch = Me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local myRoot = hum and hum.RootPart
    local _, _, tRoot = getTargetHRP(player)
    if not (ch and myRoot and tRoot) then return false, "Missing parts" end
    local behind = tRoot.CFrame.LookVector * -3
    local target = tRoot.Position + behind + Vector3.new(0, 3, 0)
    pcall(function()
        ch:PivotTo(CFrame.new(target, tRoot.Position))
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
    end)
    return true, "TP'd to " .. player.Name
end

local function cmdFreeze(player)
    local _, _, tRoot = getTargetHRP(player)
    if not tRoot then return false, "No HRP" end
    if originalAnchored[player.Name] == nil then
        originalAnchored[player.Name] = tRoot.Anchored
    end
    tRoot.Anchored = true
    return true, "Froze (anchored) " .. player.Name
end

local function cmdUnfreeze(player)
    local _, _, tRoot = getTargetHRP(player)
    if not tRoot then return false, "No HRP" end
    tRoot.Anchored = originalAnchored[player.Name] or false
    originalAnchored[player.Name] = nil
    local _, tHum = getTargetHRP(player)
    if tHum then
        pcall(function()
            tHum.WalkSpeed    = 16
            tHum.JumpPower    = 50
            tHum.JumpHeight   = 7.2
            tHum.UseJumpPower = true
        end)
    end
    return true, "Unfroze " .. player.Name
end

local function cmdAnchor(player)
    local _, _, tRoot = getTargetHRP(player)
    if not tRoot then return false, "No HRP" end
    if not originalAnchored[player.Name] then
        originalAnchored[player.Name] = tRoot.Anchored
    end
    tRoot.Anchored = true
    return true, "Anchored " .. player.Name
end

local function cmdUnanchor(player)
    local _, _, tRoot = getTargetHRP(player)
    if not tRoot then return false, "No HRP" end
    tRoot.Anchored = originalAnchored[player.Name] or false
    originalAnchored[player.Name] = nil
    return true, "Unanchored " .. player.Name
end

local function cmdBring(player)
    local ch = Me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local myRoot = hum and hum.RootPart
    local _, _, tRoot = getTargetHRP(player)
    if not (ch and myRoot and tRoot) then return false, "Missing parts" end
    local front = myRoot.CFrame.LookVector * 4
    local target = myRoot.Position + front + Vector3.new(0, 3, 0)
    pcall(function()
        tRoot.CFrame = CFrame.new(target)
        tRoot.AssemblyLinearVelocity = Vector3.zero
        tRoot.AssemblyAngularVelocity = Vector3.zero
    end)
    return true, "Brought " .. player.Name
end

local function cmdGrab(player) return cmdBring(player) end

local CMD = {
    ["goto"] = cmdGoto, freeze = cmdFreeze, unfreeze = cmdUnfreeze, thaw = cmdUnfreeze,
    anchor = cmdAnchor, unanchor = cmdUnanchor, bring = cmdBring, grab = cmdGrab,
}

local function runCmd(action, player)
    if not player then setStatus("No target selected", AMBER); return false end
    local fn = CMD[action]
    if not fn then return false end
    local ok, msg = fn(player)
    if ok then setStatus(action .. "  ·  " .. player.Name, GREEN)
    else setStatus(action .. " failed", RED, msg) end
    return ok
end

--====================================
-- GRAB OBJECTS
--====================================
local mouse = Me:GetMouse()

local function releaseGrab()
    if grabbedPart and grabbedPart.Parent then
        pcall(function() grabbedPart.Anchored = grabbedAnchor or false end)
    end
    grabbedPart   = nil
    grabbedAnchor = nil
end

local function tryGrabUnderMouse()
    if not grabActive then return end
    if grabbedPart then releaseGrab(); setStatus("Released grab", MUTED); return end
    local target = mouse.Target
    if not target or not target:IsA("BasePart") then
        setStatus("Nothing under cursor", AMBER); return end
    local ch = Me.Character
    if ch and target:IsDescendantOf(ch) then
        setStatus("Can't grab own character", AMBER); return end
    if target.Anchored then
        setStatus("Part is anchored — can't grab", AMBER); return end
    pcall(function() target:SetNetworkOwner(Me) end)
    grabbedPart   = target
    grabbedAnchor = false
    pcall(function() target.Anchored = true end)
    setStatus("Grabbed: " .. target.Name, GREEN, "Click again to release")
end

table.insert(connections, RunService.RenderStepped:Connect(function()
    if not grabActive or not grabbedPart then return end
    if not grabbedPart.Parent then grabbedPart = nil return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local ray = cam:ScreenPointToRay(mouse.X, mouse.Y)
    local targetPos = ray.Origin + ray.Direction * 15
    pcall(function() grabbedPart.CFrame = CFrame.new(targetPos) end)
end))

table.insert(connections, UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if not grabActive then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        tryGrabUnderMouse()
    end
end))

table.insert(connections, UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Q then
        grabActive = not grabActive
        if not grabActive then releaseGrab() end
        GrabObjectButton.Text = "Grab Obj: " .. (grabActive and "ON" or "OFF")
        GrabObjectButton.BackgroundColor3 = grabActive and GREEN or ROW
    end
end))

--====================================
-- FOLLOW THREAD
--====================================
local function startFollowThread(target)
    if not followEnabled then return end
    followActive = true
    followTarget = target
    task.spawn(function()
        while followActive and selfFlinging and followTarget == target do
            local ch = Me.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local myRoot = hum and hum.RootPart
            local _, _, tRoot = getTargetHRP(target)
            if myRoot and tRoot and myRoot.Parent and tRoot.Parent then
                local delta = tRoot.Position - myRoot.Position
                local dist = delta.Magnitude
                if dist > CONFIG.ApproachDist then
                    local step = math.min(8, dist - (CONFIG.ApproachDist - 2))
                    if step > 0 then
                        local newPos = myRoot.Position + delta.Unit * step
                        pcall(function() ch:PivotTo(CFrame.new(newPos, tRoot.Position)) end)
                    end
                end
            else break end
            task.wait(1 / CONFIG.FollowHz)
        end
        followActive = false
        followTarget = nil
    end)
end

local function stopFollowThread()
    followActive = false
    followTarget = nil
end

--====================================
-- NOCLIP / SPEED
--====================================
local function setNoclip(state)
    if noclipActive == state then return end
    noclipActive = state
    NoclipButton.Text = "Noclip: " .. (state and "ON" or "OFF")
    NoclipButton.BackgroundColor3 = state and GREEN or ROW
    local ch = Me.Character
    if not ch then return end
    if state then
        table.clear(noclipOriginalCollision)
        for _, part in ipairs(ch:GetDescendants()) do
            if part:IsA("BasePart") then
                noclipOriginalCollision[part] = part.CanCollide
                part.CanCollide = false
            end
        end
    else
        for p, original in pairs(noclipOriginalCollision) do
            if p and p.Parent then pcall(function() p.CanCollide = original end) end
        end
        table.clear(noclipOriginalCollision)
    end
end

table.insert(connections, RunService.Stepped:Connect(function()
    if not noclipActive then return end
    local ch = Me.Character
    if not ch then return end
    for _, part in ipairs(ch:GetChildren()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end))

local function setSpeed(state)
    speedActive = state
    SpeedButton.Text = "Speed: " .. (state and "ON" or "OFF")
    SpeedButton.BackgroundColor3 = state and GREEN or ROW
    local ch = Me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if state then
        savedWalkSpeed = hum.WalkSpeed
        hum.WalkSpeed  = (savedWalkSpeed or 16) * CONFIG.SpeedBoost
    else
        hum.WalkSpeed = savedWalkSpeed or 16
        savedWalkSpeed = nil
    end
end

--====================================
-- COMMAND BAR
--====================================
local function runCommand(text)
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then return end
    local cmd, arg = text:match("^(%S+)%s*(.*)$")
    if not cmd then return end
    cmd = cmd:lower()

    if cmd == "/help" or cmd == "/?" then
        setStatus("Commands", MUTED,
            "/hits /testreturn /scan /scanenv /scanall /fling /freeze /unfreeze /anchor /unanchor /bring /grab /goto /aim /noclip /speed")
    elseif cmd == "/hits" then
        if HitDebug.showHits then HitDebug.showHits() end
        setStatus("Hit observations", CYAN, "Local contact evidence is in the Hits tab")
    elseif cmd == "/clearhits" then
        HitDebug.clear()
        setStatus("Hit history cleared", MUTED)
    elseif cmd == "/testreturn" then
        if FlingActive or selfFlinging or returning then
            setStatus("Return test unavailable", AMBER, "Finish the current action first")
            return
        end
        local ch = Me.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if not (ch and root and hum and hum.Health > 0)
            or hum.FloorMaterial == Enum.Material.Air then
            setStatus("Return test: stand on solid ground", AMBER)
            return
        end
        returnSnapshot = nil
        captureReturn(ch, root, hum)
        local landing = findSafeLanding(returnSnapshot)
        if not landing then
            setStatus("Return test FAILED", AMBER,
                "Cannot find unobstructed solid ground near this checkpoint")
            return
        end
        local originallyAnchored = root.Anchored
        root.Anchored = true
        ch:PivotTo(ch:GetPivot() + Vector3.new(0, 5, 0))
        zeroCharacterMotion(ch)
        root.Anchored = originallyAnchored
        task.defer(function()
            local worked = safeReturn()
            if worked then
                returnSnapshot = nil
                setStatus("Return test PASSED", GREEN, "Solid floor and stable landing confirmed")
            else
                setStatus("Return test FAILED", AMBER,
                    "Try from flat unobstructed ground in a private test place")
            end
        end)
    elseif cmd == "/scan" then
        local p = findPlayerByName(arg) or getActiveTarget()
        if p then
            InspectText.Text = scanTargetRig(p)
            InspectOverlay.Visible = true
            setStatus("Rig scan: " .. p.Name, GREEN)
        else
            setStatus("Scan: no target", AMBER)
        end
    elseif cmd == "/scanenv" then
        InspectText.Text = scanEnvironment(tonumber(arg) or 30)
        InspectOverlay.Visible = true
        setStatus("Env scan", GREEN)
    elseif cmd == "/scanall" then
        InspectText.Text = scanAll()
        InspectOverlay.Visible = true
        setStatus("Full scan", GREEN)
    elseif cmd == "/fling" then
        local p = findPlayerByName(arg)
        if p then SelectedTargets[p.Name] = p; currentTarget = p; startFling()
        else setStatus("Target not found", AMBER) end
    elseif cmd == "/aim" then setAimbot(not aimActive)
    elseif cmd == "/freeze" then   runCmd("freeze",   findPlayerByName(arg))
    elseif cmd == "/unfreeze" or cmd == "/thaw" then runCmd("unfreeze", findPlayerByName(arg))
    elseif cmd == "/anchor" then   runCmd("anchor",   findPlayerByName(arg))
    elseif cmd == "/unanchor" then runCmd("unanchor", findPlayerByName(arg))
    elseif cmd == "/bring" then    runCmd("bring",    findPlayerByName(arg))
    elseif cmd == "/grab" then     runCmd("grab",     findPlayerByName(arg))
    elseif cmd == "/goto" then     runCmd("goto",     findPlayerByName(arg))
    elseif cmd == "/noclip" then   setNoclip(not noclipActive)
    elseif cmd == "/speed" then
        local n = tonumber(arg) or 50
        local ch = Me.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = n end
    else setStatus("Unknown: " .. cmd, AMBER) end
end

CmdBar.FocusLost:Connect(function(enterPressed)
    if enterPressed then runCommand(CmdBar.Text); CmdBar.Text = "" end
end)

--====================================
-- FLING CORE
--====================================
local function isTargetReady(player)
    if not player or not player.Parent then return false end
    local ch = player.Character
    if not ch or not ch.Parent then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if not hum.RootPart or not hum.RootPart.Parent then return false end
    if hum.Health <= 0 then return false end
    if hum.Sit then return false end
    return true
end

local TARGET_PART_ORDER = {
    "LeftLowerArm", "LeftUpperArm", "LeftHand", "Left Arm",
}

local function findAnyTargetPart(tChar, tHum, attempt)
    for _, name in ipairs(TARGET_PART_ORDER) do
        local p = tChar:FindFirstChild(name)
        if p and p:IsA("BasePart") and p.Parent == tChar and not p.Anchored then
            return p, p.Name
        end
    end
    return nil, nil
end

local function hardTeleportToTarget(player)
    local ch = Me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local myRoot = hum and hum.RootPart
    local _, _, tRoot = getTargetHRP(player)
    if not (ch and myRoot and tRoot) then return false end
    local offset = tRoot.CFrame.LookVector * 2.5
    local target = tRoot.Position + offset + Vector3.new(0, 2, 0)
    pcall(function()
        ch:PivotTo(CFrame.new(target, tRoot.Position))
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
    end)
    return true
end

local function stunTarget(hum)
    if not hum or not hum.Parent then return end
    pcall(function()
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.JumpHeight = 0
    end)
end

local function preFreezeTarget(player)
    if freezeActive[player.Name] then return end
    freezeActive[player.Name] = true
    freezeThreads[player.Name] = task.spawn(function()
        while freezeActive[player.Name] do
            local _, tHum = getTargetHRP(player)
            if not tHum or not tHum.Parent then
                freezeActive[player.Name] = false
                break
            end
            pcall(function()
                if tHum.WalkSpeed ~= 0 then tHum.WalkSpeed = 0 end
                if tHum.JumpPower ~= 0 then tHum.JumpPower = 0 end
                if tHum.JumpHeight ~= 0 then tHum.JumpHeight = 0 end
            end)
            task.wait()
        end
    end)
end

local function postUnfreezeTarget(player)
    freezeActive[player.Name] = false
    freezeThreads[player.Name] = nil
    task.wait(0.05)
    local _, tHum = getTargetHRP(player)
    if not tHum then return end
    pcall(function()
        tHum.WalkSpeed    = 16
        tHum.JumpPower    = 50
        tHum.JumpHeight   = 7.2
        tHum.UseJumpPower = true
    end)
end

local function predictHRPPosition(targetRoot, tracker)
    local now = os.clock()
    local pos = targetRoot.Position
    local velocity = targetRoot.AssemblyLinearVelocity
    local speed = velocity.Magnitude

    if speed ~= speed or speed > 1e5 then
        velocity = Vector3.zero
        speed = 0
    elseif speed > CONFIG.PredictionMaxSpeed then
        velocity = velocity.Unit * CONFIG.PredictionMaxSpeed
        speed = CONFIG.PredictionMaxSpeed
    end

    local lead = math.min(CONFIG.PredictionSeconds, CONFIG.PredictionMaxSeconds)
    if tracker.lastVelocity and tracker.lastVelocity.Magnitude > 2
        and speed > 2 then
        local dot = tracker.lastVelocity.Unit:Dot(velocity.Unit)
        if dot < CONFIG.PredictionDirectionReset then
            tracker.turnUntil = now + 0.12
        end
    end
    if now < (tracker.turnUntil or 0) then
        lead = lead * 0.35
    end

    if tracker.lastPosition and tracker.lastTime then
        local dt = math.max(now - tracker.lastTime, 0.001)
        local jump = (pos - tracker.lastPosition).Magnitude
        if jump > CONFIG.PredictionMaxSpeed * dt + 4 then
            tracker.discontinuityUntil = now + 0.18
        end
    end
    if now < (tracker.discontinuityUntil or 0) then
        lead = 0
    end

    tracker.lastPosition = pos
    tracker.lastVelocity = velocity
    tracker.lastTime = now

    local displacement = velocity * lead
    if displacement.Magnitude > CONFIG.PredictionMaxStuds then
        displacement = displacement.Unit * CONFIG.PredictionMaxStuds
    end
    displacement = Vector3.new(displacement.X,
        math.clamp(displacement.Y, -1.1, 1.1), displacement.Z)
    return pos + displacement, displacement.Magnitude
end

local function makeTargetOverlapParams(character)
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = {character}
    params.MaxParts = 40
    params.RespectCanCollide = false
    return params
end

local function sampleContact(myRoot, targetCharacter, targetRoot, params, monitor)
    if not monitor or not myRoot.Parent or not targetRoot.Parent then return end
    local now = os.clock()
    if not monitor.lastOverlapQuery
        or now - monitor.lastOverlapQuery >= CONFIG.OverlapCheckInterval then
        monitor.lastOverlapQuery = now
        local ok, hits = pcall(function()
            return workspace:GetPartsInPart(myRoot, params)
        end)
        if ok then
            for _, part in ipairs(hits) do
                if HitDebug.acceptsPart(part, targetCharacter) then
                    monitor.overlap = true
                    monitor.lastOverlapAt = now
                    monitor.overlapSamples = (monitor.overlapSamples or 0) + 1
                    pcall(HitDebug.record, monitor, part, myRoot, "Overlap")
                end
            end
        end
    end

    local velocity = targetRoot.AssemblyLinearVelocity
    local magnitude = velocity.Magnitude
    if magnitude > (monitor.peak or 0) then monitor.peak = magnitude end
    local baseline = monitor.startVelocity or Vector3.zero
    local responseDelta = (velocity - baseline).Magnitude
    monitor.responseDelta = math.max(monitor.responseDelta or 0, responseDelta)
    if monitor.lastOverlapAt
        and now - monitor.lastOverlapAt <= 0.40
        and magnitude >= HRP_BURST.SuccessPeakVel
        and responseDelta >= CONFIG.MinimumResponseDelta then
        if not monitor.hit then
            monitor.hit = true
            pcall(HitDebug.flag, monitor)
        end
    end
end

--====================================
-- SKID FLING — MULTI-PART
--====================================
local function SkidFling(TargetPlayer, forcedPart, monitor)
    local Character = Me.Character
    local Humanoid  = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart  = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer.Character
    if not TCharacter then return false end
    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
    local THead     = TCharacter:FindFirstChild("Head")
    if not (Character and Humanoid and RootPart) then
        setStatus("Character not ready", AMBER)
        return false
    end
    captureReturn(Character, RootPart, Humanoid)
    if THumanoid and THumanoid.Sit then
        setStatus(TargetPlayer.Name .. " is sitting", AMBER)
        returnSnapshot = nil
        return false
    end
    if not TCharacter:FindFirstChildWhichIsA("BasePart") then
        returnSnapshot = nil
        return false
    end

    local targetRoot = THumanoid and THumanoid.RootPart
    local aimPart = forcedPart
    if not (aimPart and aimPart:IsA("BasePart") and aimPart.Parent
            and not aimPart.Anchored) then
        for _, name in ipairs(KICK_PART_ORDER) do
            local candidate = TCharacter:FindFirstChild(name)
            if candidate and candidate:IsA("BasePart") and not candidate.Anchored then
                aimPart = candidate
                break
            end
        end
    end
    if not aimPart then
        setStatus(TargetPlayer.Name .. " no tracking part", AMBER)
        returnSnapshot = nil
        return false
    end

    if monitor then monitor.aimedPartName = aimPart.Name end

    if CONFIG.AutoFreezeTarget and CONFIG.StunTarget and THumanoid then
        stunTarget(THumanoid)
    end

    local savedFPDH = workspace.FallenPartsDestroyHeight
    local savedRootCollide = RootPart.CanCollide
    local savedRootMassless = RootPart.Massless
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)

    local overlapParams = makeTargetOverlapParams(TCharacter)
    local touchConnection
    if RootPart.CanTouch then
        pcall(function()
            touchConnection = RootPart.Touched:Connect(function(part)
            if monitor and HitDebug.acceptsPart(part, TCharacter) then
                monitor.overlap = true
                monitor.lastOverlapAt = os.clock()
                monitor.touchedPartName = hitPartLabel(part, TCharacter)
                pcall(HitDebug.record, monitor, part, RootPart, "Touched")
            end
            end)
        end)
    end
    local tracker = {}
    local movementUpdates = 0
    local function FPos(worldAim, localOffset, ang)
        if not RootPart.Parent or not aimPart.Parent then return end
        pcall(function()
            RootPart.CanCollide = true
            RootPart.Massless = false
        end)
        local kickCF = CFrame.new(worldAim) * CFrame.new(localOffset) * ang
        pcall(function() Character:SetPrimaryPartCFrame(kickCF) end)
        RootPart.CFrame = kickCF
        movementUpdates = movementUpdates + 1
        RootPart.Velocity = Vector3.new(
            CONFIG.KickSpeed, CONFIG.KickYSpeed, CONFIG.KickSpeed)
        RootPart.RotVelocity = Vector3.new(
            CONFIG.KickRot, CONFIG.KickRot, CONFIG.KickRot)
    end

    local SFBasePart = function()
        local started = os.clock()
        local angle = 0
        local offsets = {
            Vector3.new(0,  0.55, 0),
            Vector3.new(0, -0.55, 0),
            Vector3.new(0.55, 0, 0),
            Vector3.new(-0.55, 0, 0),
            Vector3.new(0, 0, 0.55),
            Vector3.new(0, 0, -0.55),
        }

        repeat
            if not FlingActive or not RootPart.Parent
                or not THumanoid or THumanoid.Health <= 0 then break end
            if not aimPart.Parent then break end
            if targetRoot and not targetRoot.Parent then break end

            for offsetIndex, offset in ipairs(offsets) do
                if not FlingActive or not RootPart.Parent or not aimPart.Parent then break end
                local predictionRoot = targetRoot and targetRoot.Parent and targetRoot or aimPart
                local aim, predictedBy = predictHRPPosition(predictionRoot, tracker)
                if aimPart ~= predictionRoot then
                    local limbDelta = aimPart.Position - predictionRoot.Position
                    if limbDelta.Magnitude > 6 then
                        limbDelta = limbDelta.Unit * 6
                    end
                    aim = aim + limbDelta
                end
                if monitor then monitor.lastPredictionStuds = predictedBy end
                angle = (angle + CONFIG.AngleStep) % 360
                FPos(aim, offset, CFrame.Angles(math.rad(angle), 0, 0))
                sampleContact(RootPart, TCharacter, targetRoot or aimPart,
                    overlapParams, monitor)
                if monitor and monitor.hit then return true end
                if offsetIndex % 2 == 0 then
                    task.wait()
                    sampleContact(RootPart, TCharacter, targetRoot or aimPart,
                        overlapParams, monitor)
                    if monitor and monitor.hit then return true end
                end
            end
            task.wait()
        until os.clock() - started >= CONFIG.TimeToWait or not FlingActive
        return false
    end

    selfFlinging = true
    local BV
    local confirmed, attackOK = false, false
    local oldSeated = returnSnapshot and returnSnapshot.seatedEnabled

    hardTeleportToTarget(TargetPlayer)

    local ran, result = xpcall(function()
        BV = Instance.new("BodyVelocity")
        BV.Name = "PlayerOrbitTemporaryForce"
        BV.Velocity = Vector3.zero
        BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BV.Parent = RootPart
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        return SFBasePart()
    end, function(err) return tostring(err) end)

    if ran then
        attackOK, confirmed = true, result == true
    else
        warn("[Fling v23.4m] Character movement failed:", result)
        setStatus("Movement error (see console)", RED, tostring(result):sub(1, 110))
    end
    if movementUpdates == 0 then
        warn("[Fling v23.4m] No character movement updates executed.")
    end

    if touchConnection then touchConnection:Disconnect() end
    if BV then pcall(function() BV:Destroy() end) end
    pcall(function()
        RootPart.CanCollide = savedRootCollide
        RootPart.Massless = savedRootMassless
    end)
    zeroCharacterMotion(Character)
    pcall(function()
        if Humanoid.Parent then
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated,
                oldSeated ~= nil and oldSeated or true)
        end
    end)
    selfFlinging = false
    safeReturn(true)
    pcall(function() workspace.FallenPartsDestroyHeight = savedFPDH end)
    return attackOK, confirmed
end

--====================================
-- BURST WITH ANCHOR CADENCE
--====================================
local function burstFlingTarget(player)
    if not isTargetReady(player) then return false, 0, 0, nil end
    local tc = player.Character
    if not tc then return false, 0, 0, nil end

    if CONFIG.AutoFreezeTarget then preFreezeTarget(player) end

    local bestPeak, attempts = 0, 0
    local anyOverlap, bestResponseDelta = false, 0
    local lastPartName = nil
    local tHum = tc:FindFirstChildOfClass("Humanoid")

    for i = 1, HRP_BURST.MaxAttempts do
        if not FlingActive then break end
        if not isTargetReady(player) then break end

        local candidate, candidateName = findAnyTargetPart(tc, tHum, i)
        if not candidate then
            setStatus("Left arm unavailable", AMBER,
                "R6 Left Arm or R15 left-arm parts missing/anchored")
            break
        end

        local _, _, tRoot = getTargetHRP(player)
        if CONFIG.AutoFreezeTarget and tRoot then
            local wasAnchored = tRoot.Anchored
            pcall(function() tRoot.Anchored = true end)
            task.wait(CONFIG.AnchorHold)
            pcall(function() tRoot.Anchored = wasAnchored end)
        end

        hardTeleportToTarget(player)
        if not FlingActive then break end

        attempts = attempts + 1
        local tRootVelocity = tRoot and tRoot.AssemblyLinearVelocity or Vector3.zero
        local monitor = { peak = 0, hit = false, overlap = false,
            targetName = player.Name, targetCharacter = tc, attempt = attempts,
            aimedPartName = candidateName,
            overlapSamples = 0, startVelocity = tRootVelocity, responseDelta = 0 }
        SkidFling(player, candidate, monitor)
        if monitor.contactPartName or monitor.overlapPart then
            lastPartName = monitor.contactPartName or monitor.overlapPart
        end

        if monitor.peak > bestPeak then bestPeak = monitor.peak end
        anyOverlap = anyOverlap or monitor.overlap
        bestResponseDelta = math.max(bestResponseDelta, monitor.responseDelta)

        if monitor.hit then
            local ch = Me.Character
            local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
            local holdAnchored = myRoot and myRoot.Anchored or false

            if myRoot then
                pcall(function()
                    myRoot.Anchored = true
                    myRoot.AssemblyLinearVelocity  = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                end)
            end

            setStatus(string.format("@%s overlap + motion (%s)",
                player.Name, tostring(monitor.contactPartName or monitor.overlapPart or "unknown")), GREEN,
                "See Hits tab for approximate location and evidence")

            local holdStart = tick()
            while tick() - holdStart < CONFIG.HoldAfterHit do
                if not FlingActive then break end
                if myRoot and myRoot.Parent then
                    pcall(function()
                        myRoot.AssemblyLinearVelocity  = Vector3.zero
                        myRoot.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
                task.wait(0.05)
            end

            if myRoot and myRoot.Parent then
                pcall(function() myRoot.Anchored = holdAnchored end)
            end

            if CONFIG.AutoFreezeTarget then postUnfreezeTarget(player) end
            return true, bestPeak, attempts, lastPartName,
                anyOverlap, bestResponseDelta
        end

        if CONFIG.AutoFreezeTarget then preFreezeTarget(player) end
        if monitor.overlap then
            setStatus(string.format("@%s overlap observed, no velocity response", player.Name),
                AMBER, "Local overlap: " .. tostring(monitor.overlapPart or "unknown"))
        end
        task.wait(HRP_BURST.DelayBetween)
    end

    if CONFIG.AutoFreezeTarget then postUnfreezeTarget(player) end
    return false, bestPeak, attempts, lastPartName,
        anyOverlap, bestResponseDelta
end

--====================================
-- START / STOP
--====================================
local function activeTargets()
    local list = {}
    for _, p in pairs(SelectedTargets) do
        if p and p.Parent == Players then
            table.insert(list, p)
        else
            SelectedTargets[p.Name] = nil
        end
    end
    return list
end

local function startFlingInternal(todo)
    FlingActive = true
    task.spawn(function()
        local ch = Me.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if ch and root and hum then captureReturn(ch, root, hum) end

        for i, player in ipairs(todo) do
            if not FlingActive then break end
            currentTarget = player
            setStatus(string.format("Flinging @%s (%d/%d)", player.Name, i, #todo),
                      WHITE, "Freeze + anchor + multi-part kick")

            stopFollowThread()

            local ok, peak, tries, pn, overlap, delta = burstFlingTarget(player)
            if ok then
                setStatus(string.format("@%s local contact + motion (%s)",
                    player.Name, tostring(pn or "unidentified")), GREEN,
                    string.format("HRP peak %.0f | change %.0f | %d attempts (Hits tab)",
                        peak, delta or 0, tries))
            elseif overlap then
                setStatus(string.format("@%s overlap, no verified response", player.Name),
                    AMBER, string.format("HRP peak %.0f | change %.0f | %d attempts",
                        peak, delta or 0, tries))
            else
                setStatus(string.format("@%s no overlap (%d attempts)",
                    player.Name, tries), AMBER,
                    string.format("Best HRP speed %.0f studs/s", peak))
            end
            task.wait(CONFIG.Cooldown)

            local landed = safeReturn()
            if not landed then
                setStatus("Return needs attention", AMBER,
                    "No verified stable landing; use RESCUE at a clear location")
            end
        end

        FlingActive = false
        currentTarget = nil
        local recovered = safeReturn()
        if recovered then
            returnSnapshot = nil
            setStatus("Done — safely landed", GREEN, "Landing verified • contact details in Hits tab")
        else
            setStatus("Completed — landing unverified", AMBER,
                "Use RESCUE when a safe checkpoint is available")
        end
    end)
end

startFling = function()
    if FlingActive then return end
    local todo = activeTargets()
    if #todo == 0 then
        setStatus("No targets selected", AMBER)
        return
    end
    startFlingInternal(todo)
end

local function stopFling()
    FlingActive = false
    stopFollowThread()
    if not selfFlinging then safeReturn() end
    setStatus("Stopped", MUTED)
end

--====================================
-- PLAYER LIST
--====================================
local function refreshPlayers()
    for _, r in pairs(rows) do r:Destroy() end
    table.clear(rows)
    local all = Players:GetPlayers()
    table.sort(all, function(a, b) return a.Name:lower() < b.Name:lower() end)
    local q = Search.Text:lower()
    local shown = 0
    for _, player in ipairs(all) do
        if player ~= Me
           and (player.Name:lower():find(q, 1, true)
                or player.DisplayName:lower():find(q, 1, true)) then
            shown = shown + 1
            local Row = make("TextButton", {
                Size = UDim2.new(1, -18, 0, 56), LayoutOrder = shown,
                BackgroundColor3 = SelectedTargets[player.Name]
                    and Color3.fromRGB(58, 78, 110) or ROW,
                BorderSizePixel = 0,
                AutoButtonColor = false, Text = "",
            }, List)
            round(Row, 10)
            Row.MouseEnter:Connect(function()
                if not SelectedTargets[player.Name] then Row.BackgroundColor3 = ROWHI end
            end)
            Row.MouseLeave:Connect(function()
                if not SelectedTargets[player.Name] then Row.BackgroundColor3 = ROW end
            end)

            local pic = make("ImageLabel", {
                Position = UDim2.fromOffset(36, 6),
                Size = UDim2.fromOffset(40, 40),
                BackgroundColor3 = PANEL, Image = "",
            }, Row)
            round(pic, 20)

            local check = make("Frame", {
                Position = UDim2.fromOffset(8, 15),
                Size = UDim2.fromOffset(22, 22),
                BackgroundColor3 = Color3.fromRGB(60, 70, 95),
                BorderSizePixel = 0,
            }, Row)
            round(check, 6)
            make("UIStroke", { Color = Color3.fromRGB(80, 92, 118), Thickness = 1 }, check)

            local mark = make("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1, Text = "✓",
                TextColor3 = Color3.fromRGB(60, 230, 130),
                Font = Enum.Font.GothamBold, TextSize = 16,
                Visible = SelectedTargets[player.Name] ~= nil,
            }, check)

            local dl = label(player.DisplayName, 14,
                UDim2.fromOffset(84, 6), UDim2.new(1, -92, 0, 22), Row)
            dl.Font = Enum.Font.GothamBold
            local ul = label("@"..player.Name, 11,
                UDim2.fromOffset(84, 28), UDim2.new(1, -92, 0, 18), Row)
            ul.TextColor3 = MUTED

            loadAvatar(player, pic, Enum.ThumbnailSize.Size100x100)

            Row.MouseButton1Click:Connect(function()
                if SelectedTargets[player.Name] then
                    SelectedTargets[player.Name] = nil
                    mark.Visible = false
                    Row.BackgroundColor3 = ROW
                    if currentTarget == player then currentTarget = nil end
                else
                    SelectedTargets[player.Name] = player
                    mark.Visible = true
                    Row.BackgroundColor3 = Color3.fromRGB(58, 78, 110)
                    currentTarget = player
                end
                local selectedCount = #activeTargets()
                Count.Text = string.format("%d online · %d shown · %d selected",
                    #Players:GetPlayers(), shown, selectedCount)
                setStatus(string.format("%d selected · target: %s",
                    selectedCount, currentTarget and currentTarget.Name or "none"), MUTED)
            end)
            rows[player] = Row
        end
    end
    Count.Text = string.format("%d online · %d shown · %d selected",
        #all, shown, #activeTargets())
end

