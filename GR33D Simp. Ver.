-- DAMAGE GUARD
function FlingFunctions.isGuardActive() return true end
function FlingFunctions.startDamageGuard()
    local ch = Me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not ch or not hum then return end
    pcall(function()
        if guardFF and guardFF.Parent then guardFF:Destroy() end
        guardFF = Instance.new("ForceField")
        guardFF.Name = "FlingDamageGuard_FF"
        guardFF.Visible = false
        guardFF.Parent = ch
    end)
    if not guardVelConn then
        guardVelConn = RunService.Stepped:Connect(function()
            local c2 = Me.Character
            local root = c2 and c2:FindFirstChild("HumanoidRootPart")
            local h2 = c2 and c2:FindFirstChildOfClass("Humanoid")
            if not root or not h2 or h2.Health <= 0 then
                if guardAnchoredSelf and root and root.Parent then
                    pcall(function() root.Anchored = false end)
                    guardAnchoredSelf = false
                end
                return
            end
            if returning or selfFlinging then return end
            pcall(function()
                local v = root.AssemblyLinearVelocity
                if v.Magnitude > CONFIG.GuardVelCap then
                    local capped = v.Unit * CONFIG.GuardVelCap
                    root.AssemblyLinearVelocity  = capped
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.Velocity    = capped
                    root.RotVelocity = Vector3.zero
                end
            end)
            pcall(function()
                h2.PlatformStand = false
                local st = h2:GetState()
                if st == Enum.HumanoidStateType.Ragdoll
                   or st == Enum.HumanoidStateType.Physics
                   or st == Enum.HumanoidStateType.FallingDown
                   or st == Enum.HumanoidStateType.PlatformStanding then
                    h2:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end)
    end
    if guardHealthConn then pcall(function() guardHealthConn:Disconnect() end) end
    guardHealthConn = hum.HealthChanged:Connect(function(newH)
        if not FlingFunctions.isGuardActive() then return end
        local c2 = Me.Character
        local h2 = c2 and c2:FindFirstChildOfClass("Humanoid")
        if h2 and h2.Parent and newH < h2.MaxHealth then
            pcall(function()
                h2.Health = h2.MaxHealth
                if h2.Health <= 0 then
                    h2.Health = h2.MaxHealth
                    h2:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end
    end)
end
function FlingFunctions.stopDamageGuard()
    if guardVelConn then guardVelConn:Disconnect(); guardVelConn = nil end
    if guardHealthConn then guardHealthConn:Disconnect(); guardHealthConn = nil end
    pcall(function()
        if guardFF and guardFF.Parent then guardFF:Destroy() end
        guardFF = nil
    end)
    if guardAnchoredSelf then
        local ch = Me.Character
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        if root and root.Parent then pcall(function() root.Anchored = false end) end
        guardAnchoredSelf = false
    end
end

-- SAFE RETURN
function FlingFunctions.zeroCharacterMotion(ch)
    if not ch then return end
    for _, part in ipairs(ch:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
                part.Velocity = Vector3.zero
                part.RotVelocity = Vector3.zero
            end)
        end
    end
end
function FlingFunctions.captureReturn(ch, root, hum)
    if returnSnapshot and returnSnapshot.character == ch
        and os.clock() - returnSnapshot.time < 180 then return end
    local pivot = ch:GetPivot()
    if lastGrounded and lastGrounded.character == ch
        and os.clock() - lastGrounded.time <= 20 then
        pivot = lastGrounded.pivot
    end
    local seated = true
    pcall(function() seated = hum:GetStateEnabled(Enum.HumanoidStateType.Seated) end)
    returnSnapshot = {character=ch, root=root, humanoid=hum, pivot=pivot,
        rootAnchored=root.Anchored, seatedEnabled=seated, time=os.clock()}
    lastSafeReturn = returnSnapshot
end
function FlingFunctions.recoveryCheckpoint()
    local ch = Me.Character
    if not ch then return nil end
    local root = ch:FindFirstChild("HumanoidRootPart")
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not (root and hum and root.Parent and hum.Health > 0) then return nil end
    if returnSnapshot and returnSnapshot.character == ch then return returnSnapshot end
    if lastSafeReturn and lastSafeReturn.character == ch
        and os.clock() - lastSafeReturn.time <= 45 then return lastSafeReturn end
    if lastGrounded and lastGrounded.character == ch
        and os.clock() - lastGrounded.time <= 45 then
        local seated = true
        pcall(function() seated = hum:GetStateEnabled(Enum.HumanoidStateType.Seated) end)
        return {character=ch, root=root, humanoid=hum, pivot=lastGrounded.pivot,
            rootAnchored=false, seatedEnabled=seated, time=lastGrounded.time}
    end
    return nil
end
function FlingFunctions.clearOurBodyForce(root)
    if root and root.Parent then
        local f = root:FindFirstChild("PlayerOrbitTemporaryForce")
        if f and f:IsA("BodyVelocity") then f:Destroy() end
    end
end
function FlingFunctions.isBadLandingHit(result)
    if not result or result.Normal.Y < CONFIG.LandingMaxSlope then return true end
    if result.Material == Enum.Material.Water or result.Material == Enum.Material.CrackedLava then return true end
    local part = result.Instance
    if not part then return true end
    local nm = part.Name:lower() .. " " .. (part.Parent and part.Parent.Name:lower() or "")
    for _, w in ipairs({"lava","kill","damage","hazard","acid","void","nuke"}) do
        if nm:find(w, 1, true) then return true end
    end
    if part:GetAttribute("Hazard") == true or part:GetAttribute("Kill") == true
        or CollectionService:HasTag(part, "Hazard")
        or CollectionService:HasTag(part, "KillBrick") then return true end
    return false
end
local LANDING_OFFSETS = {
    Vector3.new(0,0,0), Vector3.new(3,0,0), Vector3.new(-3,0,0),
    Vector3.new(0,0,3), Vector3.new(0,0,-3), Vector3.new(6,0,0),
    Vector3.new(-6,0,0), Vector3.new(0,0,6), Vector3.new(0,0,-6),
    Vector3.new(6,0,6), Vector3.new(-6,0,6), Vector3.new(6,0,-6),
    Vector3.new(-6,0,-6), Vector3.new(9,0,0), Vector3.new(-9,0,0),
}
function FlingFunctions.findSafeLanding(saved)
    local ch, root, hum = saved.character, saved.root, saved.humanoid
    local base = saved.pivot.Position
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {ch}
    rp.IgnoreWater = true
    rp.RespectCanCollide = true
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {ch}
    op.RespectCanCollide = true
    op.MaxParts = 64
    local look = saved.pivot.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0,0,-1) end
    flatLook = flatLook.Unit
    local clr = math.max(3.5, hum.HipHeight + root.Size.Y * 0.5 + CONFIG.LandingClearance)
    for _, off in ipairs(LANDING_OFFSETS) do
        if off.Magnitude <= CONFIG.LandingRadius then
            local spot = base + off
            local res = workspace:Raycast(spot + Vector3.new(0,9,0), Vector3.new(0,-85,0), rp)
            if res and not FlingFunctions.isBadLandingHit(res)
                and res.Position.Y <= base.Y + 2.5
                and res.Position.Y >= base.Y - 23 then
                local p = Vector3.new(spot.X, res.Position.Y + clr, spot.Z)
                local sz = Vector3.new(3.2, 4, 3.2)
                local obs = workspace:GetPartBoundsInBox(CFrame.new(p + Vector3.new(0,0.4,0)), sz, op)
                local blocked = false
                for _, part in ipairs(obs) do
                    if part:IsA("BasePart") and part.CanCollide then blocked = true; break end
                end
                if not blocked then return CFrame.lookAt(p, p + flatLook) end
            end
        end
    end
    return nil
end
function FlingFunctions.restoreNoclipForLanding(ch)
    if not noclipActive then return end
    noclipActive = false
    for p, orig in pairs(noclipOriginalCollision) do
        if p and p.Parent and p:IsDescendantOf(ch) then
            pcall(function() p.CanCollide = orig end)
        end
    end
    table.clear(noclipOriginalCollision)
    NoclipButton.Text = "Noclip: OFF"
    NoclipButton.BackgroundColor3 = ROW
end
function FlingFunctions.safeReturn(quick)
    if returning or selfFlinging then return false end
    local saved = FlingFunctions.recoveryCheckpoint()
    if not saved then return false end
    local ch, root, hum = saved.character, saved.root, saved.humanoid
    if Me.Character ~= ch or not ch.Parent or not root.Parent
        or not hum.Parent or hum.Health <= 0 then return false end
    local landing = FlingFunctions.findSafeLanding(saved)
    if not landing then
        landing = saved.pivot + Vector3.new(0, 1, 0)
    end
    returning = true
    local success = false
    local origAnchor = saved.rootAnchored
    local ok, err = xpcall(function()
        FlingFunctions.restoreNoclipForLanding(ch)
        FlingFunctions.clearOurBodyForce(root)
        root.Anchored = true
        FlingFunctions.zeroCharacterMotion(ch)
        hum.Sit = false
        hum.PlatformStand = false
        ch:PivotTo(landing)
        local holdF = quick and 2 or 4
        local settleF = quick and 4 or CONFIG.LandingSettleFrames
        for _ = 1, holdF do
            if Me.Character ~= ch or not ch.Parent or hum.Health <= 0 then return end
            FlingFunctions.zeroCharacterMotion(ch)
            RunService.Heartbeat:Wait()
        end
        root.Anchored = origAnchor
        if not origAnchor then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        local stable = 0
        for _ = 1, settleF do
            if Me.Character ~= ch or not root.Parent or hum.Health <= 0 then break end
            local drift = (root.Position - landing.Position).Magnitude
            local vy = root.AssemblyLinearVelocity.Y
            if drift <= 6 and vy > -22 then stable = stable + 1
            else
                root.Anchored = true
                FlingFunctions.zeroCharacterMotion(ch)
                ch:PivotTo(landing)
                RunService.Heartbeat:Wait()
                root.Anchored = origAnchor
                stable = 0
            end
            RunService.Heartbeat:Wait()
        end
        success = stable >= math.ceil(settleF / 2) and hum.Health > 0
    end, function(e) return tostring(e) end)
    if not ok then warn("[SafeReturn] " .. tostring(err)) end
    pcall(function()
        if root and root.Parent then
            root.Anchored = origAnchor
            FlingFunctions.clearOurBodyForce(root)
        end
        if hum and hum.Parent then
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, saved.seatedEnabled)
            hum.PlatformStand = false
            if hum.Health > 0 and not origAnchor then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
        local cam = workspace.CurrentCamera
        if cam and Me.Character == ch and hum.Parent then cam.CameraSubject = hum end
    end)
    returning = false
    return success
end

