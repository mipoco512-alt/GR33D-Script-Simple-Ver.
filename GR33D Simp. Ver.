    if guardHealthConn then pcall(function() guardHealthConn:Disconnect() end) end
    guardHealthConn = hum.HealthChanged:Connect(function(newH)
        if not isGuardActive() then return end
        local c2 = Me.Character
        local h2 = c2 and c2:FindFirstChildOfClass("Humanoid")
