local function resetOrbitMeasurement()
    table.clear(orbitSamples)
    ringMovingParts = 0
    ringDisplacingParts = 0
    ringControllers = 0
    table.clear(ringObservedPositions)
    ringMovingStreak = 0
    ringMovingTarget = nil
end

-- This changes local physics controllers only; server-owned parts may ignore it.
local function releaseTrackedPart(part, retrySeconds)
    if not part then return end
    local state = candidateState[part]
    if part.Parent then
        local controller = part:FindFirstChild("OrbitBP")
        if controller then controller:Destroy() end
        if state and state.canCollide ~= nil then
            pcall(function() part.CanCollide=state.canCollide end)
        end
    end
    itemsInRingLookup[part] = nil
    orbitSamples[part] = nil
    ringObservedPositions[part] = nil
    candidateState[part] = nil
    if retrySeconds and retrySeconds > 0 then
        retryAfter[part] = os.clock() + retrySeconds
    end
end

local function releaseRing()
    for _, part in ipairs(itemsInRing) do
        releaseTrackedPart(part, 0)
    end
    table.clear(itemsInRing)
    table.clear(itemsInRingLookup)
    table.clear(retryAfter) -- CRITICAL: pressing OFF/ON must not preserve stale retry bans
    resetOrbitMeasurement()
end

-- Keep character collision changes reversible when the Ring turns off.
local characterCollisionOriginal=setmetatable({}, {__mode="k"})
local function restoreCharacterCollision()
    for part, original in pairs(characterCollisionOriginal) do
        if part and part.Parent then
            pcall(function() part.CanCollide=original end)
        end
        characterCollisionOriginal[part]=nil
    end
end

local function insideCharacter(part)
    local parent = part.Parent
    while parent and parent ~= workspace do
        if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then
            return true
        end
        parent = parent.Parent
    end
    return false
end

-- A part can be unanchored but still welded into an anchored assembly.
-- Exclude player/NPC bodies, tool/accessory handles, and anchored roots to
-- reserve a small active physics budget for genuinely loose candidates.
local function likelyLoosePart(part, character)
    if not part or not part.Parent or not part:IsA("BasePart")
        or part.Anchored or part:IsDescendantOf(character)
        or insideCharacter(part) then return false end
    if part:FindFirstAncestorWhichIsA("Accessory")
        or part:FindFirstAncestorWhichIsA("Tool") then return false end
    local ok, assembly = pcall(function() return part.AssemblyRootPart end)
    if ok and assembly and assembly.Anchored then return false end
    return true
end

