    StatusPanel.Position = UDim2.fromOffset(0, targetH + 4)
    StatusPanel.Size = UDim2.new(1, 0, 0, statusH)
    Status.Position = UDim2.fromOffset(10, short and 2 or 8)
    Status.Size = UDim2.new(1, -20, 0, 18)
    StatusSub.Visible = not short
    FlingButton.Position = UDim2.fromOffset(0, btnY)
    FlingButton.Size = UDim2.new(0.5, -6, 0, btnH)
    Stop.Position = UDim2.new(0.5, 6, 0, btnY)
    Stop.Size = UDim2.new(0.5, -6, 0, btnH)
end

