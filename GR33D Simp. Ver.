local PROTECTED_USERS = { [9321819967] = true }
local PROTECTED_NAMES = {}
local function isProtectedPlayer(player)
    if not player then return false end
    if PROTECTED_USERS[player.UserId] == true then return true end
    if PROTECTED_NAMES[player.Name:lower()] == true then return true end
    return false
end

