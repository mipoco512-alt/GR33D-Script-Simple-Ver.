-- COMMAND BAR
function FlingFunctions.runCommand(text)
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then return end
    local cmd, arg = text:match("^(%S+)%s*(.*)$")
    if not cmd then return end
    cmd = cmd:lower()
    if cmd == "/help" or cmd == "/?" then
        FlingFunctions.setStatus("Commands", MUTED,
            "/hits /testreturn /scan /scanenv /scanall /fling /freeze /unfreeze /anchor /unanchor /bring /grab /goto /aim /noclip /speed /type /target")
    elseif cmd == "/type" then
        currentFlingType = (currentFlingType == "original") and "alt" or "original"
        FlingTypeButton.Text = "Type: " .. FlingFunctions.getCurrentFlingLabel() .. "  ▼"
        for id, btn in pairs(ftButtons) do
            btn.BackgroundColor3 = (id == currentFlingType) and ACCENTD or ROW
        end
        FlingFunctions.setStatus("Fling type: " .. FlingFunctions.getCurrentFlingLabel(), CYAN)
    elseif cmd == "/target" then
        currentAimTarget = (currentAimTarget == "arm") and "hrp" or "arm"
        TargetButton.Text = "Target: " .. FlingFunctions.getCurrentTargetLabel() .. "  ▼"
        for id, btn in pairs(tgButtons) do
            btn.BackgroundColor3 = (id == currentAimTarget) and ACCENTD or ROW
        end
        FlingFunctions.setStatus("Target: " .. FlingFunctions.getCurrentTargetLabel(), CYAN)
    elseif cmd == "/hits" then
        if HitDebug.showHits then HitDebug.showHits() end
        FlingFunctions.setStatus("Hit observations", CYAN)
    elseif cmd == "/clearhits" then HitDebug.clear(); FlingFunctions.setStatus("Cleared", MUTED)
    elseif cmd == "/testreturn" then
        if FlingActive or selfFlinging or returning then FlingFunctions.setStatus("Busy", AMBER); return end
        local ch = Me.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if not (ch and root and hum and hum.Health > 0)
            or hum.FloorMaterial == Enum.Material.Air then
            FlingFunctions.setStatus("Stand on solid ground", AMBER); return
        end
        returnSnapshot = nil
        FlingFunctions.captureReturn(ch, root, hum)
        local landing = FlingFunctions.findSafeLanding(returnSnapshot)
        if not landing then FlingFunctions.setStatus("Return test FAILED", AMBER); return end
        local origA = root.Anchored
        root.Anchored = true
        ch:PivotTo(ch:GetPivot() + Vector3.new(0,5,0))
        FlingFunctions.zeroCharacterMotion(ch)
        root.Anchored = origA
        task.defer(function()
            if FlingFunctions.safeReturn() then
                returnSnapshot = nil
                FlingFunctions.setStatus("Return PASSED", GREEN)
            else FlingFunctions.setStatus("Return FAILED", AMBER) end
        end)
    elseif cmd == "/scan" then
        local p = FlingFunctions.findPlayerByName(arg) or FlingFunctions.getActiveTarget()
        if p then
            InspectText.Text = FlingFunctions.scanTargetRig(p)
            InspectOverlay.Visible = true
            FlingFunctions.setStatus("Rig scan: " .. p.Name, GREEN)
        else FlingFunctions.setStatus("Scan: no target", AMBER) end
    elseif cmd == "/scanenv" then
        InspectText.Text = FlingFunctions.scanEnvironment(tonumber(arg) or 30)
        InspectOverlay.Visible = true
        FlingFunctions.setStatus("Env scan", GREEN)
    elseif cmd == "/scanall" then
        InspectText.Text = FlingFunctions.scanAll()
        InspectOverlay.Visible = true
        FlingFunctions.setStatus("Full scan", GREEN)
    elseif cmd == "/fling" then
        local p = FlingFunctions.findPlayerByName(arg)
        if p then SelectedTargets[p.Name] = p; currentTarget = p; startFling()
        else FlingFunctions.setStatus("Target not found", AMBER) end
    elseif cmd == "/aim" then FlingFunctions.setAimbot(not aimActive)
    elseif cmd == "/freeze" then FlingFunctions.runCmd("freeze", FlingFunctions.findPlayerByName(arg))
    elseif cmd == "/unfreeze" or cmd == "/thaw" then FlingFunctions.runCmd("unfreeze", FlingFunctions.findPlayerByName(arg))
    elseif cmd == "/anchor" then FlingFunctions.runCmd("anchor", FlingFunctions.findPlayerByName(arg))
    elseif cmd == "/unanchor" then FlingFunctions.runCmd("unanchor", FlingFunctions.findPlayerByName(arg))
    elseif cmd == "/bring" then FlingFunctions.runCmd("bring", FlingFunctions.findPlayerByName(arg))
    elseif cmd == "/grab" then FlingFunctions.runCmd("grab", FlingFunctions.findPlayerByName(arg))
    elseif cmd == "/goto" then FlingFunctions.runCmd("goto", FlingFunctions.findPlayerByName(arg))
    elseif cmd == "/noclip" then FlingFunctions.setNoclip(not noclipActive)
    elseif cmd == "/speed" then
        local n = tonumber(arg) or 50
        local ch = Me.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = n end
    else FlingFunctions.setStatus("Unknown: " .. cmd, AMBER) end
end
