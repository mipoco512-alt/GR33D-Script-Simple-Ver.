-- HIT DEBUG
local HitDebug = {}
do
local hitObservations = {}
local HIT_LOG_LIMIT = 32
HitDebug.focus = "LeftArm"
local LIMB_FAMILIES = {LeftUpperArm="Arms",RightUpperArm="Arms",LeftLowerArm="Arms",
    RightLowerArm="Arms",LeftHand="Arms",RightHand="Arms",LeftUpperLeg="Legs",
    RightUpperLeg="Legs",LeftLowerLeg="Legs",RightLowerLeg="Legs",LeftFoot="Legs",
    RightFoot="Legs",["Left Arm"]="Arms",["Right Arm"]="Arms",
    ["Left Leg"]="Legs",["Right Leg"]="Legs"}
HitDebug.partFamily = function(part, character)
    if not part or not character or part.Parent ~= character then return nil end
    if not part:IsA("BasePart") then return nil end
    return LIMB_FAMILIES[part.Name]
end
HitDebug.acceptsPart = function(part, character)
    local family = HitDebug.partFamily(part, character)
    return family ~= nil and (HitDebug.focus == "Both" or family == HitDebug.focus)
end
local function hitVec(v) return string.format("(%.1f, %.1f, %.1f)", v.X, v.Y, v.Z) end
local function hitEvidence(record)
    local e = {}
    if record.touched then table.insert(e,"Touched") end
    if record.overlap then table.insert(e,"overlap") end
    if record.response then table.insert(e,"motion") end
    return #e > 0 and table.concat(e, " + ") or "unverified"
end
local function renderHitInfo()
    if not HitDebug.summary or not HitDebug.summary.Parent then return end
    local newest = hitObservations[1]
    if not newest then
        HitDebug.summary.Text = "No contact observed"
        HitDebug.details.Text = "Filter: " .. HitDebug.focus
        HitDebug.log.Text = "Recent observations appear here."
        return
    end
    HitDebug.summary.Text = string.format("@%s  •  %s  •  %s", newest.target, newest.partName, newest.zone)
    HitDebug.details.Text = string.format("Aimed: %s\nPoint: %s\nEvidence: %s",
        newest.aimedPart or "?", hitVec(newest.point), hitEvidence(newest))
    local lines = {}
    for i, event in ipairs(hitObservations) do
        lines[#lines + 1] = string.format("%02d @%s [try %s] Aim=%s Observed=%s | %s",
            i, event.target, tostring(event.attempt), event.aimedPart or "?",
            event.partName, event.zone)
    end
    HitDebug.log.Text = table.concat(lines, "\n")
end
local hitRenderQueued = false
local function queueHitRender()
    if hitRenderQueued then return end
    hitRenderQueued = true
    task.defer(function() hitRenderQueued = false; renderHitInfo() end)
end
local function clearHitInfo() table.clear(hitObservations); renderHitInfo() end
local function approximateHitZone(part, myRoot)
    local approx = part.Position
    pcall(function() approx = part:GetClosestPointOnSurface(myRoot.Position) end)
    local lp = part.CFrame:PointToObjectSpace(approx)
    local sx, sy, sz = math.max(part.Size.X*0.5,0.01), math.max(part.Size.Y*0.5,0.01), math.max(part.Size.Z*0.5,0.01)
    local h = "center"
    local x, z = lp.X/sx, lp.Z/sz
    if math.abs(x) > math.abs(z) and math.abs(x) > 0.35 then h = x > 0 and "right" or "left"
    elseif math.abs(z) > 0.35 then h = z < 0 and "front" or "back" end
    local y = lp.Y/sy
    local v = y > 0.35 and "upper" or (y < -0.35 and "lower" or "middle")
    return v .. " / " .. h, approx
end
local function hitPartLabel(part, character)
    local anc = part.Parent
    if anc and anc ~= character and anc:IsA("Accessory") then return anc.Name.."."..part.Name end
    return part.Name
end
local function recordHitObservation(monitor, part, myRoot, kind)
    if not monitor or not myRoot or not HitDebug.acceptsPart(part, monitor.targetCharacter) then return nil end
    local now = os.clock()
    monitor.hitRecords = monitor.hitRecords or {}
    local record = monitor.hitRecords[part]
    local changed = false
    if not record then
        local zone, point = approximateHitZone(part, myRoot)
        record = {target=monitor.targetName or "?", partName=hitPartLabel(part, monitor.targetCharacter),
            aimedPart=monitor.aimedPartName or "?", zone=zone, point=point,
            attempt=monitor.attempt or "?", overlap=false, touched=false, response=false,
            timestamp=now}
        monitor.hitRecords[part] = record
        table.insert(hitObservations, 1, record)
        if #hitObservations > HIT_LOG_LIMIT then table.remove(hitObservations) end
        changed = true
    end
    if kind == "Touched" and not record.touched then
        record.touched = true; monitor.lastTouchedRecord = record; monitor.lastTouchedAt = now; changed = true
    elseif kind == "Overlap" and not record.overlap then record.overlap = true; changed = true end
    record.timestamp = now
    monitor.lastObservedRecord = record
    monitor.overlapPart = record.partName
    if changed then queueHitRender() end
    return record
end
local function flagMotionResponse(monitor)
    local now = os.clock()
    local pref = nil
    if monitor.lastTouchedAt and now - monitor.lastTouchedAt <= 0.4 then pref = monitor.lastTouchedRecord end
    if not pref and monitor.lastObservedRecord and now - monitor.lastObservedRecord.timestamp <= 0.4 then
        pref = monitor.lastObservedRecord
    end
    if pref and not pref.response then
        pref.response = true; pref.timestamp = now
        for i, r in ipairs(hitObservations) do
            if r == pref then table.remove(hitObservations, i); table.insert(hitObservations, 1, pref); break end
        end
        queueHitRender()
    end
    monitor.contactPartName = pref and pref.partName or monitor.overlapPart
end
HitDebug.record = recordHitObservation
HitDebug.flag = flagMotionResponse
HitDebug.render = renderHitInfo
HitDebug.clear = clearHitInfo
end

