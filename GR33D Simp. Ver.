local function refreshPlayers()
    for _, r in pairs(rows) do r:Destroy() end
    table.clear(rows)
    local all = Players:GetPlayers()
    table.sort(all, function(a,b) return a.Name:lower() < b.Name:lower() end)
    local q = Search.Text:lower()
    local shown = 0
    for _, player in ipairs(all) do
        if player ~= Me
           and (player.Name:lower():find(q,1,true)
                or player.DisplayName:lower():find(q,1,true)) then
            shown = shown + 1
            local selected = targetPlayerNames[player.Name] == true
            local rung = rungPlayers[player.Name] == true
            local rowColor = ROW
            if rung then rowColor = Color3.fromRGB(90,60,60)
            elseif selected then rowColor = Color3.fromRGB(58,78,110) end

            local Row = make("TextButton", {Size=UDim2.new(1,-18,0,60),
                LayoutOrder=shown, BackgroundColor3=rowColor,
                BorderSizePixel=0, AutoButtonColor=false, Text=""}, List)
            round(Row, 10)
            Row.MouseEnter:Connect(function()
                if not selected then Row.BackgroundColor3 = ROWHI end
            end)
            Row.MouseLeave:Connect(function()
                if not selected then Row.BackgroundColor3 = ROW end
            end)
            local pic = make("ImageLabel", {Position=UDim2.fromOffset(36,8),
                Size=UDim2.fromOffset(44,44), BackgroundColor3=PANEL, Image=""}, Row)
            round(pic, 22)
            local check = make("Frame", {Position=UDim2.fromOffset(8,17),
                Size=UDim2.fromOffset(24,24), BackgroundColor3=Color3.fromRGB(60,70,95),
                BorderSizePixel=0}, Row)
            round(check, 6)
            make("UIStroke", {Color=Color3.fromRGB(80,92,118), Thickness=1}, check)
            local checkTxt = "✓"
            local checkCol = Color3.fromRGB(60,230,130)
            if rung then checkTxt = "✗"; checkCol = Color3.fromRGB(230,110,110) end
            make("TextLabel", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1,
                Text=checkTxt, TextColor3=checkCol,
                Font=Enum.Font.GothamBold, TextSize=16, Visible=selected}, check)
            local dl = label(player.DisplayName .. (rung and "  [RUNG]" or ""), 14,
                UDim2.fromOffset(88,8), UDim2.new(1,-96,0,22), Row)
            dl.Font = Enum.Font.GothamBold
            if rung then dl.TextColor3 = Color3.fromRGB(230,110,110) end
            local ul = label("@"..player.Name, 11, UDim2.fromOffset(88,32),
                UDim2.new(1,-96,0,18), Row)
            ul.TextColor3 = MUTED
            loadAvatar(player, pic, Enum.ThumbnailSize.Size100x100)
            Row.MouseButton1Click:Connect(function()
                if targetPlayerNames[player.Name] then
                    targetPlayerNames[player.Name] = nil
                    rungPlayers[player.Name] = nil
                else
                    targetPlayerNames[player.Name] = true
                    rungPlayers[player.Name] = nil
                end
                refreshPlayers()
                local n = selectedCount()
                setStatus(n == 0 and "Target: self (no selection)" or ("Selected: "..n),
                    n == 0 and MUTED or Color3.fromRGB(80,180,200))
            end)
            rows[player] = Row
        end
    end
    Count.Text = string.format("%d online · %d shown · %d selected · %d rung",
        #all, shown, selectedCount(), rungCount())
end

