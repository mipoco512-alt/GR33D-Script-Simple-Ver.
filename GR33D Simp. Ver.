local function zeroCharacterMotion(ch)
    if not ch then return end
    for _, part in ipairs(ch:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
                part.Velocity = Vector3.zero
                part.RotVelocity = Vector3.zero
            end)
        end
    end
end
local function captureReturn(ch, root, hum)
    if returnSnapshot and returnSnapshot.character == ch
        and os.clock() - returnSnapshot.time < 180 then return end
    local pivot = ch:GetPivot()
    if lastGrounded and lastGrounded.character == ch
        and os.clock() - lastGrounded.time <= 20 then
        pivot = lastGrounded.pivot
    end
    local seated = true
    pcall(function() seated = hum:GetStateEnabled(Enum.HumanoidStateType.Seated) end)
    returnSnapshot = {character=ch, root=root, humanoid=hum, pivot=pivot,
        rootAnchored=root.Anchored, seatedEnabled=seated, time=os.clock()}
    lastSafeReturn = returnSnapshot
end
local function recoveryCheckpoint()
    local ch = Me.Character
    if not ch then return nil end
    local root = ch:FindFirstChild("HumanoidRootPart")
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not (root and hum and root.Parent and hum.Health > 0) then return nil end
    if returnSnapshot and returnSnapshot.character == ch then return returnSnapshot end
    if lastSafeReturn and lastSafeReturn.character == ch
        and os.clock() - lastSafeReturn.time <= 45 then return lastSafeReturn end
    if lastGrounded and lastGrounded.character == ch
        and os.clock() - lastGrounded.time <= 45 then
        local seated = true
        pcall(function() seated = hum:GetStateEnabled(Enum.HumanoidStateType.Seated) end)
        return {character=ch, root=root, humanoid=hum, pivot=lastGrounded.pivot,
            rootAnchored=false, seatedEnabled=seated, time=lastGrounded.time}
    end
