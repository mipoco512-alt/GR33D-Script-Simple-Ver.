local function notify(titleText, detailText, tint)
    if not Gui.Parent then return end
    local row = make("Frame", {
        Size=UDim2.new(1,0,0,NOTIFY_H),
        BackgroundColor3=BG, BorderSizePixel=0, ZIndex=41
    }, noticeHost)
    round(row, 9)
    make("UIStroke", {Color=tint or ACCENT, Thickness=1.25, Transparency=0.1}, row)
    local stripe = make("Frame", {
        Size=UDim2.fromOffset(3,NOTIFY_H),
        BackgroundColor3=tint or ACCENT, BorderSizePixel=0, ZIndex=42
    }, row)
    round(stripe, 3)
    local ttl = label(titleText, 11, UDim2.fromOffset(11,4), UDim2.new(1,-20,0,17), row)
    ttl.Font = Enum.Font.GothamBold
    ttl.ZIndex = 42
    local txt = label(detailText or "", 9, UDim2.fromOffset(11,24), UDim2.new(1,-20,0,15), row)
    txt.TextColor3 = MUTED
    txt.ZIndex = 42
    notices[#notices+1] = row
    if #notices > 2 then
        local first = table.remove(notices, 1)
        if first and first.Parent then first:Destroy() end
    end
    task.delay(3.5, function()
        if row and row.Parent then row:Destroy() end
        for i=#notices,1,-1 do
            if notices[i] == row then table.remove(notices,i) end
        end
    end)
end

local function recordActivity(eventText, tint)
    activity[#activity+1] = {message = eventText, color = tint or MUTED}
    if #activity > 8 then table.remove(activity,1) end
    if logChanged then logChanged() end
end

