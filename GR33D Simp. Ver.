local function refreshPlayers()
    for _, r in pairs(rows) do r:Destroy() end
    table.clear(rows)
    local all = Players:GetPlayers()
    table.sort(all, function(a,b) return a.Name:lower() < b.Name:lower() end)
    local q = Search.Text:lower()
    local shown = 0
    for _, player in ipairs(all) do
        if player ~= Me
           and (player.Name:lower():find(q,1,true)
                or player.DisplayName:lower():find(q,1,true)) then
            shown = shown + 1
            local selected = (targetPlayerName == player.Name)
            local Row = make("TextButton", {Size=UDim2.new(1,-18,0,56),
                LayoutOrder=shown,
                BackgroundColor3 = selected and Color3.fromRGB(58,78,110) or ROW,
                BorderSizePixel=0, AutoButtonColor=false, Text=""}, List)
            round(Row, 10)
            Row.MouseEnter:Connect(function()
                if targetPlayerName ~= player.Name then Row.BackgroundColor3 = ROWHI end
            end)
            Row.MouseLeave:Connect(function()
                if targetPlayerName ~= player.Name then Row.BackgroundColor3 = ROW end
            end)
            local pic = make("ImageLabel", {Position=UDim2.fromOffset(36,6),
                Size=UDim2.fromOffset(40,40), BackgroundColor3=PANEL, Image=""}, Row)
            round(pic, 20)
            local check = make("Frame", {Position=UDim2.fromOffset(8,15),
                Size=UDim2.fromOffset(22,22), BackgroundColor3=Color3.fromRGB(60,70,95),
                BorderSizePixel=0}, Row)
            round(check, 6)
            make("UIStroke", {Color=Color3.fromRGB(80,92,118), Thickness=1}, check)
            make("TextLabel", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1,
                Text="✓", TextColor3=Color3.fromRGB(60,230,130),
                Font=Enum.Font.GothamBold, TextSize=16, Visible=selected}, check)
            local dl = label(player.DisplayName, 14, UDim2.fromOffset(84,6),
                UDim2.new(1,-92,0,22), Row)
            dl.Font = Enum.Font.GothamBold
            local ul = label("@"..player.Name, 11, UDim2.fromOffset(84,28),
                UDim2.new(1,-92,0,18), Row)
            ul.TextColor3 = MUTED
            loadAvatar(player, pic, Enum.ThumbnailSize.Size100x100)
            Row.MouseButton1Click:Connect(function()
                if targetPlayerName == player.Name then
                    targetPlayerName = ""
                else
                    targetPlayerName = player.Name
                end
                refreshPlayers()
                setStatus(targetPlayerName == "" and "Target: self" or ("Target: "..player.Name),
                    targetPlayerName == "" and MUTED or Color3.fromRGB(80,180,200))
            end)
            rows[player] = Row
        end
    end
    Count.Text = string.format("%d online · %d shown · target: %s",
        #all, shown, targetPlayerName == "" and "self" or targetPlayerName)
end

