}, Gui)
round(MiniCircle, 999)
make("UIStroke", {Color = Color3.fromRGB(255, 235, 150), Thickness = 2, Transparency = 0.35}, MiniCircle)

do
    local mcDragging, mcStart, mcPos, mcMoved = false, nil, nil, false
    MiniCircle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            mcDragging = true; mcMoved = false
            mcStart = input.Position
            mcPos = MiniCircle.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not mcDragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= mcStart then return end
        local delta = input.Position - mcStart
        if delta.Magnitude > 4 then mcMoved = true end
        MiniCircle.Position = UDim2.new(mcPos.X.Scale,
            mcPos.X.Offset + delta.X, mcPos.Y.Scale, mcPos.Y.Offset + delta.Y)
    end)
    UIS.InputEnded:Connect(function(input)
        if input == mcStart then mcDragging = false; mcStart = nil end
    end)
    MiniCircle.MouseButton1Click:Connect(function()
        if mcMoved then return end
        minimized = false
        Main.Visible = true
        MiniCircle.Visible = false
        if updateWindow then updateWindow() end
    end)
end

