local function createRingRow(labelText, minV, maxV, stepV, getFn, setFn)
    local lbl = label(labelText, 11, UDim2.fromOffset(10,0), UDim2.fromOffset(200,16), RingPage)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextColor3 = MUTED
    local dec = make("TextButton", {Text="−", Font=Enum.Font.GothamBold, TextSize=20,
        TextColor3=WHITE, BackgroundColor3=ROW, AutoButtonColor=false}, RingPage)
    round(dec, 8)
    local box = make("TextBox", {Text=tostring(getFn()), ClearTextOnFocus=false,
        TextColor3=WHITE, TextSize=13, Font=Enum.Font.GothamBold,
        BackgroundColor3=PANEL, TextXAlignment=Enum.TextXAlignment.Center}, RingPage)
    round(box, 8)
    local inc = make("TextButton", {Text="+", Font=Enum.Font.GothamBold, TextSize=20,
        TextColor3=WHITE, BackgroundColor3=ROW, AutoButtonColor=false}, RingPage)
    round(inc, 8)
    dec.MouseButton1Click:Connect(function() setFn(math.clamp(getFn()-stepV,minV,maxV)); box.Text = tostring(getFn()) end)
    inc.MouseButton1Click:Connect(function() setFn(math.clamp(getFn()+stepV,minV,maxV)); box.Text = tostring(getFn()) end)
    box.FocusLost:Connect(function(enter)
        if enter then local n = tonumber(box.Text); if n then setFn(math.clamp(n,minV,maxV)) end end
        box.Text = tostring(getFn())
    end)
    table.insert(ringRows, {label=lbl, dec=dec, box=box, inc=inc})
end

