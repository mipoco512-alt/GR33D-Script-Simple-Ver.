    local set = _G.Settings or {}
    local noParts  = set["No Particles"] ~= false
    local noCam    = set["No Camera Effects"] ~= false
    local noExp    = set["No Explosions"] ~= false
    local noShadow = set["No Shadows"] ~= false
    local lowQual  = set["Low Quality Parts"] ~= false

    if noParts then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
               or obj:IsA("Fire") or obj:IsA("Sparkles") then
                obj.Enabled = false
            end
        end
        workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
               or obj:IsA("Fire") or obj:IsA("Sparkles") then
                obj.Enabled = false
            end
        end)
    end
    if noCam then
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") then obj.Enabled = false end
        end
    end
    if noExp then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Explosion") then obj.Visible = false end
        end
        workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("Explosion") then obj.Visible = false end
        end)
    end
    if noShadow then
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then obj.CastShadow = false end
        end
        workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("BasePart") then obj.CastShadow = false end
        end)
    end
    if lowQual then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                pcall(function() obj.Material = Enum.Material.SmoothPlastic end)
            end
        end
    end
end


-- [TOOL 2] ANTI-FLING — supplied script implementation
local antiFlingActive = false
local antiFlingIndicator = nil
local flyRunning = false
local antiFlingConn = nil
local antiFlingSafeCF = nil
local ANTI_FLING_VEL_CAP = 120
local ANTI_FLING_SNAP_RANGE = 40

local function startAntiFling()
    if antiFlingConn then return end
    antiFlingSafeCF = nil
    antiFlingConn = RunService.Heartbeat:Connect(function()
        local ch = Me.Character
        if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        local vel = hrp.AssemblyLinearVelocity
        if vel.Magnitude < 40 and hum.FloorMaterial ~= Enum.Material.Air then
            antiFlingSafeCF = hrp.CFrame
        end

        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") and obj.Velocity.Magnitude > 100 then
                obj:Destroy()
            elseif obj:IsA("BodyAngularVelocity") then
                if obj.AngularVelocity.Magnitude > 50 then obj:Destroy() end
            elseif obj:IsA("BodyThrust") or obj:IsA("BodyForce") then
                obj:Destroy()
            end
        end

        if not flyRunning and vel.Magnitude > ANTI_FLING_VEL_CAP then
            local capped = vel.Unit * ANTI_FLING_VEL_CAP
            hrp.AssemblyLinearVelocity = capped
            hrp.Velocity = capped
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end

        if not flyRunning and antiFlingSafeCF then
            local drift = (hrp.Position - antiFlingSafeCF.Position).Magnitude
            if drift > ANTI_FLING_SNAP_RANGE and vel.Magnitude > ANTI_FLING_VEL_CAP then
                hrp.CFrame = antiFlingSafeCF
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end

        if not flyRunning then pcall(function()
            hum.PlatformStand = false
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.Ragdoll
               or st == Enum.HumanoidStateType.Physics
               or st == Enum.HumanoidStateType.FallingDown
               or st == Enum.HumanoidStateType.PlatformStanding then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end) end
    end)
end

local function stopAntiFling()
    if antiFlingConn then antiFlingConn:Disconnect(); antiFlingConn = nil end
    antiFlingSafeCF = nil
end


local function antiFlingReset()
    antiFlingSafeCF = nil
end
Me.CharacterAdded:Connect(antiFlingReset)

