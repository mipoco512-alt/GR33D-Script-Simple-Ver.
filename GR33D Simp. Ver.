local RING_CONFIG = {
    radius             = 50,
    height             = 100,
    rotationSpeed      = 10,
    attractionStrength = 150,
    keepOut            = 6,
    damageOthers       = true,   -- false = visual only
}
local ringPartsEnabled = false
local ringParts = {}
local ringFF = nil
local RING_CLAIM_INTERVAL = 0.5
local lastRingClaim = 0

pcall(function() LocalPlayer.ReplicationFocus = workspace end)
