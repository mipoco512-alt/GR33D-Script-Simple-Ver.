-- ================================================================
-- HUD CHANGE: mobile-friendly sizing
--   • Fixed-band HUD reservation instead of % of viewport height.
--   • Width capped by height so the panel stays portrait when short.
--   • Portrait vs landscape bands differ.
-- ================================================================
updateWindow = function()
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1024, 768)
    local insetY = 0
    pcall(function()
        local topLeft = game:GetService("GuiService"):GetGuiInset()
        insetY = topLeft.Y
    end)
    local touch = UIS.TouchEnabled
    local isLandscape = vp.X > vp.Y

    -- Reserve space for the Roblox HUD. Portrait reserves more at bottom
    -- (jump / joystick), landscape reserves more at the sides.
    local hudTop, hudBottom
    if touch then
        if isLandscape then
            hudTop    = math.max(insetY + 6, math.floor(vp.Y * 0.08))
            hudBottom = math.max(30,        math.floor(vp.Y * 0.10))
        else
            hudTop    = math.max(insetY + 8, math.floor(vp.Y * 0.10))
            hudBottom = math.max(72,        math.floor(vp.Y * 0.14))
        end
        hudTop    = math.min(hudTop,    110)
        hudBottom = math.min(hudBottom, 170)
    else
        hudTop    = math.max(insetY + 8, 14)
        hudBottom = 10
    end

    if vp.Y - hudTop - hudBottom < 185 then
        -- Extra-short: fall back to minimum reserve.
        hudTop    = math.max(insetY + 4, math.floor(vp.Y * 0.06))
        hudBottom = math.max(22,         math.floor(vp.Y * 0.06))
    end

    local maxWidth  = maximized and 660 or PANEL_W
    local maxHeight = maximized and 920 or PANEL_H
    local usableH   = math.max(150, vp.Y - hudTop - hudBottom)
    local h         = minimized and 44 or math.min(maxHeight, usableH)

    -- Portrait aspect cap: keep the panel taller than wide even when the
    -- viewport is short. This is the key line that prevents wide-and-low.
    local aspectCap     = maximized and 1.15 or 0.85
    local aspectWidth   = math.floor(h * aspectCap)
    local viewportWidth = math.max(250, vp.X - 28)
    local w = math.min(maxWidth, aspectWidth, viewportWidth)
    w = math.max(280, w)

    local compact  = h < 500
    local headerH  = compact and 38 or 64
    local tabsH    = compact and 36 or 44
    local footerH  = compact and 77 or 122
    local navY     = compact and 4 or 8
    local hostY    = navY + tabsH + 8
    local contentH = h - headerH

    Main.Position = UDim2.new(0.5, 0, 0, hudTop)
    Main.Size = UDim2.fromOffset(w, h)
    Scale.Scale = 1

    Header.Size = UDim2.new(1, 0, 0, headerH)
    Title.Position = UDim2.fromOffset(14, compact and 8 or 10)
    Title.TextSize = compact and 13 or 15
    SubTitle.Visible = not compact

    local closeY   = compact and 3 or 12
    local controlH = compact and 30 or 34
    for _, b in ipairs({MinButton, MaxButton, CloseButton}) do
        b.Size = UDim2.fromOffset(controlH, controlH)
    end
    MinButton.Position   = UDim2.new(1, -(controlH * 3 + 28), 0, closeY)
    MaxButton.Position   = UDim2.new(1, -(controlH * 2 + 20), 0, closeY)
    CloseButton.Position = UDim2.new(1, -(controlH + 12), 0, closeY)

    Content.Position = UDim2.fromOffset(0, headerH)
    Content.Size     = UDim2.new(1, 0, 1, -headerH)
    Content.Visible  = not minimized
    if minimized then InspectOverlay.Visible = false end
    MinButton.Text = minimized and "+" or "−"
    MaxButton.Text = maximized and "❐" or "▢"

    Navigation.Position = UDim2.fromOffset(12, navY)
    Navigation.Size     = UDim2.new(1, -24, 0, tabsH)
    PageHost.Position   = UDim2.fromOffset(12, hostY)
    PageHost.Size       = UDim2.new(1, -24, 0,
        math.max(34, contentH - hostY - footerH - 7))
    Footer.Position     = UDim2.new(0, 12, 1, -(footerH + 4))
    Footer.Size         = UDim2.new(1, -24, 0, footerH)
    InspectOverlay.Position = UDim2.fromOffset(10, headerH + 6)
    InspectOverlay.Size     = UDim2.new(1, -20, 1, -(headerH + 16))

    reflowContents(w, h)

    if compact then
        for _, btn in pairs(tabButtons) do btn.TextSize = 11 end
        for _, name in ipairs({"Players", "Actions", "Tools", "Hits"}) do
            local b = tabButtons[name]
            b.Size = UDim2.fromOffset(b.Size.X.Offset, tabsH)
        end
    end
    showTab(currentTab)
end
