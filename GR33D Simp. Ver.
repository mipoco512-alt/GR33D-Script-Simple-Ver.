local function place(obj, x, y, w, h)
    obj.Position = UDim2.fromOffset(x, y)
    obj.Size = UDim2.fromOffset(w, h)
end

local function reflowContents(panelWidth, panelHeight)
    local gap = 10
    local innerWidth = panelWidth - 44
    -- Use actual PageHost height rather than assuming a 760px desktop panel.
    -- On phones the entire tab scrolls, while the footer remains accessible.
    local innerHeight = math.max(1, PageHost.Size.Y.Offset)
    local compact = innerHeight < 350
    ActionPage.CanvasSize = UDim2.fromOffset(0, 310)
    UtilityPage.CanvasSize = UDim2.fromOffset(0, innerWidth < 335 and 365 or 340)
    -- Always use ONE scrolling area for Hits. Nested scroll frames prevent
    -- lower records/buttons receiving touch gestures on phones.
    HitPage.ScrollingEnabled = true
    HitPage.ScrollBarThickness = 6
    HitPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
    HitPage.CanvasSize = UDim2.fromOffset(0, 0)
    local half = math.floor((innerWidth - gap) / 2)
    local third = math.floor((innerWidth - gap * 2) / 3)
    local navWidth = panelWidth - 24
    local tabW = math.floor((navWidth - 3 * gap) / 4)
    for i, name in ipairs({"Players", "Actions", "Tools", "Hits"}) do
        local x = (i - 1) * (tabW + gap)
        local ww = i == 4 and (navWidth - x) or tabW
        place(tabButtons[name], x, 0, ww, 42)
        tabButtons[name].TextSize = 12
    end

    -- Players tab: single, dedicated scrolling list; no nested scroll areas.
    -- Search and selection actions stay visible even with many players online.
    local narrow = innerWidth < 335
    place(sectionFrames[2], 10, 0, innerWidth, 0)
    sectionFrames[2].Visible = false
    place(Search, 8, 7, innerWidth + 4, 32)
    place(Count, 10, 42, innerWidth, 16)
    place(sectionFrames[4], 10, 0, innerWidth, 0)
    sectionFrames[4].Visible = false
    local quickY = 62
    local quickGap = 6
    local quickW = math.floor((innerWidth - 2 * quickGap) / 3)
    place(SelectAll, 8, quickY, quickW, 30)
    place(DeselectAll, 8 + quickW + quickGap, quickY, quickW, 30)
    place(GoActionsButton, 8 + 2 * (quickW + quickGap), quickY,
        innerWidth - 2 * (quickW + quickGap) + 4, 30)
    SelectAll.TextSize = 12
    DeselectAll.TextSize = 12
    local listY = 100
    local listHeight = math.max(42, innerHeight - listY - 6)
    place(List, 8, listY, innerWidth + 4, listHeight)
    List.CanvasSize = UDim2.fromOffset(0, getPlayerListContentHeight())
    List.ScrollingEnabled = true
    List.ScrollBarThickness = 6
    List.ScrollBarImageColor3 = ACCENT
    PlayerPage.ScrollingEnabled = false
    PlayerPage.ScrollBarThickness = 0
    PlayerPage.CanvasSize = UDim2.fromOffset(0, innerHeight)

    -- Tools: retain the old command input and full scan functionality.
    place(UtilityTitle, 10, 10, innerWidth, 20)
    place(sectionFrames[1], 10, 344, innerWidth, 18)
    place(CmdBar, 10, 367, innerWidth, 38)
    place(InspectButton, 10, 414, innerWidth, 36)
    InspectButton.Text = "SCAN SELECTED PLAYER"
    UtilityPage.CanvasSize = UDim2.fromOffset(0, 465)

    -- Target actions: 2 columns, large hit areas, every original button.
    place(sectionFrames[3], 10, 14, innerWidth, 18)
    local targetButtons = {TPButton, BringButton, FreezeButton,
        UnfreezeButton, AnchorButton, UnanchorButton}
    for i, btn in ipairs(targetButtons) do
        place(btn, 10 + ((i-1) % 2) * (half + gap),
            42 + math.floor((i-1) / 2) * 56, half, 46)
        btn.TextSize = 13
    end
    place(ActionsHint, 10, 228, innerWidth, 44)

    -- Movement/tools: self-contained and accessible without page scrolling.
    place(UtilityTitle, 10, 14, innerWidth, 22)
    local utilityButtons = {AimbotButton, FollowButton, NoclipButton,
        SpeedButton, GrabObjectButton, RescueButton}
    for i, btn in ipairs(utilityButtons) do
        place(btn, 10 + ((i-1) % 2) * (half + gap),
            44 + math.floor((i-1) / 2) * 56, half, 46)
        btn.TextSize = 12
    end
    if innerWidth < 335 then
        place(fovLabel, 10, 223, 75, 32)
        place(FovBox, 87, 223, innerWidth - 77, 32)
        place(smoothLabel, 10, 263, 75, 32)
        place(SmoothBox, 87, 263, innerWidth - 77, 32)
        place(ToolsHint, 10, 307, innerWidth, 44)
    else
        place(fovLabel, 10, 232, 65, 34)
        place(FovBox, 76, 232, half - 66, 34)
        place(smoothLabel, 10 + half + gap, 232, 63, 34)
        place(SmoothBox, 74 + half + gap, 232, half - 64, 34)
        place(ToolsHint, 10, 283, innerWidth, 44)
    end

    -- Hits: compact summary remains above the fold on landscape phones;
    -- manual outcome buttons are visible without traversing long logs.
    place(HitHeading, 10, 6, innerWidth, 16)
    place(HitDebug.priority, 10, 25, innerWidth, 18)
    place(HitDebug.summary, 10, 44, innerWidth, 28)
    place(HitDebug.stats, 10, 76, innerWidth, 74)
    HitDebug.stats.TextSize = innerWidth < 355 and 10 or 11
    HitDebug.outcomes.TextSize = innerWidth < 355 and 9 or 10
    place(HitDebug.outcomes, 10, 153, innerWidth, 68)
    place(MarkLaunch, 10, 225, half, 33)
    place(MarkMiss, 10 + half + gap, 225, half, 33)
    place(ClearHits, 10, 264, half, 30)
    place(LimbFocusButton, 10 + half + gap, 264, half, 30)
    place(ResetLearning, 10, 300, innerWidth, 30)
    place(HistoryToggle, 10, 336, innerWidth, 30)
    HitHistory.Visible = false
    HitDebug.log.Parent = HitPage
    HitDebug.details.Visible = HitDebug.showHistory
    HitDebug.log.Visible = HitDebug.showHistory
    HitDebug.runLog.Visible = HitDebug.showHistory
    place(HitDebug.details, 10, 380, innerWidth, 90)
    place(HitDebug.runLog, 10, 475, innerWidth - 18, 0)
    place(HitDebug.log, 10, 505 + HitDebug.runLog.TextBounds.Y,
        innerWidth - 18, 0)
    HitPage.CanvasSize = UDim2.fromOffset(0, HitDebug.showHistory and 550 or 379)
    if HitDebug.relayoutHistory then HitDebug.relayoutHistory() end
    local short = panelHeight < 660
    local targetH = short and 30 or 34
    local statusH = short and 24 or 38
    local btnY = short and 66 or 82
    local btnH = short and 42 or 48
    TargetBar.Size = UDim2.new(1, 0, 0, targetH)
    TargetBarLabel.Size = UDim2.fromOffset(68, targetH)
