RunService.Stepped:Connect(function()
    if OrbitState==0 then return end
    local ch=Me.Character
    local root=ch and ch:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _,v in ipairs(ch:GetChildren()) do if v:IsA("BasePart") then v.CanCollide=false end end

    local targetPart=nil
    if OrbitState==2 and LockedPosition then
        targetPart={Position=LockedPosition}
    else
        local bestSelected,bestSelectedName,bestDist=nil,nil,math.huge
        for name in pairs(targetPlayerNames) do
            if not rungPlayers[name] then
                local p=Players:FindFirstChild(name)
                if p and p.Character and not isProtectedPlayer(p) then
                    local hrp=p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d=(root.Position-hrp.Position).Magnitude
                        if d<bestDist then bestDist=d bestSelected=hrp bestSelectedName=name end
                    end
                end
            end
        end
        if bestSelected then
            targetPart=bestSelected
            lastTargetPos=bestSelected.Position
            if orbitTargetName~=bestSelectedName then
                orbitTargetName=bestSelectedName
                orbitTargetStart=tick()
                orbitBaselineVel=0
                pcall(function() orbitBaselineVel=bestSelected.AssemblyLinearVelocity.Magnitude end)
            else
                local elapsed=tick()-orbitTargetStart
                local velMag=0
                pcall(function() velMag=bestSelected.AssemblyLinearVelocity.Magnitude end)
                local inAir=false local humAlive=true
                pcall(function()
                    local hum=bestSelected.Parent and bestSelected.Parent:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local st=hum:GetState()
                        if st==Enum.HumanoidStateType.Flying or st==Enum.HumanoidStateType.Freefall or st==Enum.HumanoidStateType.Swimming then inAir=true end
                        if hum.FloorMaterial==Enum.Material.Air then inAir=true end
                        if hum.Health<=0 then humAlive=false end
                    end
                end)
                local spike=velMag-orbitBaselineVel
                local genuineFling=spike>=config.flingVelThreshold
                local timedOutGrounded=(not inAir) and (velMag<50) and elapsed>=config.ringSuccessTime
                local dead=not humAlive
                if genuineFling or timedOutGrounded or dead then
                    rungPlayers[bestSelectedName]=true
                    orbitTargetName=nil
                    local reason="Timeout"
                    if genuineFling then reason="Fling detected" elseif dead then reason="Target dead" end
                    task.defer(function()
                        setStatus("Rung: "..bestSelectedName,genuineFling and GREEN or AMBER,reason)
                        refreshPlayers()
                    end)
                end
            end
        elseif lastTargetPos then
            targetPart={Position=lastTargetPos}
        elseif next(targetPlayerNames)==nil then
            local cDist=config.targetRadius local closest=nil
            for _,p in ipairs(Players:GetPlayers()) do
                if p~=Me and p.Character and not isProtectedPlayer(p) then
                    local hrp=p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d=(root.Position-hrp.Position).Magnitude
                        if d<cDist then cDist=d closest=hrp end
                    end
                end
            end
            targetPart=closest or root
        else
            targetPart=lastTargetPos and {Position=lastTargetPos} or root
        end
    end
    if not targetPart then targetPart=root end

    local isEven=(math.floor(tick())%2==0)
    local curRadius=isEven and config.radiusA or config.radiusB
    local curHeight=isEven and config.heightA or config.heightB
    local baseSpeed=config.baseSpeedMultiplier
    local total=math.max(#itemsInRing,1)
    local localHrp=root
    local immunityOn=config.selfImmunity
    local immunitySq=config.immunityRadius*config.immunityRadius

    for i=#itemsInRing,1,-1 do
        local item=itemsInRing[i]
        if item and item.Parent and not item.Anchored then
            local bp=item:FindFirstChild("OrbitBP")
            if not bp then
                bp=Instance.new("BodyPosition",item)
                bp.Name="OrbitBP"
                bp.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                bp.P=1e10 bp.D=500
            end
            item.Velocity=Vector3.zero item.RotVelocity=Vector3.zero
            local iSpeed=baseSpeed+((i%10)*0.5)
            local angle=(tick()*iSpeed)+(i*(math.pi*2/total))
            local tPos=targetPart.Position+Vector3.new(math.cos(angle)*curRadius,curHeight,math.sin(angle)*curRadius)
            if immunityOn and localHrp then
                local off=tPos-localHrp.Position
                local dSq=off.X*off.X+off.Y*off.Y+off.Z*off.Z
                if dSq<immunitySq then
                    if dSq<0.01 then tPos=localHrp.Position+Vector3.new(config.immunityRadius+2,0,0)
                    else tPos=localHrp.Position+off.Unit*(config.immunityRadius+2) end
                end
            end
            bp.Position=tPos
            local wantCol=true
            if localHrp then
                local dL=(item.Position-localHrp.Position).Magnitude
                if dL<20 then wantCol=false end
            end
            if item.CanCollide~=wantCol then item.CanCollide=wantCol end
        else
            if itemsInRingLookup[item] then itemsInRingLookup[item]=nil end
            table.remove(itemsInRing,i)
        end
    end
end)

