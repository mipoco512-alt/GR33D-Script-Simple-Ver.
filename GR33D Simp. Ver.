-- PASSIVE CONTACT DIAGNOSTICS
--====================================
local HitDebug = {}
do
local PhysicsService = game:GetService("PhysicsService")
local hitObservations = {}
local HIT_LOG_LIMIT = 32
HitDebug.focus = "LeftArm"
local LIMB_FAMILIES = {
    LeftUpperArm = "Arms", RightUpperArm = "Arms",
    LeftLowerArm = "Arms", RightLowerArm = "Arms",
    LeftHand = "Arms", RightHand = "Arms",
    LeftUpperLeg = "Legs", RightUpperLeg = "Legs",
    LeftLowerLeg = "Legs", RightLowerLeg = "Legs",
    LeftFoot = "Legs", RightFoot = "Legs",
    ["Left Arm"] = "Arms", ["Right Arm"] = "Arms",
    ["Left Leg"] = "Legs", ["Right Leg"] = "Legs",
}
HitDebug.partFamily = function(part, character)
    if not part or not character or part.Parent ~= character then return nil end
    if not part:IsA("BasePart") then return nil end
    return LIMB_FAMILIES[part.Name]
end
HitDebug.acceptsPart = function(part, character)
    local family = HitDebug.partFamily(part, character)
    return family ~= nil and (HitDebug.focus == "Both" or family == HitDebug.focus
        or (HitDebug.focus == "LeftArm" and family == "Arms"
            and (part.Name == "LeftLowerArm" or part.Name == "LeftUpperArm"
                or part.Name == "LeftHand" or part.Name == "Left Arm")))
end
local function hitVec(v) return string.format("(%.1f, %.1f, %.1f)", v.X, v.Y, v.Z) end
local function hitEvidence(record)
    local e = {}
    if record.touched then table.insert(e, "Touched event") end
    if record.overlap then table.insert(e, "spatial overlap") end
    if record.response then table.insert(e, "HRP motion response") end
    return #e > 0 and table.concat(e, " + ") or "unverified"
end
local function hitStatus(record)
    if not record then return "No observations yet" end
    if record.response then return "Overlap/touch + correlated motion (LOCAL)" end
    if record.touched then return "Touched event (LOCAL, not server-verified)" end
    return "Spatial overlap only (NOT a confirmed hit)"
end
local function renderHitInfo()
    if not HitDebug.summary or not HitDebug.summary.Parent then return end
    local newest = hitObservations[1]
    if not newest then
        HitDebug.summary.Text = "No " .. (HitDebug.focus == "Both" and "arm/leg" or (HitDebug.focus == "LeftArm" and "left-arm" or HitDebug.focus:lower())) .. " contact observed."
        HitDebug.details.Text = "Head and accessories are ignored.\nTracking: LEFT ARM locked; filter controls display only."
        HitDebug.log.Text = "The most recent 32 observations appear here."
        return
    end
    HitDebug.summary.Text = string.format("@%s  •  %s  •  %s", newest.target,
        newest.partName, newest.zone)
    HitDebug.details.Text = string.format(
        "Aimed at: %s\nApprox. point: %s\nEvidence: %s\nCollision eligible: %s  |  Try %s",
        newest.aimedPart or "unknown", hitVec(newest.point), hitStatus(newest),
        newest.collidable and "Yes" or "No/unknown", tostring(newest.attempt))
    local lines = {}
    for i, event in ipairs(hitObservations) do
        lines[#lines + 1] = string.format(
            "%02d  @%s  [try %s]\n       Aim: %s\n       Observed: %s | %s\n       %s  •  %s\n       %s",
            i, event.target, tostring(event.attempt), event.aimedPart or "unknown",
            event.partName, event.zone, hitEvidence(event), hitVec(event.point),
            event.collidable and "Collidable locally" or "Overlap / collision unverified")
    end
    HitDebug.log.Text = table.concat(lines, "\n\n")
end
local hitRenderQueued = false
local function queueHitRender()
    if hitRenderQueued then return end
    hitRenderQueued = true
    task.defer(function()
        hitRenderQueued = false
        renderHitInfo()
    end)
end
local function clearHitInfo()
    table.clear(hitObservations)
    renderHitInfo()
end
local function approximateHitZone(part, myRoot)
    local approx = part.Position
    pcall(function() approx = part:GetClosestPointOnSurface(myRoot.Position) end)
    local localPos = part.CFrame:PointToObjectSpace(approx)
    local sx = math.max(part.Size.X * 0.5, 0.01)
    local sy = math.max(part.Size.Y * 0.5, 0.01)
    local sz = math.max(part.Size.Z * 0.5, 0.01)
    local horizontal = "center"
    local x, z = localPos.X / sx, localPos.Z / sz
    if math.abs(x) > math.abs(z) and math.abs(x) > 0.35 then
        horizontal = x > 0 and "right" or "left"
    elseif math.abs(z) > 0.35 then
        horizontal = z < 0 and "front" or "back"
    end
    local y = localPos.Y / sy
    local vertical = y > 0.35 and "upper" or (y < -0.35 and "lower" or "middle")
    return vertical .. " / " .. horizontal, approx
end
local function arePartsCollisionEligible(myRoot, otherPart)
    if not myRoot.CanCollide or not otherPart.CanCollide then return false end
    local ok, allowed = pcall(function()
        return PhysicsService:CollisionGroupsAreCollidable(myRoot.CollisionGroup, otherPart.CollisionGroup)
    end)
    return ok and allowed == true
end
local function hitPartLabel(part, character)
    local ancestor = part.Parent
    if ancestor and ancestor ~= character and ancestor:IsA("Accessory") then
        return ancestor.Name .. "." .. part.Name
    end
    return part.Name
end
local function recordHitObservation(monitor, part, myRoot, observationKind)
    if not monitor or not myRoot or not HitDebug.acceptsPart(part, monitor.targetCharacter) then
        return nil
    end
    local now = os.clock()
    monitor.hitRecords = monitor.hitRecords or {}
    local record = monitor.hitRecords[part]
    local changed = false
    if not record then
        local zone, point = approximateHitZone(part, myRoot)
        record = {
            target = monitor.targetName or "unknown",
            partName = hitPartLabel(part, monitor.targetCharacter),
            aimedPart = monitor.aimedPartName or "unknown",
            zone = zone, point = point, attempt = monitor.attempt or "?",
            collidable = arePartsCollisionEligible(myRoot, part),
            overlap = false, touched = false, response = false,
            timestamp = now,
        }
        monitor.hitRecords[part] = record
        table.insert(hitObservations, 1, record)
        if #hitObservations > HIT_LOG_LIMIT then table.remove(hitObservations) end
        changed = true
    end
    if observationKind == "Touched" and not record.touched then
        record.touched = true
        monitor.lastTouchedRecord = record
        monitor.lastTouchedAt = now
        changed = true
    elseif observationKind == "Overlap" and not record.overlap then
        record.overlap = true
        changed = true
    end
    record.timestamp = now
    monitor.lastObservedRecord = record
    if record.collidable then monitor.lastEligibleRecord = record end
    monitor.overlapPart = record.partName
    if changed then queueHitRender() end
    return record
end
local function flagMotionResponse(monitor)
    local now = os.clock()
    local preferred = nil
    if monitor.lastTouchedAt and now - monitor.lastTouchedAt <= 0.4 then
        preferred = monitor.lastTouchedRecord
    end
    if not preferred and monitor.lastEligibleRecord
        and now - monitor.lastEligibleRecord.timestamp <= 0.4 then
        preferred = monitor.lastEligibleRecord
    end
    if not preferred and monitor.lastObservedRecord
        and now - monitor.lastObservedRecord.timestamp <= 0.4 then
        preferred = monitor.lastObservedRecord
    end
    if preferred and not preferred.response then
        preferred.response = true
        preferred.timestamp = now
        for index, record in ipairs(hitObservations) do
            if record == preferred then
                table.remove(hitObservations, index)
                table.insert(hitObservations, 1, preferred)
                break
            end
        end
        queueHitRender()
    end
    monitor.contactPartName = preferred and preferred.partName or monitor.overlapPart
end
HitDebug.record = recordHitObservation
HitDebug.flag = flagMotionResponse
HitDebug.render = renderHitInfo
HitDebug.clear = clearHitInfo
end

