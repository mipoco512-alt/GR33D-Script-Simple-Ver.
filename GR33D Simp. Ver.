-- ============================================================
-- ANTI-FLING
-- ============================================================
local antiFlingEnabled = false
local antiFlingConn = nil
local antiFlingSafeCF = nil
local ANTI_FLING_VEL_CAP = 120
local ANTI_FLING_SNAP_RANGE = 40

local function startAntiFling()
    if antiFlingConn then return end
    antiFlingSafeCF = nil
    antiFlingConn = RunService.Heartbeat:Connect(function()
        local ch = Me.Character
        if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        local vel = hrp.AssemblyLinearVelocity
        if vel.Magnitude < 40 and hum.FloorMaterial ~= Enum.Material.Air then
            antiFlingSafeCF = hrp.CFrame
        end

        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") and obj.Velocity.Magnitude > 100 then
                obj:Destroy()
            elseif obj:IsA("BodyAngularVelocity") then
                if obj.AngularVelocity.Magnitude > 50 then obj:Destroy() end
            elseif obj:IsA("BodyThrust") or obj:IsA("BodyForce") then
                obj:Destroy()
            end
        end

        if vel.Magnitude > ANTI_FLING_VEL_CAP then
            local capped = vel.Unit * ANTI_FLING_VEL_CAP
            hrp.AssemblyLinearVelocity = capped
            hrp.Velocity = capped
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end

        if antiFlingSafeCF then
            local drift = (hrp.Position - antiFlingSafeCF.Position).Magnitude
            if drift > ANTI_FLING_SNAP_RANGE and vel.Magnitude > ANTI_FLING_VEL_CAP then
                hrp.CFrame = antiFlingSafeCF
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end

        pcall(function()
            hum.PlatformStand = false
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.Ragdoll
               or st == Enum.HumanoidStateType.Physics
               or st == Enum.HumanoidStateType.FallingDown
               or st == Enum.HumanoidStateType.PlatformStanding then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
    end)
end

local function stopAntiFling()
    if antiFlingConn then antiFlingConn:Disconnect(); antiFlingConn = nil end
    antiFlingSafeCF = nil
end

-- ============================================================
-- MASS FLING
-- ============================================================
local massState = {
    enabled = false, parts = {}, lookup = {},
    scanRadius = 3000, itemsPerScan = 200,
    launchSpeed = 500, scanInterval = 0.5,
    thread = nil,
}

local function massCleanInvalid()
    for i = #massState.parts, 1, -1 do
        local item = massState.parts[i]
        if not item or not item.Parent then
            massState.lookup[item] = nil
            table.remove(massState.parts, i)
        end
    end
end

local function massScannerLoop()
    while massState.enabled do
        local ch = Me.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if hrp then
            local parts = workspace:GetPartBoundsInRadius(hrp.Position, massState.scanRadius)
            local added = 0
            for _, item in ipairs(parts) do
                if added >= massState.itemsPerScan then break end
                if item:IsA("BasePart") and not item.Anchored
                   and not item:IsDescendantOf(ch)
                   and item.Name ~= "Handle"
                   and not (item.Parent and item.Parent:IsA("Accessory"))
                   and not massState.lookup[item] then
                    table.insert(massState.parts, item)
                    massState.lookup[item] = true
                    added = added + 1
                end
            end
            massCleanInvalid()
        end
        task.wait(massState.scanInterval)
    end
    massState.thread = nil
end

local function startMassScanner()
    if massState.thread then return end
    massState.enabled = true
    massState.thread = task.spawn(massScannerLoop)
end
local function stopMassScanner() massState.enabled = false end

local function massGetTargetPos()
    local ch = Me.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    if OrbitState == 2 and LockedPosition then return LockedPosition, "locked pos" end
    local best, bestDist = nil, math.huge
    for name in pairs(targetPlayerNames) do
        local p = Players:FindFirstChild(name)
        if p and p.Character then
            local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local d = (hrp.Position - tHrp.Position).Magnitude
                if d < bestDist then bestDist = d; best = tHrp end
            end
        end
    end
    if best then return best.Position, best.Parent.Name end
    local closest, closestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Me and p.Character then
            local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local d = (hrp.Position - tHrp.Position).Magnitude
                if d < closestDist then closestDist = d; closest = tHrp end
            end
        end
    end
    if closest then return closest.Position, closest.Parent.Name end
    return nil
end

local function massFlingNow()
    local targetPos, targetName = massGetTargetPos()
    if not targetPos then return 0, "no target" end
    local count = 0
    for i = #massState.parts, 1, -1 do
        local item = massState.parts[i]
        if item and item.Parent and not item.Anchored then
            local bp = item:FindFirstChild("OrbitBP")
            if bp then bp:Destroy() end
            pcall(function() item:SetNetworkOwner(Me) end)
            pcall(function()
                item.Massless = false
                item.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5, 1, 1)
                item.CanCollide = true
            end)
            local dir = targetPos - item.Position
            local dist = dir.Magnitude
            if dist > 0.5 then
                dir = dir.Unit
                pcall(function()
                    item.AssemblyLinearVelocity = dir * massState.launchSpeed
                    item.AssemblyAngularVelocity = Vector3.new(
                        math.random(-200, 200), math.random(-200, 200), math.random(-200, 200))
                end)
                count = count + 1
            end
            massState.lookup[item] = nil
            table.remove(massState.parts, i)
        else
            massState.lookup[item] = nil
            table.remove(massState.parts, i)
        end
    end
    return count, targetName or "?"
end

local function massClear()
    for _, item in ipairs(massState.parts) do
        if item and item.Parent then
            local bp = item:FindFirstChild("OrbitBP")
            if bp then bp:Destroy() end
        end
    end
    table.clear(massState.parts)
    table.clear(massState.lookup)
end

