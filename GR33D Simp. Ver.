local function refreshPlayers()
    pcall(function()
        for _,r in pairs(rows) do r:Destroy() end
        table.clear(rows)
        local all=Players:GetPlayers()
        table.sort(all,function(a,b) return a.Name:lower()<b.Name:lower() end)
        local q=Search.Text:lower()
        local shown=0
        for _,player in ipairs(all) do
            if player~=Me and not isProtectedPlayer(player) and (player.Name:lower():find(q,1,true) or player.DisplayName:lower():find(q,1,true)) then
                shown=shown+1
                local selected=targetPlayerNames[player.Name]==true
                local rung=rungPlayers[player.Name]==true
                local rowColor=ROW
                if rung then rowColor=Color3.fromRGB(90,60,60) elseif selected then rowColor=Color3.fromRGB(58,78,110) end
                local Row=make("TextButton",{Size=UDim2.new(1,-16,0,58),LayoutOrder=shown,BackgroundColor3=rowColor,BorderSizePixel=0,AutoButtonColor=false,Text=""},List)
                round(Row,10)
                local pic=make("ImageLabel",{Position=UDim2.fromOffset(38,10),Size=UDim2.fromOffset(38,38),BackgroundColor3=PANEL,Image=""},Row)
                round(pic,19)
                local check=make("Frame",{Position=UDim2.fromOffset(8,18),Size=UDim2.fromOffset(22,22),BackgroundColor3=Color3.fromRGB(60,70,95),BorderSizePixel=0},Row)
                round(check,6)
                local checkTxt="✓" local checkCol=Color3.fromRGB(60,230,130)
                if rung then checkTxt="✗" checkCol=Color3.fromRGB(230,110,110) end
                make("TextLabel",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text=checkTxt,TextColor3=checkCol,Font=Enum.Font.GothamBold,TextSize=15,Visible=selected},check)
                local dl=label(player.DisplayName..(rung and "  [RUNG]" or ""),13,UDim2.fromOffset(84,10),UDim2.new(1,-96,0,20),Row)
                dl.Font=Enum.Font.GothamBold
                if rung then dl.TextColor3=Color3.fromRGB(230,110,110) end
                local ul=label("@"..player.Name,10,UDim2.fromOffset(84,32),UDim2.new(1,-96,0,16),Row)
                ul.TextColor3=MUTED
                loadAvatar(player,pic,Enum.ThumbnailSize.Size100x100)
                Row.MouseButton1Click:Connect(function()
                    if targetPlayerNames[player.Name] then
                        targetPlayerNames[player.Name]=nil
                        rungPlayers[player.Name]=nil
                    else
                        targetPlayerNames[player.Name]=true
                        rungPlayers[player.Name]=nil
                        lastTargetPos=nil orbitTargetName=nil orbitTargetStart=0 orbitBaselineVel=0
                    end
                    refreshPlayers()
                    local n=selectedCount()
                    setStatus(n==0 and "Target: self" or ("Selected: "..n),n==0 and MUTED or Color3.fromRGB(80,180,200))
                end)
                rows[player]=Row
            end
        end
        Count.Text=string.format("%d online · %d shown · %d selected · %d rung",#all,shown,selectedCount(),rungCount())
    end)
end

