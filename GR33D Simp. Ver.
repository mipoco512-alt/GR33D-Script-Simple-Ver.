-- Recalculate the real scrollable height so bottom entries remain tappable.
local playerLayoutUpdatePending = false
PlayerRowLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    if playerLayoutUpdatePending then return end
    playerLayoutUpdatePending = true
    task.defer(function()
        playerLayoutUpdatePending = false
        if not Gui.Parent then return end
        List.CanvasSize = UDim2.fromOffset(0, getPlayerListContentHeight())
        -- The list is the only scroller on Players; never force its parent
        -- to resize while somebody is scrolling or tapping a player.
    end)
end)

updateWindow = function()
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1024, 768)
    local insetY = 0
    pcall(function()
        local topLeft = game:GetService("GuiService"):GetGuiInset()
        insetY = topLeft.Y
    end)
    local touch = UIS.TouchEnabled
    -- Roblox CoreGui plus game-specific bars may cover the screen top.
    -- Reserve additional space above AND below the panel on mobile.
    local hudTop = touch
        and math.max(insetY + 9, math.floor(vp.Y * 0.125))
        or math.max(insetY + 12, 20)
    local hudBottom = touch
        and math.max(28, math.floor(vp.Y * 0.09)) or 14
    if vp.Y - hudTop - hudBottom < 185 then
        -- Last-resort safe margins on extra-short displays.
        hudTop = math.max(insetY + 4, math.floor(vp.Y * 0.11))
        hudBottom = math.max(22, math.floor(vp.Y * 0.10))
    end
    local maxWidth = maximized and 385 or PANEL_W
    local maxHeight = maximized and 980 or PANEL_H
    local w = math.min(maxWidth, math.max(230, vp.X - 24))
    local usableH = math.max(130, vp.Y - hudTop - hudBottom)
    local h = minimized and 44 or math.min(maxHeight, usableH)
    local compact = h < 660
    local headerH = compact and 36 or 50
    local tabsH = compact and 34 or 42
    -- No footer on Players: every saved pixel becomes selectable list space.
    local footerH = currentTab == "Players" and 0
        or (compact and 116 or 140)
    local navY = compact and 2 or 6
    local hostY = currentTab == "Players" and 4 or (navY + tabsH + 8)
    local contentH = h - headerH
    Main.Position = UDim2.new(0.5, 0, 0, hudTop)
    Main.Size = UDim2.fromOffset(w, h)
    -- No global downscaling: mobile text and buttons remain legible.
    Scale.Scale = 1
    Header.Size = UDim2.new(1, 0, 0, headerH)
    Title.Position = UDim2.fromOffset(14, compact and 8 or 10)
    Title.TextSize = compact and 13 or 15
    SubTitle.Visible = not compact
    local closeY = compact and 3 or 12
    local controlH = compact and 30 or 34
    for _, b in ipairs({MinButton, MaxButton, CloseButton}) do
        b.Size = UDim2.fromOffset(controlH, controlH)
    end
    MinButton.Position = UDim2.new(1, -(controlH * 3 + 28), 0, closeY)
    MaxButton.Position = UDim2.new(1, -(controlH * 2 + 20), 0, closeY)
    CloseButton.Position = UDim2.new(1, -(controlH + 12), 0, closeY)
    Content.Position = UDim2.fromOffset(0, headerH)
    Content.Size = UDim2.new(1, 0, 1, -headerH)
    Content.Visible = not minimized
    if minimized then InspectOverlay.Visible = false end
    MinButton.Text = minimized and "+" or "−"
    MaxButton.Text = maximized and "❐" or "▢"
    Navigation.Position = UDim2.fromOffset(12, navY)
    Navigation.Size = UDim2.new(1, -24, 0, tabsH)
    -- Player selection is an expanded view by default, and FLING › restores
    -- the normal tab/navigation layout. No tiny unreadable player list.
    Navigation.Visible = currentTab ~= "Players"
    PageHost.Position = UDim2.fromOffset(12, hostY)
    PageHost.Size = UDim2.new(1, -24, 0,
        math.max(34, contentH - hostY - footerH - (footerH == 0 and 8 or 7)))
    Footer.Position = UDim2.new(0, 12, 1, -(footerH + 4))
    Footer.Size = UDim2.new(1, -24, 0, footerH)
    Footer.Visible = currentTab ~= "Players"
    InspectOverlay.Position = UDim2.fromOffset(10, headerH + 6)
    InspectOverlay.Size = UDim2.new(1, -20, 1, -(headerH + 16))
    PickerPopup.Size = UDim2.fromOffset(math.max(180, math.min(350, w - 26)),
        math.max(110, math.min(430, h - 58)))
    if minimized then closePartPicker() end
    reflowContents(w, h)
    -- Compress tabs only when the phone is short.
    if compact then
        for _, btn in pairs(tabButtons) do btn.TextSize = 11 end
        for i, name in ipairs({"Players", "Actions", "Tools", "Hits"}) do
            local b = tabButtons[name]
            b.Size = UDim2.fromOffset(b.Size.X.Offset, tabsH)
        end
    end
    showTab(currentTab)
end
