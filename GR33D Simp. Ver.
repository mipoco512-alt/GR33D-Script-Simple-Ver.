-- ============================================================
-- GRAB STABILITY MONITOR — PASSIVE ONLY
-- A separate 0.60s thread samples up to 96 already-tracked parts.
-- It prioritizes previously responsive objects for observation, never for
-- physics control or scanner selection.  It does NOT touch SetNetworkOwner,
-- BodyPosition, item velocity/collision, orbit timing or item membership.
-- Stalls can be caused by latency, streaming or physics limitations; they
-- do NOT establish that another client owns or has "stolen" an object.
-- ============================================================
local function readStabilitySample(now)
    if not Gui.Parent or not StabilityFrame.Parent then return end
    if not stabilityMonitorEnabled then return end
    if OrbitState==0 then
        if not stabilityResetDone then resetStabilityMonitor(); stabilityResetDone=true end
        StabilityTitle.Text="GRAB STABILITY  •  RING OFF"
        StabilityTitle.TextColor3=MUTED
        StabilityCounts.Text="Samples: 0  |  Moving: 0  |  Stalled: 0"
        StabilityHint.Text="Passive monitoring starts when Ring is enabled."
        return
    end
    stabilityResetDone=false
    local root=Me.Character and Me.Character:FindFirstChild("HumanoidRootPart")
    if not root then
        StabilityTitle.Text="GRAB STABILITY  •  WAITING"
        StabilityTitle.TextColor3=AMBER
        StabilityHint.Text="Character not ready. No changes to Ring."
        return
    end
    local centerPos=root.Position
    local targetKey="self"
    if OrbitState==2 and LockedPosition then
        centerPos=LockedPosition
        targetKey="locked"
    elseif currentRingTarget and currentRingTarget.Character then
        local centerRoot=currentRingTarget.Character:FindFirstChild("HumanoidRootPart")
        if centerRoot then
            centerPos=centerRoot.Position
            targetKey="player:"..tostring(currentRingTarget.UserId)
        end
    end
    if stabilityLastTargetKey~=targetKey then
        -- Avoid claiming a stalled Ring immediately after target switching.
        resetStabilityMonitor()
        stabilityLastTargetKey=targetKey
    end

    local count=#itemsInRing
    if count==0 then
        StabilityTitle.Text="GRAB STABILITY  •  SEARCHING"
        StabilityTitle.TextColor3=ACCENT
        StabilityCounts.Text="Samples: 0  |  Moving: 0  |  Stalled: 0"
        StabilityHint.Text="No tracked objects available to monitor."
        return
    end

    -- Pass 1: recheck up to 48 historically responsive parts first.
    -- Pass 2: fairly rotate through the remaining tracked parts.
    -- Selection is READ-ONLY; original Ring order remains untouched.
    local selected={}
    local used={}
    local budget=96
    local historyBudget=48
    for i=1,count do
        if #selected>=historyBudget then break end
        local part=itemsInRing[i]
        local observation=part and stabilitySamples[part]
        if observation and observation.everMoving and part.Parent and not part.Anchored then
            selected[#selected+1]=part
            used[part]=true
        end
    end
    local start=math.clamp(stabilityCursor,1,count)
    local inspected=0
    for offset=0,count-1 do
        if #selected>=budget then break end
        local index=((start+offset-1)%count)+1
        local part=itemsInRing[index]
        inspected+=1
        if part and part.Parent and not part.Anchored and not used[part] then
            selected[#selected+1]=part
            used[part]=true
        end
    end
    stabilityCursor=((start+math.max(inspected,1)-1)%count)+1

    local valid=0
    local moving=0
    local historicallyMoving=0
    local stalled=0
    local warming=0
    for _,part in ipairs(selected) do
        local ok,position=pcall(function() return part.Position end)
        if ok and position then
            local record=stabilitySamples[part]
            if not record then
                record={pos=position,center=centerPos,at=now,good=0,bad=0,everMoving=false}
                stabilitySamples[part]=record
                warming+=1
            else
                local elapsed=now-record.at
                if elapsed>=0.25 and elapsed<=12 then
                    local relativeNow=position-centerPos
                    local relativeBefore=record.pos-record.center
                    local diff=(relativeNow-relativeBefore).Magnitude
                    local threshold=math.max(0.18,math.min(1.2,elapsed*0.25))
                    local didMove=diff>threshold
                    valid+=1
                    if didMove then
                        moving+=1
                        record.good=math.min(3,record.good+1)
                        record.bad=0
                        if record.good>=2 then record.everMoving=true end
                    else
                        record.bad=math.min(5,record.bad+1)
                        record.good=0
                    end
                else
                    warming+=1
                end
                record.pos=position
                record.center=centerPos
                record.at=now
            end
            if record.everMoving then
                historicallyMoving+=1
                if record.bad>=3 then stalled+=1 end
            end
        end
    end
    StabilityCounts.Text=string.format("Samples: %d  |  Moving: %d  |  Stalled: %d",valid,moving,stalled)
    local status
    if valid<5 then
        status="CALIBRATING"
        StabilityTitle.TextColor3=ACCENT
        StabilityHint.Text="Collecting movement samples; Ring continues normally."
    elseif stalled>=math.max(3,math.floor(historicallyMoving*0.25)) and historicallyMoving>=5 then
        status="MOVEMENT STALLED"
        StabilityTitle.TextColor3=AMBER
        StabilityHint.Text="Previously responsive parts stopped moving. Ownership unverified."
    elseif moving>=3 then
        status="MOVING LOCALLY"
        StabilityTitle.TextColor3=GREEN
        StabilityHint.Text="Local movement observed; server control is not confirmed."
    else
        status="CONTROL UNCERTAIN"
        StabilityTitle.TextColor3=AMBER
        StabilityHint.Text="Parts tracked but little movement detected locally."
    end
    StabilityTitle.Text="GRAB STABILITY  •  "..status
    -- The monitor NEVER reclaims, discards or boosts any part. One
    -- transition alert per cooldown prevents UI and event-log spam.
    if status=="MOVEMENT STALLED" and stabilityLastStatus~="MOVEMENT STALLED"
        and now-stabilityLastAlertAt>=15 then
        stabilityLastAlertAt=now
        notify("Ring movement stalled",tostring(stalled).." objects unresponsive locally",AMBER)
        recordActivity("Grab monitor: movement stalled (not ownership proof)",AMBER)
    elseif status=="MOVING LOCALLY" and stabilityLastStatus=="MOVEMENT STALLED"
        and now-stabilityLastAlertAt>=15 then
        stabilityLastAlertAt=now
        notify("Movement resumed",tostring(moving).." sampled objects moving",GREEN)
    end
    stabilityLastStatus=status
end

