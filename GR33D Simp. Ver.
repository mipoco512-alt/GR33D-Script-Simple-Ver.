-- ANTI-FLING
-- ============================================================
local antiFlingEnabled = false
local antiFlingConn = nil
local antiFlingSafeCF = nil
local antiFlingLastPos = nil
local antiFlingLastTime = 0
local AFC_GROUND=130 local AFC_AIR=400 local AF_SNAP=30 local AF_TELEPORT=18
local ALLOWED_MOVERS={OrbitBP=true,EpixVel=true,FlyGyro=true,FlyVel=true,MassBP=true}
local function isForeign(obj)
    if ALLOWED_MOVERS[obj.Name] then return false end
    if obj:IsA("BodyPosition") then return false end
    return true
end
local function startAntiFling()
    if antiFlingConn then return end
    antiFlingSafeCF=nil antiFlingLastPos=nil antiFlingLastTime=0
    antiFlingConn=RunService.Heartbeat:Connect(function()
        local ch=Me.Character if not ch then return end
        local hrp=ch:FindFirstChild("HumanoidRootPart")
        local hum=ch:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health<=0 then return end
        local now=tick()
        local vel=hrp.AssemblyLinearVelocity
        if vel.Magnitude<40 and hum.FloorMaterial~=Enum.Material.Air then
            antiFlingSafeCF=hrp.CFrame antiFlingLastPos=hrp.Position antiFlingLastTime=now
        end
        for _,part in ipairs(ch:GetDescendants()) do
            if part:IsA("BasePart") then
                for _,obj in ipairs(part:GetChildren()) do
                    if obj:IsA("BodyVelocity") and isForeign(obj) then
                        if obj.Velocity.Magnitude>80 then obj:Destroy() end
                    elseif obj:IsA("BodyAngularVelocity") and isForeign(obj) then
                        if obj.AngularVelocity.Magnitude>40 then obj:Destroy() end
                    elseif (obj:IsA("BodyThrust") or obj:IsA("BodyForce")) and isForeign(obj) then obj:Destroy() end
                end
            end
        end
        local cap=(hum.FloorMaterial==Enum.Material.Air) and AFC_AIR or AFC_GROUND
        if vel.Magnitude>cap then
            local c=vel.Unit*cap
            hrp.AssemblyLinearVelocity=c hrp.Velocity=c
            hrp.AssemblyAngularVelocity=Vector3.zero hrp.RotVelocity=Vector3.zero
        end
        if antiFlingLastPos and antiFlingLastTime>0 then
            local dt=now-antiFlingLastTime
            local delta=(hrp.Position-antiFlingLastPos).Magnitude
            if dt<0.1 and delta>AF_TELEPORT and antiFlingSafeCF then
                hrp.CFrame=antiFlingSafeCF
                hrp.AssemblyLinearVelocity=Vector3.zero hrp.AssemblyAngularVelocity=Vector3.zero
            end
        end
        antiFlingLastPos=hrp.Position antiFlingLastTime=now
        if antiFlingSafeCF then
            local drift=(hrp.Position-antiFlingSafeCF.Position).Magnitude
            if drift>AF_SNAP and vel.Magnitude>cap then
                hrp.CFrame=antiFlingSafeCF
                hrp.AssemblyLinearVelocity=Vector3.zero hrp.AssemblyAngularVelocity=Vector3.zero
            end
        end
        pcall(function()
            hum.PlatformStand=false
            local st=hum:GetState()
            if st==Enum.HumanoidStateType.Ragdoll or st==Enum.HumanoidStateType.Physics or st==Enum.HumanoidStateType.FallingDown or st==Enum.HumanoidStateType.PlatformStanding then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
    end)
end
local function stopAntiFling()
    if antiFlingConn then antiFlingConn:Disconnect() antiFlingConn=nil end
    antiFlingSafeCF=nil
end

-- ============================================================
-- MASS RING — direct-to-ring (no pool)
-- ============================================================
local massLoopConn = nil

local function massGetTargets()
    local ch = Me.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    local out = {}
    if next(targetPlayerNames) ~= nil then
        for name in pairs(targetPlayerNames) do
            local p = Players:FindFirstChild(name)
            if p and p ~= Me and not isProtectedPlayer(p) and p.Character then
                local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                if tHrp and tHum and tHum.Health > 0 then
                    table.insert(out, {name=name, hrp=tHrp, player=p})
                end
            end
        end
    else
        local closest, cDist, cName, cHrp, cPlayer = nil, math.huge, nil, nil, nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= Me and not isProtectedPlayer(p) and p.Character then
                local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                if tHrp and tHum and tHum.Health > 0 then
                    local d = (hrp.Position - tHrp.Position).Magnitude
                    if d < cDist then cDist=d; cName=p.Name; cHrp=tHrp; cPlayer=p end
                end
            end
        end
        if cPlayer then table.insert(out, {name=cName, hrp=cHrp, player=cPlayer}) end
    end
    return out
end

local function massSyncRings()
    local targets = massGetTargets()
    if #targets == 0 then return end
    for _, t in ipairs(targets) do
        if not massState.rings[t.name] then
            massState.rings[t.name] = {
                parts = {}, hrp = t.hrp, player = t.player,
                phase = "head", startTime = tick(),
                peakVel = 0, baselineVel = 0, hit = false,
            }
            pcall(function() massState.rings[t.name].baselineVel = t.hrp.AssemblyLinearVelocity.Magnitude end)
        else
            local ring = massState.rings[t.name]
            if not ring.hrp or not ring.hrp.Parent then
                ring.hrp = t.hrp
                ring.player = t.player
            end
        end
    end
    for name, ring in pairs(massState.rings) do
        local still = false
        for _, t in ipairs(targets) do
            if t.name == name then still = true; break end
        end
        if not still then
            for _, item in ipairs(ring.parts) do
                if item and item.Parent then
                    local bp = item:FindFirstChild("MassBP")
                    if bp then bp:Destroy() end
                    local orig = item:GetAttribute("GR33D_OrigTrans")
                    item.Transparency = (orig ~= nil) and orig or 0
                    massState.lookup[item] = nil
                end
            end
            massState.rings[name] = nil
        end
    end
end

local function massTotalRingParts()
    local n = 0
    for _, r in pairs(massState.rings) do n = n + #r.parts end
    return n
end

local function massScannerLoop()
    while massState.enabled do
        local ch = Me.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function() sethiddenproperty(Me, "SimulationRadius", config.simRadius) end)
            pcall(function() Me.ReplicationFocus = workspace end)

            massSyncRings()

            local targets = massGetTargets()
            if #targets > 0 then
                local totalRingParts = massTotalRingParts()
                if totalRingParts < massState.maxRingParts then
                    local remaining = massState.maxRingParts - totalRingParts
                    local thisScan = math.min(massState.itemsPerScan, remaining)

                    local parts = workspace:GetPartBoundsInRadius(hrp.Position, massState.scanRadius)
                    local added = 0
                    for _, item in ipairs(parts) do
                        if added >= thisScan then break end
                        -- [ORIGINAL FILTER] — exactly like Super Ring Old
                        if item:IsA("BasePart") and not item.Anchored and not item:IsDescendantOf(ch) then
                            if not massState.lookup[item] then
                                local target = targets[(added % #targets) + 1]
                                local ring = massState.rings[target.name]
                                if ring then
                                    pcall(function() item:SetNetworkOwner(Me) end)
                                    massState.lookup[item] = true
                                    item:SetAttribute("GR33D_OrigTrans", item.Transparency)
                                    item.Transparency = 0
                                    item.CanCollide = false

                                    if not item:FindFirstChild("MassBP") then
                                        local bp = Instance.new("BodyPosition", item)
                                        bp.Name = "MassBP"
                                        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                        bp.P = 1e10
                                        bp.D = 500
                                    end
                                    table.insert(ring.parts, item)
                                    added = added + 1
                                end
                            end
                        end
                    end
                end
            end
        end

        local packedRatio = math.clamp(massTotalRingParts() / massState.maxRingParts, 0, 1)
        task.wait(massState.scanInterval + packedRatio * 0.6)
    end
    massState.thread = nil
end
local function startMassScanner()
    if massState.thread then return end
    massState.enabled = true
    massState.thread = task.spawn(massScannerLoop)
end
local function stopMassScanner() massState.enabled = false end

local function startMassLoop()
    if massLoopConn then return end
    massLoopConn = RunService.Heartbeat:Connect(function()
        local localCh = Me.Character
        local localHrp = localCh and localCh:FindFirstChild("HumanoidRootPart")
        local now = tick()

        for name, ring in pairs(massState.rings) do
            local hrp = ring.hrp
            if (not hrp or not hrp.Parent) and ring.player and ring.player.Character then
                local nh = ring.player.Character:FindFirstChild("HumanoidRootPart")
                if nh then ring.hrp = nh; hrp = nh end
            end
            if hrp and hrp.Parent then
                local targetPos = hrp.Position
                local isEven = (math.floor(now) % 2 == 0)
                local currentRadius, currentHeight
                if ring.phase == "head" then
                    currentRadius = isEven and massState.headRadiusA or massState.headRadiusB
                    currentHeight = isEven and massState.headHeightA or massState.headHeightB
                else
                    currentRadius = massState.bodyRadius
                    currentHeight = massState.bodyHeight
                end

                -- [PERF] Per-frame work budget: max 150 parts per frame
                local total = #ring.parts
                if total > 0 then
                    local budget = math.min(total, 150)
                    ring.frameOffset = (ring.frameOffset or 0) + budget
                    if ring.frameOffset > total then ring.frameOffset = 1 end
                    local startIdx = ring.frameOffset
                    for k = 0, budget - 1 do
                        local i = ((startIdx + k - 1) % total) + 1
                        local item = ring.parts[i]
                        if item and item.Parent and not item.Anchored then
                            local bp = item:FindFirstChild("MassBP")
                            if not bp then
                                bp = Instance.new("BodyPosition", item)
                                bp.Name = "MassBP"
                                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bp.P = 1e10
                                bp.D = 500
                            end
                            if i % 5 == 0 then
                                pcall(function()
                                    if item:GetNetworkOwner() ~= Me then
                                        item:SetNetworkOwner(Me)
                                    end
                                end)
                            end
                            local itemSpeed = massState.ringSpeed + ((i % 10) * 0.5)
                            local angle = (now * itemSpeed) + (i * (math.pi * 2 / math.max(total, 1)))
                            local tPos = targetPos + Vector3.new(
                                math.cos(angle) * currentRadius,
                                currentHeight,
                                math.sin(angle) * currentRadius
                            )
                            bp.Position = tPos

                            local wantCol = (ring.phase == "body")
                            if wantCol and localHrp then
                                local dL = (item.Position - localHrp.Position).Magnitude
                                if dL < 20 then wantCol = false end
                            end
                            if item.CanCollide ~= wantCol then item.CanCollide = wantCol end
                        end
                    end
                end

                if ring.phase == "body" and not ring.hit then
                    local vel = 0
                    pcall(function() vel = hrp.AssemblyLinearVelocity.Magnitude end)
                    if vel > ring.peakVel then ring.peakVel = vel end
                    local spike = vel - ring.baselineVel
                    if spike >= 200 or vel >= 350 then
                        ring.hit = true
                        task.defer(function()
                            setStatus("HIT "..name, GREEN, string.format("peak %.0f", ring.peakVel))
                        end)
                    end
                end
            end
        end
    end)
end

local function triggerFling()
    if next(massState.rings) == nil then return 0 end
    local count = 0
    for name, ring in pairs(massState.rings) do
        ring.phase = "body"
        ring.startTime = tick()
        ring.peakVel = 0
        ring.hit = false
        pcall(function() ring.baselineVel = ring.hrp.AssemblyLinearVelocity.Magnitude end)
        for _, item in ipairs(ring.parts) do
            if item and item.Parent then item.CanCollide = true end
        end
        count = count + 1
    end
    massState.active = true
    task.defer(function() pcall(refreshPlayers) end)
    return count
end

local function massClear()
    massState.active = false
    for name, ring in pairs(massState.rings) do
        for _, item in ipairs(ring.parts) do
            if item and item.Parent then
                local bp = item:FindFirstChild("MassBP")
                if bp then bp:Destroy() end
                local orig = item:GetAttribute("GR33D_OrigTrans")
                item.Transparency = (orig ~= nil) and orig or 0
                item.CanCollide = false
                massState.lookup[item] = nil
            end
        end
    end
    massState.rings = {}
    massState.lookup = {}
    massState.lastReport = ""
    task.defer(function() pcall(refreshPlayers) end)
end

