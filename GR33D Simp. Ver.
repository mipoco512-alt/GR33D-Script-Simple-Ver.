-- Original's target: closest selected, not yet completed; fallback nearest
-- player within Target Radius or self. Orbit State 2 freezes orbit CENTER,
-- scanner still follows your current 3D position.
RunService.Stepped:Connect(function(_,dt)
    if not Gui.Parent or OrbitState==0 then return end
    local char=Me.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for _,part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            if characterCollisionOriginal[part]==nil then characterCollisionOriginal[part]=part.CanCollide end
            part.CanCollide=false
        end
    end

    local targetPart=root
    local targetName=nil
    if OrbitState==2 and LockedPosition then
        targetPart={Position=LockedPosition}
        currentRingTarget=nil
    else
        local bestSelected,bestName,bestDist=nil,nil,math.huge
        for name in pairs(targetPlayerNames) do
            if not completedTargets[name] then
                local p=Players:FindFirstChild(name)
                local tr=p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if tr then
                    local distance=(root.Position-tr.Position).Magnitude
                    if distance<bestDist then
                        bestDist=distance
                        bestSelected=tr
                        bestName=name
                    end
                end
            end
        end
        if bestSelected then
            targetPart=bestSelected
            targetName=bestName
            currentRingTarget=Players:FindFirstChild(bestName)
            if orbitTargetName~=bestName then
                orbitTargetName=bestName
                orbitTargetStarted=0
                resetOrbitMeasurement()
                notify("Ring target", "@"..bestName, ACCENT)
                task.defer(refreshPlayers)
            else
                -- Preserve the existing 15-second user preference. An elapsed
                -- orbit window is NOT proof of a fling: mark attempted only.
                if ringMovingParts>0 then
                    orbitTargetStarted+=math.min(dt or 1/60,0.1)
                end
                if orbitTargetStarted>=config.ringHoldSeconds then
                    completedTargets[bestName]={time=os.clock(),reason="Attempt elapsed; not a confirmed fling"}
                    notify("Ring attempt ended", "@"..bestName.." (unverified)", AMBER)
                    recordActivity("Ring tried @"..bestName.."; not confirmed", AMBER)
                    orbitTargetName=nil
                    orbitTargetStarted=0
                    currentRingTarget=nil
                    resetOrbitMeasurement()
                    task.defer(refreshPlayers)
                end
            end
        else
            currentRingTarget=nil
            orbitTargetName=nil
            orbitTargetStarted=0
            if selectedCount()==0 then
                local nearestDist=config.targetRadius
                local nearest=nil
                for _,p in ipairs(Players:GetPlayers()) do
                    if p~=Me and p.Character then
                        local tr=p.Character:FindFirstChild("HumanoidRootPart")
                        if tr then
                            local distance=(root.Position-tr.Position).Magnitude
                            if distance<nearestDist then nearestDist=distance;nearest=tr end
                        end
                    end
                end
                targetPart=nearest or root
            end
        end
    end
    if os.clock()-targetInfoUpdatedAt>0.35 then
        targetInfoUpdatedAt=os.clock()
        if targetName then
            TargetInfo.Text=string.format("Ring target: @%s (%.1f/%ds observed)",targetName,
                orbitTargetStarted,config.ringHoldSeconds)
        else
            TargetInfo.Text= selectedCount()>0 and "Ring target: waiting / attempts ended" or "Ring target: nearest / self"
        end
    end

    local isEven=math.floor(tick())%2==0
    local radius=isEven and config.radiusA or config.radiusB
    local height=isEven and config.heightA or config.heightB
    local count=math.max(#itemsInRing,1)
    local center=targetPart.Position
    local moving=0
    local orbiting=0
    local controllers=0
    local now=os.clock()
    for i=#itemsInRing,1,-1 do
        local item=itemsInRing[i]
        if item and item.Parent and not item.Anchored then
            local ok,err=pcall(function()
                local bp=item:FindFirstChild("OrbitBP")
                if not bp then
                    bp=Instance.new("BodyPosition",item)
                    bp.Name="OrbitBP"
                    bp.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                    bp.P=1e10
                    bp.D=500
                end
                controllers+=1
                local prior=ringObservedPositions[item]
                if prior and (item.Position-prior).Magnitude>0.035 then moving+=1 end
                ringObservedPositions[item]=item.Position
                local v=item.Position-center
                local prev=orbitSamples[item]
                if prev and prev.centerName==targetName then
                    local xz=v.X*prev.z-prev.x*v.Z
                    local dot=v.X*prev.x+v.Z*prev.z
                    local turn=math.abs(math.atan2(xz,dot))
                    local radial=math.sqrt(v.X*v.X+v.Z*v.Z)
                    if turn>0.004 and radial<math.max(40,radius*3) and (item.Position-prev.pos).Magnitude>0.045 then
                        orbiting+=1
                    end
                end
                orbitSamples[item]={x=v.X,z=v.Z,pos=item.Position,centerName=targetName}
                -- ORIGINAL supplied script's physical drive verbatim:
                item.CanCollide=false
                item.Velocity=Vector3.zero
                item.RotVelocity=Vector3.zero
                local itemSpeed=config.baseSpeedMultiplier+((i%10)*0.5)
                local angle=tick()*itemSpeed+(i*(math.pi*2/count))
                local nextPos=center+Vector3.new(math.cos(angle)*radius,height,math.sin(angle)*radius)
                if config.selfImmunity then
                    local offset=nextPos-root.Position
                    local distSq=offset.X*offset.X+offset.Y*offset.Y+offset.Z*offset.Z
                    local immunitySq=config.immunityRadius*config.immunityRadius
                    if distSq<immunitySq then
                        if distSq<0.01 then
                            nextPos=root.Position+Vector3.new(config.immunityRadius+2,0,0)
                        else
                            nextPos=root.Position+offset.Unit*(config.immunityRadius+2)
                        end
                    end
                end
                bp.Position=nextPos
            end)
            if not ok then
                controllerErrorCount+=1
                lastControllerError=tostring(err):sub(1,90)
            end
        else
            if item then releaseTrackedPart(item,0) end
            table.remove(itemsInRing,i)
        end
    end
    ringControllers=controllers
    ringDisplacingParts=moving
    ringMovingParts=orbiting
end)

