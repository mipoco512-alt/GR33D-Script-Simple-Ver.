--====================================
local function zeroCharacterMotion(ch)
    if not ch then return end
    for _, part in ipairs(ch:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
                part.Velocity    = Vector3.zero
                part.RotVelocity = Vector3.zero
            end)
        end
    end
end

local function captureReturn(ch, root, hum)
    if returnSnapshot and returnSnapshot.character == ch
        and os.clock() - returnSnapshot.time < 180 then
        return
    end
    local pivot = ch:GetPivot()
    if lastGrounded and lastGrounded.character == ch
        and os.clock() - lastGrounded.time <= 20 then
        pivot = lastGrounded.pivot
    end
    local seated = true
    pcall(function() seated = hum:GetStateEnabled(Enum.HumanoidStateType.Seated) end)
    returnSnapshot = {
        character = ch, root = root, humanoid = hum,
        pivot = pivot, rootAnchored = root.Anchored,
        seatedEnabled = seated, time = os.clock(),
    }
    lastSafeReturn = returnSnapshot
end

local function recoveryCheckpoint()
    local ch = Me.Character
    if not ch then return nil end
    local root = ch:FindFirstChild("HumanoidRootPart")
        or (ch:FindFirstChildOfClass("Humanoid")
            and ch:FindFirstChildOfClass("Humanoid").RootPart)
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not (root and hum and root.Parent and hum.Health > 0) then return nil end
    if returnSnapshot and returnSnapshot.character == ch then return returnSnapshot end
    if lastSafeReturn and lastSafeReturn.character == ch
        and os.clock() - lastSafeReturn.time <= 45 then return lastSafeReturn end
    if lastGrounded and lastGrounded.character == ch
        and os.clock() - lastGrounded.time <= 45 then
        local seated = true
        pcall(function() seated = hum:GetStateEnabled(Enum.HumanoidStateType.Seated) end)
        return { character = ch, root = root, humanoid = hum,
            pivot = lastGrounded.pivot, rootAnchored = false,
            seatedEnabled = seated, time = lastGrounded.time }
    end
    return nil
end

local function clearOurBodyForce(root)
    if root and root.Parent then
        local f = root:FindFirstChild("PlayerOrbitTemporaryForce")
        if f and f:IsA("BodyVelocity") then f:Destroy() end
    end
end

local function isBadLandingHit(result)
    if not result or result.Normal.Y < CONFIG.LandingMaxSlope then return true end
    if result.Material == Enum.Material.Water or result.Material == Enum.Material.CrackedLava then
        return true
    end
    local part = result.Instance
    if not part then return true end
    local ancestryName = part.Name:lower()
    local ancestor = part.Parent
    for _ = 1, 2 do
        if not ancestor then break end
        ancestryName = ancestryName .. " " .. ancestor.Name:lower()
        ancestor = ancestor.Parent
    end
    for _, word in ipairs({"lava", "kill", "damage", "hazard", "acid", "void", "nuke"}) do
        if ancestryName:find(word, 1, true) then return true end
    end
    if part:GetAttribute("Hazard") == true or part:GetAttribute("Kill") == true
        or CollectionService:HasTag(part, "Hazard")
        or CollectionService:HasTag(part, "KillBrick") then
        return true
    end
    return false
end

local LANDING_OFFSETS = {
    Vector3.new(0, 0, 0),
    Vector3.new(3, 0, 0), Vector3.new(-3, 0, 0),
    Vector3.new(0, 0, 3), Vector3.new(0, 0, -3),
    Vector3.new(6, 0, 0), Vector3.new(-6, 0, 0),
    Vector3.new(0, 0, 6), Vector3.new(0, 0, -6),
    Vector3.new(6, 0, 6), Vector3.new(-6, 0, 6),
    Vector3.new(6, 0, -6), Vector3.new(-6, 0, -6),
    Vector3.new(9, 0, 0), Vector3.new(-9, 0, 0),
}

local function findSafeLanding(saved)
    local ch, root, hum = saved.character, saved.root, saved.humanoid
    local base = saved.pivot.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {ch}
    rayParams.IgnoreWater = true
    rayParams.RespectCanCollide = true

    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = {ch}
    overlap.RespectCanCollide = true
    overlap.MaxParts = 64

    local look = saved.pivot.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0, 0, -1) end
    flatLook = flatLook.Unit

    local clearance = math.max(3.5, hum.HipHeight + root.Size.Y * 0.5 + CONFIG.LandingClearance)
    for _, offset in ipairs(LANDING_OFFSETS) do
        if offset.Magnitude <= CONFIG.LandingRadius then
            local spot = base + offset
            local result = workspace:Raycast(
                spot + Vector3.new(0, 9, 0), Vector3.new(0, -85, 0), rayParams)
            if result and not isBadLandingHit(result)
                and result.Position.Y <= base.Y + 2.5
                and result.Position.Y >= base.Y - 23 then
                local p = Vector3.new(spot.X, result.Position.Y + clearance, spot.Z)
                local size = Vector3.new(3.2, 4, 3.2)
                local obstructions = workspace:GetPartBoundsInBox(
                    CFrame.new(p + Vector3.new(0, 0.4, 0)), size, overlap)
                local blocked = false
                for _, part in ipairs(obstructions) do
                    if part:IsA("BasePart") and part.CanCollide then
                        blocked = true
                        break
                    end
                end
                if not blocked then
                    return CFrame.lookAt(p, p + flatLook)
                end
            end
        end
    end
    return nil
end

local function restoreNoclipForLanding(ch)
    if not noclipActive then return end
    noclipActive = false
    for p, original in pairs(noclipOriginalCollision) do
        if p and p.Parent and p:IsDescendantOf(ch) then
            pcall(function() p.CanCollide = original end)
        end
    end
    table.clear(noclipOriginalCollision)
    NoclipButton.Text = "Noclip: OFF"
    NoclipButton.BackgroundColor3 = ROW
end

local function safeReturn(quick)
    if returning or selfFlinging then return false end
    local saved = recoveryCheckpoint()
    if not saved then return false end
    local ch, root, hum = saved.character, saved.root, saved.humanoid
    if Me.Character ~= ch or not ch.Parent or not root.Parent
        or not hum.Parent or hum.Health <= 0 then return false end

    local landing = findSafeLanding(saved)
    if not landing then
        warn("[SafeReturn] No verified clear landing near checkpoint; refusing blind teleport")
        return false
    end

    returning = true
    local success = false
    local originalAnchor = saved.rootAnchored
    local ok, err = xpcall(function()
        restoreNoclipForLanding(ch)
        clearOurBodyForce(root)
        root.Anchored = true
        zeroCharacterMotion(ch)
        hum.Sit = false
        hum.PlatformStand = false
        ch:PivotTo(landing)

        local holdFrames = quick and 2 or 4
        local settleFrames = quick and 4 or CONFIG.LandingSettleFrames
        for _ = 1, holdFrames do
            if Me.Character ~= ch or not ch.Parent or hum.Health <= 0 then return end
            zeroCharacterMotion(ch)
            RunService.Heartbeat:Wait()
        end
        root.Anchored = originalAnchor
        if not originalAnchor then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end

        local stableFrames = 0
        for _ = 1, settleFrames do
            if Me.Character ~= ch or not root.Parent or hum.Health <= 0 then break end
            local drift = (root.Position - landing.Position).Magnitude
            local vy = root.AssemblyLinearVelocity.Y
            if drift <= 6 and vy > -22 then
                stableFrames = stableFrames + 1
            else
                root.Anchored = true
                zeroCharacterMotion(ch)
                ch:PivotTo(landing)
                RunService.Heartbeat:Wait()
                root.Anchored = originalAnchor
                stableFrames = 0
            end
            RunService.Heartbeat:Wait()
        end
        success = stableFrames >= math.ceil(settleFrames / 2)
            and hum.Health > 0
    end, function(e) return tostring(e) end)

    if not ok then warn("[SafeReturn] Recovery error: " .. tostring(err)) end
    pcall(function()
        if root and root.Parent then
            root.Anchored = originalAnchor
            clearOurBodyForce(root)
        end
        if hum and hum.Parent then
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, saved.seatedEnabled)
            hum.PlatformStand = false
            if hum.Health > 0 and not originalAnchor then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
        local cam = workspace.CurrentCamera
        if cam and Me.Character == ch and hum.Parent then cam.CameraSubject = hum end
    end)
    returning = false
    return success
end

table.insert(connections, RunService.Heartbeat:Connect(function()
    if FlingActive or selfFlinging or returning then return end
    local ch = Me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local root = ch and (ch:FindFirstChild("HumanoidRootPart")
        or (hum and hum.RootPart))
    if not (hum and root) or hum.Health <= 0 then return end
    if hum.FloorMaterial == Enum.Material.Air or hum.Sit then return end
    if root.AssemblyLinearVelocity.Magnitude > 30 or root.Anchored then return end
    lastGrounded = {character = ch, pivot = ch:GetPivot(), time = os.clock()}
end))

