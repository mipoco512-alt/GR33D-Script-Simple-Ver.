    UIS.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then mcDragging=false end
    end)
    MiniCircle.MouseButton1Click:Connect(function()
        if mcMoved then return end
