local fpsActive = false
local function applyFPSBoost()
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then obj.Enabled=false
        elseif obj:IsA("Explosion") then obj.Visible=false
        elseif obj:IsA("BasePart") then pcall(function() obj.CastShadow=false end) end
    end
    for _,obj in ipairs(Lighting:GetChildren()) do if obj:IsA("PostEffect") then obj.Enabled=false end end
    Lighting.GlobalShadows=false
end

