function FlingFunctions.isAimHeld() return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
function FlingFunctions.findNearestInFOV()
    local cam = workspace.CurrentCamera
    if not cam then return nil, nil end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X*0.5, vp.Y*0.5)
    local best, bd = nil, CONFIG.AimFOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Me then
            local tc = p.Character
            if tc and tc.Parent then
                local hum = tc:FindFirstChildOfClass("Humanoid")
                local hrp = hum and hum.RootPart
                if hrp and hum.Health > 0 then
                    local sp, on = cam:WorldToViewportPoint(hrp.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < bd then bd = d; best = hrp end
                    end
                end
            end
        end
    end
    return best, bd
end
function FlingFunctions.aimTick()
    if not aimActive or not FlingFunctions.isAimHeld() then currentCameraAimTarget = nil return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local target = FlingFunctions.findNearestInFOV()
    currentCameraAimTarget = target
    if not target then return end
    local desired = CFrame.new(cam.CFrame.Position, target.Position)
    if CONFIG.AimSmooth <= 1 then cam.CFrame = desired
    else cam.CFrame = cam.CFrame:Lerp(desired, 1 / CONFIG.AimSmooth) end
end
