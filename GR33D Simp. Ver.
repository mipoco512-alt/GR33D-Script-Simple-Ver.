        BackgroundColor3 = color or Color3.fromRGB(44, 95, 143)}, S.ui.scroll)
    H.corner(button, 7)
    H.connect(button.Activated, function()
        local ok, message = pcall(callback)
        if not ok then H.report(label, message) end
