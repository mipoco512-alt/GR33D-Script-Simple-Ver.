local function loadAvatar(player, image, size)
    image:SetAttribute("AvatarUserId", player.UserId)
    image.Image = ""
    task.spawn(function()
        local ok, url = pcall(function()
            return Players:GetUserThumbnailAsync(
                player.UserId, Enum.ThumbnailType.HeadShot, size)
        end)
        if ok and image.Parent
           and image:GetAttribute("AvatarUserId") == player.UserId then
            image.Image = url
        end
    end)
end

--====================================
-- DAMAGE GUARD
--====================================
local function isGuardActive()
    return true
end

local function startDamageGuard()
    local ch = Me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not ch or not hum then return end

    pcall(function()
        if guardFF and guardFF.Parent then guardFF:Destroy() end
        guardFF = Instance.new("ForceField")
        guardFF.Name = "FlingDamageGuard_FF"
        guardFF.Visible = false
        guardFF.Parent = ch
    end)

    if not guardVelConn then
        guardVelConn = RunService.Stepped:Connect(function()
            local c2 = Me.Character
            local root = c2 and c2:FindFirstChild("HumanoidRootPart")
            local h2 = c2 and c2:FindFirstChildOfClass("Humanoid")
            if not root or not h2 or h2.Health <= 0 then
                if guardAnchoredSelf and root and root.Parent then
                    pcall(function() root.Anchored = false end)
                    guardAnchoredSelf = false
                end
                return
            end

            -- Let the active movement/return routine own the character.
            -- This avoids scanning all players and rewriting Humanoid state
            -- during an intensive local physics sequence.
            if selfFlinging or returning then
                if guardAnchoredSelf then
                    pcall(function() root.Anchored = false end)
                    guardAnchoredSelf = false
                end
                return
            end

            local myPos = root.Position
            local underTouchAttack = false

            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= Me and p.Character then
                    local theirRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    if theirRoot and theirRoot.Parent then
                        local dist = (theirRoot.Position - myPos).Magnitude
                        local vel  = theirRoot.AssemblyLinearVelocity.Magnitude
                        if dist < CONFIG.ThreatDist and vel > CONFIG.ThreatVel then
                            underTouchAttack = true
                            break
                        end
                    end
                end
            end

            local weAreBusy = FlingActive or selfFlinging or returning
            if underTouchAttack and not weAreBusy then
                if not root.Anchored then
                    pcall(function() root.Anchored = true end)
                    guardAnchoredSelf = true
                end
            else
                if guardAnchoredSelf and root.Parent then
                    pcall(function() root.Anchored = false end)
                    guardAnchoredSelf = false
                end
            end

            if returning or selfFlinging then return end
            pcall(function()
                local v = root.AssemblyLinearVelocity
                if v.Magnitude > CONFIG.GuardVelCap then
                    local capped = v.Unit * CONFIG.GuardVelCap
                    root.AssemblyLinearVelocity  = capped
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.Velocity    = capped
                    root.RotVelocity = Vector3.zero
                end
            end)

            pcall(function()
                h2.PlatformStand = false
                local st = h2:GetState()
                if st == Enum.HumanoidStateType.Ragdoll
                   or st == Enum.HumanoidStateType.Physics
                   or st == Enum.HumanoidStateType.FallingDown
                   or st == Enum.HumanoidStateType.PlatformStanding then
                    h2:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end)
    end

    if guardHealthConn then
        pcall(function() guardHealthConn:Disconnect() end)
        guardHealthConn = nil
    end
    guardHealthConn = hum.HealthChanged:Connect(function(newH)
        if not isGuardActive() then return end
        local c2 = Me.Character
        local h2 = c2 and c2:FindFirstChildOfClass("Humanoid")
        if h2 and h2.Parent and newH < h2.MaxHealth then
            pcall(function()
                h2.Health = h2.MaxHealth
                if h2.Health <= 0 then
                    h2.Health = h2.MaxHealth
                    h2:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)
        end
    end)
end

local function stopDamageGuard()
    if guardVelConn then guardVelConn:Disconnect(); guardVelConn = nil end
    if guardHealthConn then guardHealthConn:Disconnect(); guardHealthConn = nil end
    pcall(function()
        if guardFF and guardFF.Parent then guardFF:Destroy() end
        guardFF = nil
    end)
    if guardAnchoredSelf then
        local ch = Me.Character
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        if root and root.Parent then
            pcall(function() root.Anchored = false end)
        end
        guardAnchoredSelf = false
    end
end

