-- FLING CORE
local function isTargetReady(player)
    if not player or not player.Parent then return false end
    local ch = player.Character
    if not ch or not ch.Parent then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if not hum.RootPart or not hum.RootPart.Parent then return false end
    if hum.Health <= 0 or hum.Sit then return false end
    return true
end

local function findAnyTargetPart(tChar, tHum)
    if currentTargetPartId == "original" then
        local tRoot = tHum and tHum.RootPart
        if tRoot then return tRoot, tRoot.Name end
        local tHead = tChar:FindFirstChild("Head")
        if tHead then return tHead, tHead.Name end
        local acc = tChar:FindFirstChildOfClass("Accessory")
        local handle = acc and acc:FindFirstChild("Handle")
        if handle then return handle, handle.Name end
        return nil, nil
    end
    local p = tChar:FindFirstChild(currentTargetPartId)
    if p and p:IsA("BasePart") then return p, p.Name end
    if tHum and tHum.RootPart then return tHum.RootPart, tHum.RootPart.Name end
    return nil, nil
end

local function hardTeleportToTarget(player)
    local ch = Me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local myRoot = hum and hum.RootPart
    local _, _, tRoot = getTargetHRP(player)
    if not (ch and myRoot and tRoot) then return false end
    local aimWorld = getAimWorldPosition(player.Character, tRoot) or tRoot.Position
    local target = aimWorld + tRoot.CFrame.LookVector * 2.5 + Vector3.new(0,2,0)
    pcall(function()
        ch:PivotTo(CFrame.new(target, aimWorld))
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
    end)
    return true
end

local function preFreezeTarget(player)
    if freezeActive[player.Name] then return end
    freezeActive[player.Name] = true
    freezeThreads[player.Name] = task.spawn(function()
        while freezeActive[player.Name] do
            local _, tHum = getTargetHRP(player)
            if not tHum or not tHum.Parent then freezeActive[player.Name] = false; break end
            pcall(function()
                if tHum.WalkSpeed ~= 0 then tHum.WalkSpeed = 0 end
                if tHum.JumpPower ~= 0 then tHum.JumpPower = 0 end
                if tHum.JumpHeight ~= 0 then tHum.JumpHeight = 0 end
            end)
            task.wait()
        end
    end)
end
local function postUnfreezeTarget(player)
    freezeActive[player.Name] = false
    freezeThreads[player.Name] = nil
    task.wait(0.05)
    local _, tHum = getTargetHRP(player)
    if not tHum then return end
    pcall(function()
        tHum.WalkSpeed=16; tHum.JumpPower=50; tHum.JumpHeight=7.2; tHum.UseJumpPower=true
    end)
end
local function makeTargetOverlapParams(character)
    local p = OverlapParams.new()
    p.FilterType = Enum.RaycastFilterType.Include
    p.FilterDescendantsInstances = {character}
    p.MaxParts = 40
    p.RespectCanCollide = false
    return p
end
local function sampleContact(myRoot, targetCharacter, targetRoot, params, monitor)
    if not monitor or not myRoot.Parent or not targetRoot.Parent then return end
    local now = os.clock()
    if not monitor.lastOverlapQuery
        or now - monitor.lastOverlapQuery >= CONFIG.OverlapCheckInterval then
        monitor.lastOverlapQuery = now
        local ok, hits = pcall(function() return workspace:GetPartsInPart(myRoot, params) end)
        if ok then
            for _, part in ipairs(hits) do
                if HitDebug.acceptsPart(part, targetCharacter) then
                    monitor.overlap = true
                    monitor.lastOverlapAt = now
                    monitor.overlapSamples = (monitor.overlapSamples or 0) + 1
                    pcall(HitDebug.record, monitor, part, myRoot, "Overlap")
                end
            end
        end
    end
    local velocity = targetRoot.AssemblyLinearVelocity
    local magnitude = velocity.Magnitude
    if magnitude > (monitor.peak or 0) then monitor.peak = magnitude end
    local baseline = monitor.startVelocity or Vector3.zero
    local responseDelta = (velocity - baseline).Magnitude
    monitor.responseDelta = math.max(monitor.responseDelta or 0, responseDelta)
    if monitor.lastOverlapAt and now - monitor.lastOverlapAt <= 0.40
        and magnitude >= HRP_BURST.SuccessPeakVel
        and responseDelta >= CONFIG.MinimumResponseDelta then
        if not monitor.hit then
            monitor.hit = true
            pcall(HitDebug.flag, monitor)
        end
    end
end

-- SKID FLING
local function SkidFling(TargetPlayer, forcedPart, monitor)
    local Character = Me.Character
    local Humanoid  = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart  = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer.Character
    if not TCharacter then return false end
    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
    if not (Character and Humanoid and RootPart) then
        setStatus("Character not ready", AMBER); return false
    end
    captureReturn(Character, RootPart, Humanoid)
    if THumanoid and THumanoid.Sit then
        setStatus(TargetPlayer.Name .. " is sitting", AMBER)
        returnSnapshot = nil; return false
    end
    if not TCharacter:FindFirstChildWhichIsA("BasePart") then
        returnSnapshot = nil; return false
    end

    local aimPart = forcedPart
    if not (aimPart and aimPart:IsA("BasePart") and aimPart.Parent and not aimPart.Anchored) then
        local candidate = findAnyTargetPart(TCharacter, THumanoid)
        aimPart = candidate
    end
    if not aimPart then
        setStatus(TargetPlayer.Name .. " no tracking part", AMBER)
        returnSnapshot = nil; return false
    end
    if monitor then monitor.aimedPartName = aimPart.Name end

    local savedFPDH = workspace.FallenPartsDestroyHeight
    local savedRootCollide = RootPart.CanCollide
    local savedRootMassless = RootPart.Massless
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)

    local overlapParams = makeTargetOverlapParams(TCharacter)
    local touchConnection
    if RootPart.CanTouch then
        pcall(function()
            touchConnection = RootPart.Touched:Connect(function(part)
                if monitor and HitDebug.acceptsPart(part, TCharacter) then
                    monitor.overlap = true
                    monitor.lastOverlapAt = os.clock()
                    monitor.touchedPartName = hitPartLabel(part, TCharacter)
                    pcall(HitDebug.record, monitor, part, RootPart, "Touched")
                end
            end)
        end)
    end

    local swingOverlapParams = OverlapParams.new()
    swingOverlapParams.FilterType = Enum.RaycastFilterType.Include
    swingOverlapParams.FilterDescendantsInstances = {TCharacter}
    swingOverlapParams.MaxParts = 12
    swingOverlapParams.RespectCanCollide = false

    local function FPos(BP, Pos, Ang)
        if not RootPart.Parent or not BP.Parent then return end
        pcall(function()
            RootPart.CanCollide = true
            RootPart.Massless = false
        end)
        local aimWorld = getAimWorldPosition(TCharacter, BP) or BP.Position
        local baseCF = CFrame.new(aimWorld)
        RootPart.CFrame = baseCF * Pos * Ang
        pcall(function() Character:SetPrimaryPartCFrame(baseCF * Pos * Ang) end)

        local overlapping = false
        local ok, hits = pcall(function()
            return workspace:GetPartsInPart(RootPart, swingOverlapParams)
        end)
        if ok then
            for _, p in ipairs(hits) do
                if p == BP or p:IsDescendantOf(TCharacter) then
                    overlapping = true
                    break
                end
            end
        end

        if overlapping then
            RootPart.Velocity    = Vector3.new(9e7, 9e7 * 10, 9e7)
            RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        else
            RootPart.Velocity    = Vector3.zero
            RootPart.RotVelocity = Vector3.zero
        end
    end

    local SFBasePart = function(BP)
        local TimeToWait = CONFIG.TimeToWait
        local Time = tick()
        local Angle = 0
        repeat
            if not FlingActive or not RootPart.Parent or not BP.Parent
                or not THumanoid or THumanoid.Health <= 0 then break end
            if BP.Velocity.Magnitude < 50 then
                Angle = Angle + CONFIG.AngleStep
                FPos(BP, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BP.Velocity.Magnitude / 1.25,
                    CFrame.Angles(math.rad(Angle), 0, 0))
                sampleContact(RootPart, TCharacter, BP, overlapParams, monitor)
                if monitor and monitor.hit then return true end
                task.wait()
                FPos(BP, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BP.Velocity.Magnitude / 1.25,
                    CFrame.Angles(math.rad(Angle), 0, 0))
                sampleContact(RootPart, TCharacter, BP, overlapParams, monitor)
                if monitor and monitor.hit then return true end
                task.wait()
                FPos(BP, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BP.Velocity.Magnitude / 1.25,
                    CFrame.Angles(math.rad(Angle), 0, 0))
                task.wait()
                FPos(BP, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BP.Velocity.Magnitude / 1.25,
                    CFrame.Angles(math.rad(Angle), 0, 0))
                task.wait()
                FPos(BP, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection,
                    CFrame.Angles(math.rad(Angle), 0, 0))
                task.wait()
                FPos(BP, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection,
                    CFrame.Angles(math.rad(Angle), 0, 0))
                task.wait()
            else
                FPos(BP, CFrame.new(0, 1.5, THumanoid.WalkSpeed),
                    CFrame.Angles(math.rad(90), 0, 0))
                sampleContact(RootPart, TCharacter, BP, overlapParams, monitor)
                if monitor and monitor.hit then return true end
                task.wait()
                FPos(BP, CFrame.new(0, -1.5, -THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                task.wait()
                FPos(BP, CFrame.new(0, 1.5, THumanoid.WalkSpeed),
                    CFrame.Angles(math.rad(90), 0, 0))
                task.wait()
                FPos(BP, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                task.wait()
                FPos(BP, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                task.wait()
                FPos(BP, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                task.wait()
                FPos(BP, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                task.wait()
            end
        until Time + TimeToWait < tick() or not FlingActive
        return false
    end

    selfFlinging = true
    local BV
    local confirmed, attackOK = false, false
    local oldSeated = returnSnapshot and returnSnapshot.seatedEnabled
    hardTeleportToTarget(TargetPlayer)

    local ran, result = xpcall(function()
        BV = Instance.new("BodyVelocity")
        BV.Name = "PlayerOrbitTemporaryForce"
        BV.Velocity = Vector3.zero
        BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BV.Parent = RootPart
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        return SFBasePart(aimPart)
    end, function(err) return tostring(err) end)

    if ran then attackOK, confirmed = true, result == true
    else
        warn("[Fling v23.4O] Movement failed:", result)
        setStatus("Movement error", RED, tostring(result):sub(1, 110))
    end
    if touchConnection then touchConnection:Disconnect() end
    if BV then pcall(function() BV:Destroy() end) end
    pcall(function()
        RootPart.CanCollide = savedRootCollide
        RootPart.Massless = savedRootMassless
    end)
    zeroCharacterMotion(Character)
    pcall(function()
        if Humanoid.Parent then
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated,
                oldSeated ~= nil and oldSeated or true)
        end
    end)
    selfFlinging = false
    safeReturn(true)
    pcall(function() workspace.FallenPartsDestroyHeight = savedFPDH end)
    return attackOK, confirmed
end

local function burstFlingTarget(player)
    if not isTargetReady(player) then return false, 0, 0, nil end
    local tc = player.Character
    if not tc then return false, 0, 0, nil end
    if CONFIG.AutoFreezeTarget then preFreezeTarget(player) end
    local bestPeak, attempts = 0, 0
    local anyOverlap, bestResponseDelta = false, 0
    local lastPartName = nil
    local tHum = tc:FindFirstChildOfClass("Humanoid")
    for i = 1, HRP_BURST.MaxAttempts do
        if not FlingActive then break end
        if not isTargetReady(player) then break end

        -- Airborne-chase break: only skip if target is *unambiguously* flying.
        --   • Never skip on the first attempt.
        --   • Never skip based on distance.
        --   • Require off-floor AND very high velocity (>500 studs/s).
        if attempts > 0 then
            local _, tHumNow, tRootNow = getTargetHRP(player)
            if tHumNow and tRootNow and tRootNow.Parent then
                local v = tRootNow.AssemblyLinearVelocity.Magnitude
                local offFloor = tHumNow.FloorMaterial == Enum.Material.Air
                if offFloor and v > 500 then
                    setStatus(player.Name .. " already flung — stop chase", CYAN,
                        string.format("airborne · vel %.0f", v))
                    break
                end
            end
        end

        local candidate, candidateName = findAnyTargetPart(tc, tHum)
        if not candidate then
            setStatus("Target part unavailable", AMBER)
            break
        end
        local _, _, tRoot = getTargetHRP(player)
        if CONFIG.AutoFreezeTarget and tRoot then
            local wasA = tRoot.Anchored
            pcall(function() tRoot.Anchored = true end)
            task.wait(CONFIG.AnchorHold)
            pcall(function() tRoot.Anchored = wasA end)
        end
        hardTeleportToTarget(player)
        if not FlingActive then break end
        attempts = attempts + 1
        local tRV = tRoot and tRoot.AssemblyLinearVelocity or Vector3.zero
        local monitor = {peak=0, hit=false, overlap=false,
            targetName=player.Name, targetCharacter=tc, attempt=attempts,
            aimedPartName=candidateName, overlapSamples=0,
            startVelocity=tRV, responseDelta=0}
        SkidFling(player, candidate, monitor)
        if monitor.contactPartName or monitor.overlapPart then
            lastPartName = monitor.contactPartName or monitor.overlapPart
        end
        if monitor.peak > bestPeak then bestPeak = monitor.peak end
        anyOverlap = anyOverlap or monitor.overlap
        bestResponseDelta = math.max(bestResponseDelta, monitor.responseDelta)
        if monitor.hit then
            local ch = Me.Character
            local myRoot = ch and ch:FindFirstChild("HumanoidRootPart")
            local holdA = myRoot and myRoot.Anchored or false
            if myRoot then
                pcall(function()
                    myRoot.Anchored = true
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                end)
            end
            setStatus(string.format("@%s contact (%s)", player.Name,
                tostring(monitor.contactPartName or monitor.overlapPart or "?")), GREEN)
            local hs = tick()
            while tick() - hs < CONFIG.HoldAfterHit do
                if not FlingActive then break end
                if myRoot and myRoot.Parent then
                    pcall(function()
                        myRoot.AssemblyLinearVelocity = Vector3.zero
                        myRoot.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
                task.wait(0.05)
            end
            if myRoot and myRoot.Parent then
                pcall(function() myRoot.Anchored = holdA end)
            end
            if CONFIG.AutoFreezeTarget then postUnfreezeTarget(player) end
            return true, bestPeak, attempts, lastPartName, anyOverlap, bestResponseDelta
        end
        if CONFIG.AutoFreezeTarget then preFreezeTarget(player) end
        task.wait(HRP_BURST.DelayBetween)
    end
    if CONFIG.AutoFreezeTarget then postUnfreezeTarget(player) end
    return false, bestPeak, attempts, lastPartName, anyOverlap, bestResponseDelta
end

local function activeTargets()
    local list = {}
    for _, p in pairs(SelectedTargets) do
        if p and p.Parent == Players then table.insert(list, p)
        else SelectedTargets[p.Name] = nil end
    end
    return list
end
local function startFlingInternal(todo)
    FlingActive = true
    task.spawn(function()
        local ch = Me.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local root = hum and hum.RootPart
        if ch and root and hum then captureReturn(ch, root, hum) end
        for i, player in ipairs(todo) do
            if not FlingActive then break end
            currentTarget = player
            setStatus(string.format("Flinging @%s (%d/%d) · %s",
                player.Name, i, #todo, getCurrentTargetLabel()), WHITE,
                string.format("Predict +%.0f ms", PREDICTION_TIME * 1000))
            stopFollowThread()

            -- Skip only if the target is unambiguously mid-fling.
            -- Never skip based on distance — that would block legitimate
            -- long-range flings, which is the whole point of the exploit.
            local skip = false
            do
                local _, tHumPre, tRootPre = getTargetHRP(player)
                if tHumPre and tRootPre and tRootPre.Parent then
                    local v = tRootPre.AssemblyLinearVelocity.Magnitude
                    local offFloor = tHumPre.FloorMaterial == Enum.Material.Air
                    if offFloor and v > 500 then
                        setStatus(string.format("@%s already flung (%.0f)", player.Name, v),
                            CYAN, "Skipping — already airborne")
                        skip = true
                    end
                end
            end

            if skip then
                task.wait(CONFIG.Cooldown)
                safeReturn()
            else
                local ok, peak, tries, pn = burstFlingTarget(player)
                if ok then
                    setStatus(string.format("@%s contact (%s)", player.Name, tostring(pn or "?")),
                        GREEN, string.format("Peak %.0f | %d tries", peak, tries))
                else
                    setStatus(string.format("@%s no contact", player.Name), AMBER,
                        string.format("Best %.0f | %d tries", peak, tries))
                end
                task.wait(CONFIG.Cooldown)
                safeReturn()
            end
        end
        FlingActive = false
        currentTarget = nil
        if safeReturn() then
            returnSnapshot = nil
            setStatus("Done — safely landed", GREEN)
        else
            setStatus("Completed — landing unverified", AMBER)
        end
    end)
end
startFling = function()
    if FlingActive then return end
    local todo = activeTargets()
    if #todo == 0 then setStatus("No targets selected", AMBER); return end
    startFlingInternal(todo)
end
local function stopFling()
    FlingActive = false
    stopFollowThread()
    if not selfFlinging then safeReturn() end
    setStatus("Stopped", MUTED)
end

